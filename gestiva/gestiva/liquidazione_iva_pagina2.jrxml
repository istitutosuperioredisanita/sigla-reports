		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2006/02/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="dataFine" forPrompting="false" class="java.util.Date">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2006/02/28")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 2 PAGINA,LIQUIDAZIONE_IVA.*,UO.DS_UNITA_ORGANIZZATIVA DS_UNITA_ORGANIZZATIVA
FROM LIQUIDAZIONE_IVA, UNITA_ORGANIZZATIVA UO
WHERE LIQUIDAZIONE_IVA.ESERCIZIO = $P{esercizio}
  AND LIQUIDAZIONE_IVA.CD_CDS = $P{cd_cds} 
  AND LIQUIDAZIONE_IVA.CD_UNITA_ORGANIZZATIVA = $P{cd_unita_organizzativa} 
  AND LIQUIDAZIONE_IVA.TIPO_LIQUIDAZIONE = $P{ti_liquidazione}
  AND LIQUIDAZIONE_IVA.REPORT_ID = $P{idReport}
  AND LIQUIDAZIONE_IVA.DT_INIZIO = $P{dataInizio}
  AND LIQUIDAZIONE_IVA.DT_FINE = $P{dataFine}
  AND UO.CD_UNITA_ORGANIZZATIVA =  LIQUIDAZIONE_IVA.CD_UNITA_ORGANIZZATIVA]]></query>
