<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="liquid_iva_annuale" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR8" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNR10B" fontName="Times New Roman" fontSize="10" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16B" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR8B" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR10" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNR12" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNR12B" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.Long" forPrompting="false">
		<defaultValueExpression><![CDATA[new Long(999999)]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT * FROM VP_LIQUID_IVA_ANNUALE
WHERE ID=$P{id}
order by tipo
	]]></query>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="CHIAVE" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="SEQUENZA" class="java.math.BigDecimal"/>
	<field name="ESERCIZIO" class="java.math.BigDecimal"/>
	<field name="DS_MESE" class="java.lang.String"/>
	<field name="CD_VOCE_IVA" class="java.lang.String"/>
	<field name="DS_VOCE_IVA" class="java.lang.String"/>
	<field name="IMPONIBILE" class="java.math.BigDecimal"/>
	<field name="IM_IVA" class="java.math.BigDecimal"/>
	<field name="IM_TOTALE" class="java.math.BigDecimal"/>
	<group name="DET1">
		<expression><![CDATA[$F{SEQUENZA}]]></expression>
		<groupHeader>
			<band height="20" splitType="Stretch">
				<printWhenExpression><![CDATA[new Boolean($F{TIPO}.compareTo("A")==0)]]></printWhenExpression>
				<element kind="textField" textAdjust="StretchHeight" key="textField-12" style="TNR10" stretchType="ContainerHeight" x="212" y="3" width="85" height="14" pattern=" #,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{IM_IVA}]]></expression>
				</element>
				<element kind="staticText" key="staticText-10" style="TNR12B" x="6" y="3" width="204" height="14" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<text><![CDATA[ Iva Debito / Credito anno precedente]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<group name="DET2">
		<expression><![CDATA[$F{SEQUENZA}]]></expression>
		<groupHeader>
			<band height="20" splitType="Stretch">
				<printWhenExpression><![CDATA[new Boolean($F{TIPO}.compareTo("B")==0)]]></printWhenExpression>
				<element kind="textField" textAdjust="StretchHeight" key="textField-17" style="TNR10" stretchType="ContainerHeight" x="32" y="2" width="179" height="14" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{DS_MESE}]]></expression>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-18" style="TNR10" stretchType="ContainerHeight" x="212" y="3" width="85" height="14" pattern=" #,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{IM_IVA}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<group name="DET3">
		<expression><![CDATA[$F{SEQUENZA}]]></expression>
		<groupHeader>
			<band height="28" splitType="Stretch">
				<printWhenExpression><![CDATA[new Boolean($F{TIPO}.compareTo("C")==0)]]></printWhenExpression>
				<element kind="staticText" key="staticText-11" style="TNR12B" x="138" y="3" width="72" height="14" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<text><![CDATA[ TOTALE ]]></text>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-19" style="TNR12B" stretchType="ContainerHeight" x="212" y="3" width="85" height="14" pattern=" #,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{IM_IVA}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader height="78" splitType="Stretch">
		<element kind="image" key="image-1" x="2" y="3" width="497" height="40">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[$P{DIR_IMAGE}+"CNR.JPG"]]></expression>
		</element>
		<element kind="textField" textAdjust="StretchHeight" key="textField-4" style="TNR16B" x="0" y="47" width="535" height="31" blankWhenNull="false" hTextAlign="Center">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA["LIQUIDAZIONE IVA ANNO "+$F{ESERCIZIO}]]></expression>
		</element>
	</pageHeader>
	<columnHeader splitType="Stretch"/>
	<detail>
		<band splitType="Stretch"/>
	</detail>
	<columnFooter splitType="Stretch"/>
	<pageFooter height="20" splitType="Stretch">
		<element kind="textField" key="textField-1" style="TNR10" x="2" y="2" width="103" height="17" evaluationTime="Report" pattern="dd/MM/yyyy" blankWhenNull="false" hTextAlign="Left">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[new java.util.Date()]]></expression>
		</element>
		<element kind="textField" key="textField-2" style="TNR10" x="436" y="2" width="73" height="17" blankWhenNull="false" hTextAlign="Right">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA["Pagina " + $V{PAGE_NUMBER} + " di "]]></expression>
		</element>
		<element kind="textField" key="textField-3" style="TNR10" x="509" y="2" width="25" height="17" evaluationTime="Report" blankWhenNull="false" hTextAlign="Left">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[" " + $V{PAGE_NUMBER} + ""]]></expression>
		</element>
	</pageFooter>
	<summary splitType="Stretch"/>
</jasperReport>
