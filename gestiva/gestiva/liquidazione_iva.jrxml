	</parameter>
	<parameter name="ti_liquidazione" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["C"]]></defaultValueExpression>
	</parameter>
	<parameter name="dataInizio" class="java.util.Date">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2025/09/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="dataFine" class="java.util.Date">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2025/09/30")]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["E:/iss/SIGLA_FORK_REPORT_ISS/sigla-reports/gestiva/gestiva/"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT uo.CD_UNITA_ORGANIZZATIVA, uo.DS_UNITA_ORGANIZZATIVA, a.PARTITA_IVA as PARTITA_IVA_ENTE, a.RAGIONE_SOCIALE as RAGIONE_SOCIALE_ENTE
FROM UNITA_ORGANIZZATIVA uo,
configurazione_cnr c ,
ANAGRAFICO a
WHERE uo.CD_UNITA_ORGANIZZATIVA =  $P{cd_unita_organizzativa} 
and c.cd_chiave_secondaria(+)='CODICE_ANAG_ENTE'
and c.cd_chiave_primaria(+)='COSTANTI'
AND a.CD_ANAG(+) = c.im01
	]]></query>
	<field name="CD_UNITA_ORGANIZZATIVA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CD_UNITA_ORGANIZZATIVA"/>
	</field>
	<field name="DS_UNITA_ORGANIZZATIVA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="DS_UNITA_ORGANIZZATIVA"/>
	</field>
	<field name="PARTITA_IVA_ENTE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="PARTITA_IVA_ENTE"/>
	</field>
	<field name="RAGIONE_SOCIALE_ENTE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RAGIONE_SOCIALE_ENTE"/>
	</field>
	<background splitType="Stretch"/>
	<title height="97" splitType="Stretch">
		<property name="com.jaspersoft.studio.unit.height" value="px"/>
		<element kind="textField" key="textField" style="TNR12" x="2" y="47" width="532" height="18" uuid="56b36e47-9024-40bd-b2d5-8d85cd0e04b1" blankWhenNull="false" hTextAlign="Center" fontSize="12">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[($P{ti_liquidazione}.equals("S") ? "LIQUIDAZIONE PERIODICA ISTITUZIONALE SAN MARINO SENZA IVA" :
 $P{ti_liquidazione}.equals("X")? "LIQUIDAZIONE PERIODICA ISTITUZIONALE SERVIZI NON RESIDENTI" :
 $P{ti_liquidazione}.equals("I")? "LIQUIDAZIONE PERIODICA ISTITUZIONALE INTRA UE" :
 $P{ti_liquidazione}.equals("P")? "LIQUIDAZIONE PERIODICA ISTITUZIONALE SPLIT PAYMENT" :
 "LIQUIDAZIONE PERIODICA COMMERCIALE")]]></expression>
		</element>
		<element kind="textField" key="textField" style="TNR12BOLD" x="20" y="77" width="126" height="18" uuid="cffce965-2a4c-4397-846f-8ba5d4c29149" textAdjust="StretchHeight" pattern="" blankWhenNull="false" markup="styled" pdfFontName="Times-Bold">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[(new SimpleDateFormat("MM").format($P{dataInizio}).equals(
 new SimpleDateFormat("MM").format($P{dataFine})) ?
	"Periodo: " + new SimpleDateFormat("MMMMM").format($P{dataInizio}) :
	(
	new Integer((new Integer((new SimpleDateFormat("MM").format($P{dataInizio}))).intValue() -
             new Integer((new SimpleDateFormat("MM").format($P{dataFine}))).intValue())).equals(new Integer(2))?
             (
	     new Integer(new SimpleDateFormat("MM").format($P{dataInizio})).equals(new Integer(1)) ?
                     "Iï¿½ Trimestre" :
	     new Integer(new SimpleDateFormat("MM").format($P{dataInizio})).equals(new Integer(4)) ?
                     "IIï¿½ Trimestre" :
             new Integer(new SimpleDateFormat("MM").format($P{dataInizio})).equals(new Integer(7)) ?
                     "IIIï¿½ Trimestre" :
	     new Integer(new SimpleDateFormat("MM").format($P{dataInizio})).equals(new Integer(10)) ?
                     "IVï¿½ Trimestre"   : ""
             )
	     :""
	)
)]]></expression>
		</element>
		<element kind="textField" key="textField-6" style="TNR12BOLD" x="158" y="77" width="100" height="18" uuid="f85e0725-b68f-4e9c-b272-054f8cdce923" pattern="" blankWhenNull="false" markup="styled" pdfFontName="Times-Bold">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA["Anno: " + new SimpleDateFormat("yyyy").format($P{dataInizio})]]></expression>
		</element>
		<element kind="textField" key="textField" style="TNR10" x="20" y="27" width="505" height="18" uuid="d0210cb8-c8d0-423f-a0b6-5169d5a9fae7" textAdjust="StretchHeight" blankWhenNull="false">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA["U.O. "+$F{CD_UNITA_ORGANIZZATIVA}+" - "+$F{DS_UNITA_ORGANIZZATIVA}]]></expression>
		</element>
		<element kind="textField" key="textField-1" style="TNR10BOLD" x="0" y="0" width="531" height="14" uuid="09e7d5eb-8ac2-48fa-a1a5-e38ae1e13400" blankWhenNull="true">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[($F{RAGIONE_SOCIALE_ENTE}!= null && $F{PARTITA_IVA_ENTE}!= null ?
	$F{RAGIONE_SOCIALE_ENTE}+ " " + $F{PARTITA_IVA_ENTE}:
  $F{RAGIONE_SOCIALE_ENTE}!= null ? $F{RAGIONE_SOCIALE_ENTE}:
  $F{PARTITA_IVA_ENTE}!= null ? $F{PARTITA_IVA_ENTE}:null)]]></expression>
		</element>
	</title>
