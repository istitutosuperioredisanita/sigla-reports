		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="Ragr_manuale" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="Ragr_chiusura" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="Ragr_doc_amm" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="Ragr_doc_cont" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="Ragr_liquid_iva" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="Ragr_mig_bene" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="Ragr_stipendi" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT * FROM V_COGE_SCR_MOV , CAUSALE_COGE
WHERE V_COGE_SCR_MOV.ESERCIZIO = CAUSALE_COGE.ESERCIZIO(+)
AND V_COGE_SCR_MOV.CD_CAUSALE_COGE = CAUSALE_COGE.CD_CAUSALE_COGE(+)
AND V_COGE_SCR_MOV.ESERCIZIO = $P{Esercizio}
AND V_COGE_SCR_MOV.CD_CDS LIKE decode($P{CDS},'*','%',$P{CDS})
AND V_COGE_SCR_MOV.CD_UNITA_ORGANIZZATIVA LIKE decode($P{UO},'*','%',$P{UO})
AND V_COGE_SCR_MOV.ATTIVA LIKE decode($P{Attiva},'*','%',$P{Attiva})
AND V_COGE_SCR_MOV.CD_VOCE_EP = $P{Conto}
AND V_COGE_SCR_MOV.TI_ISTITUZ_COMMERC LIKE decode($P{Ist_Comm},'*','%',$P{Ist_Comm})
and (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='CHIUSURA' and $P{Ragr_chiusura}='true'
or (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='PRIMA_NOTA_MANUALE' and $P{Ragr_manuale}='true')
or (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='CAUSALE' and $P{Ragr_causale}='true')
or (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='DOCAMM' and $P{Ragr_doc_amm}='true')
or (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='DOCCONT' and $P{Ragr_doc_cont}='true')
or (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='LIQUID_IVA' and $P{Ragr_liquid_iva}='true')
or (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='MIGRAZIONE_BENI' and $P{Ragr_mig_bene}='true')
or (V_COGE_SCR_MOV.ORIGINE_SCRITTURA='STIPENDI' and $P{Ragr_stipendi}='true'))
ORDER BY
    V_COGE_SCR_MOV.CD_CDS ASC, V_COGE_SCR_MOV.CD_UNITA_ORGANIZZATIVA ASC, V_COGE_SCR_MOV.PG_SCRITTURA ASC
	]]></query>
