	<variable name="DARE" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[($F{SEZIONE}.equals("D")?$F{IM_MOVIMENTO}:new BigDecimal(0))]]></expression>
	</variable>
	<variable name="AVERE" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[($F{SEZIONE}.equals("A")?$F{IM_MOVIMENTO}:new BigDecimal(0))]]></expression>
	</variable>
	<variable name="SUM_DARE" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$V{DARE}]]></expression>
	</variable>
	<variable name="SUM_AVERE" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$V{AVERE}]]></expression>
	</variable>
	<variable name="DIFFERENZA" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$V{AVERE}.add($V{DARE}.negate())]]></expression>
	</variable>
