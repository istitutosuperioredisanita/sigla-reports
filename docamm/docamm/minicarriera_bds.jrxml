	</parameter>
	<parameter name="esercizio" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(2003)]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio_stm" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(2003)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select * from VP_MINICARRIERA_BDS
where
   (( TI_RECORD_L1  = 'A' AND
      TI_RECORD_L2  = 'A' AND
      TI_RECORD_L3  = 'A' AND
      ESERCIZIO_BASE  = $P{esercizio_stm} AND
      CD_CDS  = $P{cds} AND
      CD_UNITA_ORGANIZZATIVA  = $P{uo} AND
      ESERCIZIO  = $P{esercizio} AND
      PG_MINICARRIERA  = $P{pg}) OR
    ((  TI_RECORD_L1  != 'A' OR
      TI_RECORD_L1  = 'A' AND
      TI_RECORD_L2  = 'B') AND
      CD_CDS  = $P{cds} AND
      CD_UNITA_ORGANIZZATIVA  = $P{uo} AND
      ESERCIZIO  = $P{esercizio} AND
      PG_MINICARRIERA  = $P{pg}))
ORDER BY
      TI_RECORD_L1,
      TI_RECORD_L2,
	pg_Rata,
      TI_RECORD_L3]]></query>
