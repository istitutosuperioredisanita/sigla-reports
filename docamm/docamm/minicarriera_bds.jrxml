	<variable name="TOT_AMMONTARE" class="java.math.BigDecimal" resetType="Group" resetGroup="PG_RATA_A" calculation="Sum">
		<expression><![CDATA[$F{AMMONTARE}]]></expression>
	</variable>
	<variable name="TOT_DETRAZIONI" class="java.math.BigDecimal" resetType="Group" resetGroup="PG_RATA_A" calculation="Sum">
		<expression><![CDATA[($F{DETRAZIONE_CONIUGE_NETTO}.
add($F{DETRAZIONE_FIGLI_NETTO}).
add($F{DETRAZIONI_LA_NETTO}).
add($F{DETRAZIONI_PERSONALI_NETTO}).
add($F{DETRAZIONE_ALTRI_NETTO}))]]></expression>
	</variable>
	<variable name="TOT_RATE" class="java.math.BigDecimal" resetType="Group" resetGroup="TIPO_R2" calculation="Sum">
		<expression><![CDATA[$F{IM_RATA}]]></expression>
	</variable>
	<variable name="TOT_TOT" class="java.math.BigDecimal" resetType="Group" incrementType="Group" incrementGroup="compenso" resetGroup="compenso" calculation="First">
		<expression><![CDATA[$F{IM_NETTO_PERCIPIENTE}]]></expression>
	</variable>
	<variable name="TOT" class="java.math.BigDecimal" resetType="Group" resetGroup="TIPO_R2" calculation="Sum">
		<expression><![CDATA[$V{TOT_TOT}]]></expression>
	</variable>
	<variable name="TOT_AMMONT" class="java.math.BigDecimal" resetType="Group" incrementType="Group" incrementGroup="compenso" resetGroup="compenso" calculation="Sum">
		<expression><![CDATA[($F{PG_RATA}.compareTo($F{MAX_PG_RATA})==0?$F{AMMONTARE}:new BigDecimal(0))]]></expression>
	</variable>
	<variable name="TOT_AM" class="java.math.BigDecimal" resetType="Group" resetGroup="TIPO_R2" calculation="Sum">
		<expression><![CDATA[$V{TOT_AMMONT}]]></expression>
	</variable>
	<variable name="TOT_DETRA" class="java.math.BigDecimal" resetType="Group" incrementType="Group" incrementGroup="compenso" resetGroup="compenso" calculation="Sum">
