($F{CD_PROVINCIA_NASCITA}==null?"":" ("+$F{CD_PROVINCIA_NASCITA}+") ")+
($F{DS_NAZIONE_NASCITA}==null?"":$F{DS_NAZIONE_NASCITA})+(
$F{DT_NASCITA}==null?"":" - "+(new SimpleDateFormat("dd/MM/yyyy")).format($F{DT_NASCITA}))]]></expression>
