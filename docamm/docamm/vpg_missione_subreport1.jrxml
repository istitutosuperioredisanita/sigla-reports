	<query language="sql"><![CDATA[
		SELECT COUNT(1) CONTA_SPESE
FROM VPG_MISSIONE
Where CD_CDS = $P{CD_CDS}
  And CD_UNITA_ORGANIZZATIVA = $P{CD_UNITA_ORGANIZZATIVA}
  And ESERCIZIO = $P{ESERCIZIO}
  And PG_MISSIONE = $P{PG_MISSIONE}
  And TI_RECORD_L1 = 'B'
  And TI_RECORD_L2 = 'B'
  And not exists(SELECT 1 FROM VPG_MISSIONE
		Where CD_CDS = $P{CD_CDS}
  		And CD_UNITA_ORGANIZZATIVA = $P{CD_UNITA_ORGANIZZATIVA}
  		And ESERCIZIO = $P{ESERCIZIO}
  		And PG_MISSIONE = $P{PG_MISSIONE}
                And TI_RECORD_L1 = 'B'
  		And TI_RECORD_L2 = 'A')
	]]></query>
