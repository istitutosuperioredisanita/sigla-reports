	<parameter name="CDS" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["080"]]></defaultValueExpression>
	</parameter>
	<parameter name="UO" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["080.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="Esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2020)]]></defaultValueExpression>
	</parameter>
	<parameter name="Pg_conguaglio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select a.*,
b.FL_DEDUZIONE_IRPEF,b.FL_DEDUZIONE_FAMILY,b.FL_DETRAZIONI_ALTRE,b.FL_DETRAZIONI_FAMILY
from vpg_conguaglio a, parametri_cnr b
WHERE a.ESERCIZIO = $P{Esercizio}
  AND a.CD_CDS like $P{CDS}
  AND a.CD_UNITA_ORGANIZZATIVA like $P{UO}
  AND a.PG_CONGUAGLIO = $P{Pg_conguaglio}
  AND a.ESERCIZIO = b.ESERCIZIO
order by tipo,pg_compenso
	]]></query>
