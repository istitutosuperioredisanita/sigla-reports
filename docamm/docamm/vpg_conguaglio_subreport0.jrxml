	<variable name="Tot_Detrazioni_Dovuta" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DETRAZIONI_PE_DOVUTO}.add($F{DETRAZIONI_LA_DOVUTO})).add($F{DETRAZIONI_CO_DOVUTO}).add($F{DETRAZIONI_FI_DOVUTO}).add($F{DETRAZIONI_AL_DOVUTO}).add($F{DETRAZIONE_RID_CUNEO_DOVUTO})]]></expression>
	</variable>
	<variable name="Tot_Detrazioni_Applicata" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DETRAZIONI_PE_GODUTO}.add($F{DETRAZIONI_LA_GODUTO})).add($F{DETRAZIONI_CO_GODUTO}).add($F{DETRAZIONI_FI_GODUTO}).add($F{DETRAZIONI_AL_GODUTO}).add($F{DETRAZIONE_RID_CUNEO_GODUTO})]]></expression>
	</variable>
	<variable name="Tot_Detrazioni_Diff" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DETRAZIONI_PE_GODUTO}.add($F{DETRAZIONI_LA_GODUTO}).add($F{DETRAZIONI_CO_GODUTO}).add($F{DETRAZIONI_FI_GODUTO}).add($F{DETRAZIONI_AL_GODUTO}).add($F{DETRAZIONE_RID_CUNEO_GODUTO})
.add($F{DETRAZIONI_PE_ESTERNO}).add($F{DETRAZIONI_LA_ESTERNO}).add($F{DETRAZIONI_CO_ESTERNO}).add($F{DETRAZIONI_FI_ESTERNO}).add($F{DETRAZIONI_AL_ESTERNO}).add($F{DETRAZIONE_RID_CUNEO_ESTERNO})).subtract
($F{DETRAZIONI_PE_DOVUTO}.add($F{DETRAZIONI_LA_DOVUTO}).add($F{DETRAZIONI_CO_DOVUTO}).add($F{DETRAZIONI_FI_DOVUTO}).add($F{DETRAZIONI_AL_DOVUTO}).add($F{DETRAZIONE_RID_CUNEO_DOVUTO}))]]></expression>
	</variable>
	<variable name="Tot_Im_netta_dovuta" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IM_IRPEF_DOVUTO}.subtract($V{Tot_Detrazioni_Dovuta})]]></expression>
	</variable>
	<variable name="Tot_Im_netta_applic" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IM_IRPEF_GODUTO}.subtract($V{Tot_Detrazioni_Applicata})]]></expression>
	</variable>
	<variable name="Tot_Detrazioni_Esterne" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DETRAZIONI_PE_ESTERNO}.add($F{DETRAZIONI_LA_ESTERNO})).add($F{DETRAZIONI_CO_ESTERNO}).add($F{DETRAZIONI_FI_ESTERNO}).add($F{DETRAZIONE_RID_CUNEO_ESTERNO}).add($F{DETRAZIONI_AL_ESTERNO})]]></expression>
	</variable>
	<variable name="Im_Irpef_Lorda_Esterna" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DETRAZIONI_PE_ESTERNO}.add($F{DETRAZIONI_LA_ESTERNO})).add($F{DETRAZIONI_CO_ESTERNO}).add($F{DETRAZIONI_FI_ESTERNO}).add($F{DETRAZIONI_AL_ESTERNO}).add($F{DETRAZIONE_RID_CUNEO_ESTERNO}).add($F{IM_IRPEF_ESTERNO})]]></expression>
	</variable>
