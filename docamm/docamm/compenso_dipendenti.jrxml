					</box>
					<text><![CDATA[Domicilio Fiscale]]></text>
				</element>
				<element kind="textField" textAdjust="StretchHeight" style="TNR9" x="112" y="5" width="149" height="15" key="textField-2" positionType="Float" printRepeatedValues="false" printWhenGroupChanges="PG_COMPENSO" blankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" hTextAlign="Left" vTextAlign="Top">
