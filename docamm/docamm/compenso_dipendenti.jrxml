					</box>
					<text><![CDATA[Data e luogo di nascita]]></text>
				</element>
				<element kind="textField" textAdjust="StretchHeight" style="TNR9" x="112" y="5" width="149" height="15" key="textField-4" positionType="Float" blankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self">
