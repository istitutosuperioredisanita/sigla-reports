				<element kind="textField" textAdjust="StretchHeight" style="TNR10" x="326" y="3" width="200" height="13" key="textField-31" positionType="Float" printRepeatedValues="false" printWhenGroupChanges="PG_COMPENSO" printWhenDetailOverflows="true" blankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" vTextAlign="Top">
