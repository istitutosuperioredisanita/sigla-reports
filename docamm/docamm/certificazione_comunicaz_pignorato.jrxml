<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="certificazione_comunicaz_pignorato" pageWidth="595" pageHeight="842" columnWidth="565" leftMargin="15" rightMargin="15" topMargin="20" bottomMargin="20" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR10" fontName="Times New Roman" pdfFontName="Times-Roman"/>
	<style name="TNR10B" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16B" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNR8B" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR8" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2011)]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from V_COMUNICAZIONE_PIGNORATI
where esercizio = $P{esercizio}
order by COGNOME_PIGNORATO, COGNOME_CREDITORE
	]]></query>
	<field name="ESERCIZIO" class="java.math.BigDecimal"/>
	<field name="CREDITORE" class="java.math.BigDecimal"/>
	<field name="COGNOME_CREDITORE" class="java.lang.String"/>
	<field name="NOME_CREDITORE" class="java.lang.String"/>
	<field name="RS_CREDITORE" class="java.lang.String"/>
	<field name="CF_CREDITORE" class="java.lang.String"/>
	<field name="LORDO_PERCIPIENTE" class="java.math.BigDecimal"/>
	<field name="PIGNORATO" class="java.math.BigDecimal"/>
	<field name="COGNOME_PIGNORATO" class="java.lang.String"/>
	<field name="NOME_PIGNORATO" class="java.lang.String"/>
	<field name="RS_PIGNORATO" class="java.lang.String"/>
	<field name="INDIRIZZO_PIGNORATO" class="java.lang.String"/>
	<field name="CAP_PIGNORATO" class="java.lang.String"/>
	<field name="FRAZIONE_PIGNORATO" class="java.lang.String"/>
	<field name="COMUNE_PIGNORATO" class="java.lang.String"/>
	<field name="PROV_PIGNORATO" class="java.lang.String"/>
	<field name="NAZIONE_PIGNORATO" class="java.lang.String"/>
	<field name="CF_PIGNORATO" class="java.lang.String"/>
	<group name="G1_pignorato" startNewColumn="true" startNewPage="true">
		<expression><![CDATA[$F{PIGNORATO}]]></expression>
		<groupHeader>
			<band height="215" splitType="Stretch">
				<element kind="staticText" key="staticText-1" style="TNR10" x="173" y="46" width="219" height="29" hTextAlign="Center">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<text><![CDATA[PIAZZALE ALDO MORO, 7 - ROMA
CF. 80054330586]]></text>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-1" style="TNR10" stretchType="ElementGroupHeight" x="298" y="108" width="267" height="14" blankWhenNull="true" hTextAlign="Left">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[($F{RS_PIGNORATO}==null?$F{COGNOME_PIGNORATO}+ " "+$F{NOME_PIGNORATO}:
$F{RS_PIGNORATO})]]></expression>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField" style="TNR10" stretchType="ElementGroupHeight" x="298" y="121" width="287" height="14" blankWhenNull="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{INDIRIZZO_PIGNORATO}]]></expression>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR10" stretchType="ElementGroupHeight" x="298" y="134" width="267" height="14" blankWhenNull="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[($F{FRAZIONE_PIGNORATO}==null?($F{CAP_PIGNORATO}==null?"":$F{CAP_PIGNORATO}):
$F{FRAZIONE_PIGNORATO}+" "+($F{CAP_PIGNORATO}==null?"":$F{CAP_PIGNORATO}))+" - "+
($F{COMUNE_PIGNORATO}!=null?$F{COMUNE_PIGNORATO}:" ")+($F{PROV_PIGNORATO}!=null?" ("+$F{PROV_PIGNORATO}+")":"")]]></expression>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-4" style="TNR10" stretchType="ElementGroupHeight" x="298" y="147" width="287" height="14" blankWhenNull="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{NAZIONE_PIGNORATO}]]></expression>
				</element>
				<element kind="image" key="image-1" x="107" y="0" width="405" height="40" onErrorType="Icon">
					<expression><![CDATA[$P{DIR_IMAGE}+"CNR.JPG"]]></expression>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-4" style="TNR10" stretchType="ElementGroupHeight" x="299" y="178" width="266" height="14" blankWhenNull="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA["C.F. "+$F{CF_PIGNORATO}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="73" splitType="Stretch">
				<element kind="subreport" key="subreport-1" stretchType="ContainerHeight" x="2" y="27" width="543" height="18" usingCache="true">
					<parameter name="DIR_IMAGE">
						<expression><![CDATA[$P{DIR_IMAGE}]]></expression>
					</parameter>
					<parameter name="esercizio">
						<expression><![CDATA[$P{esercizio}]]></expression>
					</parameter>
					<parameter name="SUBREPORT_DIR">
						<expression><![CDATA[$P{SUBREPORT_DIR}]]></expression>
					</parameter>
					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					<expression><![CDATA[$P{SUBREPORT_DIR}+"certificazione_firme.jasper"]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<group name="G1_CHIAVE_B" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{PIGNORATO}]]></expression>
		<groupHeader>
			<band height="52" splitType="Stretch">
				<element kind="textField" textAdjust="StretchHeight" key="textField-5" style="TNR10B" stretchType="ContainerHeight" x="0" y="15" width="565" height="20" printWhenGroupChanges="G1_pignorato" blankWhenNull="true" hTextAlign="Center" fontSize="12">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[("COMUNICAZIONE AL DEBITORE DELLE SOMME EROGATE AI CREDITORI PIGNORATIZI")]]></expression>
				</element>
			</band>
		</groupHeader>
	</group>
	<group name="G2_TIPO_A" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{PIGNORATO}]]></expression>
		<groupHeader>
			<band height="120" splitType="Stretch">
				<element kind="textField" textAdjust="StretchHeight" key="textField-6" style="TNR8" positionType="Float" x="22" y="4" width="523" height="49" blankWhenNull="true" hTextAlign="Justified" fontSize="12">
					<paragraph lineSpacing="1_1_2"/>
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA["Conformemente a quanto disposto dalla Circolare dell'Agenzia delle entrate n. 8/E del 02.03.2011, "+
"si elencano i creditori pignoratizi e le somme ad essi erogate nel corso dell'anno "+$F{ESERCIZIO}+"."]]></expression>
				</element>
				<element kind="line" key="line-2" stretchType="ElementGroupHeight" x="15" y="71" width="530" height="1"/>
				<element kind="line" key="line-3" stretchType="ElementGroupHeight" x="15" y="100" width="530" height="1"/>
				<element kind="staticText" key="staticText-7" style="TNR8B" positionType="Float" stretchType="ContainerHeight" x="283" y="77" width="115" height="20" hTextAlign="Center" fontSize="10">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<text><![CDATA[Codice Fiscale	]]></text>
				</element>
				<element kind="staticText" key="staticText-11" style="TNR8B" positionType="Float" stretchType="ContainerHeight" x="439" y="77" width="73" height="20" hTextAlign="Right" fontSize="10">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<text><![CDATA[Importo Erogato]]></text>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-6" style="TNR8" positionType="Float" stretchType="ContainerHeight" x="22" y="77" width="250" height="20" blankWhenNull="true" fontSize="10" bold="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[($F{RS_CREDITORE}==null?"Denominazione":
"Ragione Sociale")]]></expression>
				</element>
			</band>
		</groupHeader>
	</group>
	<group name="pignorato">
		<expression><![CDATA[$F{PIGNORATO}]]></expression>
	</group>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader splitType="Stretch"/>
	<columnHeader splitType="Stretch"/>
	<detail>
		<band height="30" splitType="Stretch">
			<element kind="textField" textAdjust="StretchHeight" key="textField-12" style="TNR8" x="22" y="9" width="250" height="14" blankWhenNull="true" fontSize="10">
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[($F{RS_CREDITORE}==null?$F{COGNOME_CREDITORE}+ " "+$F{NOME_CREDITORE}:
$F{RS_CREDITORE})]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-15" style="TNR8" x="283" y="9" width="115" height="14" pattern="" blankWhenNull="true" hTextAlign="Center" fontSize="10">
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$F{CF_CREDITORE}]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-19" style="TNR8" x="440" y="9" width="72" height="14" pattern=" #,##0.00" blankWhenNull="true" hTextAlign="Right" fontSize="10">
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$F{LORDO_PERCIPIENTE}]]></expression>
			</element>
		</band>
	</detail>
	<columnFooter splitType="Stretch"/>
	<pageFooter splitType="Stretch"/>
	<summary splitType="Stretch"/>
</jasperReport>
