					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$F{DT_INI_VALIDITA}]]></expression>
			</element>
			<element kind="textField" style="TNR8" x="298" y="2" width="78" height="10" key="textField" pattern="dd/MM/yyyy" blankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self" hTextAlign="Center">
				<box>
