	<variable name="AMM_LORDO" class="java.math.BigDecimal" resetType="Report" calculation="Nothing">
		<expression><![CDATA[($F{CLASSIFICAZIONE}.equals("PR")?$F{AMMONTARE_LORDO}:
($F{CLASSIFICAZIONE}.equals("IP")?$F{AMMONTARE_LORDO}:
($F{CLASSIFICAZIONE}.equals("R0")?$F{AMMONTARE_LORDO}:
($F{CLASSIFICAZIONE}.equals("P0")?$F{AMMONTARE_LORDO}:
($F{CLASSIFICAZIONE}.equals("C0")?$F{AMMONTARE_LORDO}:
($F{CLASSIFICAZIONE}.equals("IL")?$F{AMMONTARE_LORDO}:
($F{CLASSIFICAZIONE}.equals("IV")?$F{AMMONTARE_LORDO}:
($F{CLASSIFICAZIONE}.equals("ST")?$F{AMMONTARE_LORDO}:new BigDecimal("0")))))))))]]></expression>
	</variable>
	<variable name="Sum_AMM_LORDO" class="java.math.BigDecimal" resetType="None" calculation="Sum">
		<expression><![CDATA[$V{AMM_LORDO}]]></expression>
	</variable>
