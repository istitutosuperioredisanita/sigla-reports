	<parameter name="DIR_IMAGE" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="Esercizio" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer("2007")]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["000"]]></defaultValueExpression>
	</parameter>
	<parameter name="UO" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["000.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="Pg_compenso" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer("19")]]></defaultValueExpression>
	</parameter>
	<parameter name="Pg_inizio" forPrompting="false" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long("5")]]></defaultValueExpression>
	</parameter>
	<parameter name="Pg_fine" forPrompting="false" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long("5")]]></defaultValueExpression>
	</parameter>
	<parameter name="Terzo" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["%"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select a.*,
b.FL_DEDUZIONE_IRPEF,b.FL_DEDUZIONE_FAMILY,b.FL_DETRAZIONI_ALTRE,b.FL_DETRAZIONI_FAMILY
from v_compenso a, parametri_cnr b
WHERE a.ESERCIZIO = $P{Esercizio}
  AND a.CD_CDS like $P{CDS}
  AND a.CD_UNITA_ORGANIZZATIVA like $P{UO}
AND a.PG_COMPENSO between $P{Pg_inizio} and $P{Pg_fine}
AND a.CD_TERZO like $P{Terzo}
AND a.ESERCIZIO = b.ESERCIZIO
and a.ti_dipendente_altro='A'
order by a.cd_unita_organizzativa,a.pg_compenso, a.ordinamento, a.classificazione]]></query>
	<field name="CD_CDS" class="java.lang.String"/>
	<field name="CD_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
