		<element kind="textField" textAdjust="StretchHeight" style="TNR9" x="0" y="53" width="802" height="13" key="textField" blankWhenNull="true" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self">
			<box/>
