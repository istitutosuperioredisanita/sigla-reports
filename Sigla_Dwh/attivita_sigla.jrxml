	<query language="sql"><![CDATA[select a.*,t1.cd_terzo cd1,t1.denominazione_sede ds1,
t2.denominazione_sede ds2,
t3.denominazione_sede ds3,
t4.denominazione_sede ds4,
t5.denominazione_sede ds5,
t6.denominazione_sede ds6 
from attivita_sigla a,terzo t1,terzo t2,terzo t3,terzo t4,terzo t5,terzo t6
where a.cd_responsabile_1=t1.cd_terzo(+)
and a.cd_responsabile_2=t2.cd_terzo(+)
and a.cd_responsabile_3=t3.cd_terzo(+)
and a.cd_responsabile_4=t4.cd_terzo(+)
and a.cd_responsabile_5=t5.cd_terzo(+)
and a.cd_responsabile_6=t6.cd_terzo(+)
and (nvl(a.cd_responsabile_1,0)  like $P{Responsabile}
    or nvl(a.cd_responsabile_2,0)  like $P{Responsabile}
    or nvl(a.cd_responsabile_3,0)  like $P{Responsabile}
    or nvl(a.cd_responsabile_4,0)  like $P{Responsabile}
    or nvl(a.cd_responsabile_5,0)  like $P{Responsabile}
    or nvl(a.cd_responsabile_6,0)  like $P{Responsabile})
and a.esercizio like $P{Esercizio}
and ((a.stato='A' and $P{Stato_analisi}='true')
or (a.stato='S' and $P{Stato_sviluppo}='true')
or (a.stato='T' and $P{Stato_test}='true')
or (a.stato='R' and $P{Stato_rilasciato}='true')
or (a.stato='I' and $P{Stato_iniziale}='true')
or (a.stato='D' and $P{Stato_differito}='true'))
and ((a.tipo_attivita='C' and $P{Tipo_att_correttiva}='true')
or (a.tipo_attivita='E' and $P{Tipo_att_evolutiva}='true')
or (a.tipo_attivita='M' and $P{Tipo_att_manutentiva}='true')
or (a.tipo_attivita='D' and $P{Tipo_att_estrazione_dati}='true')
or (a.tipo_attivita='G' and $P{Tipo_att_supporto_gestione}='true'))]]></query>
