($F{DS3}==null?"":'-'+$F{DS3})+
($F{DS4}==null?"":'-'+$F{DS4})+
($F{DS5}==null?"":'-'+$F{DS5})+
($F{DS6}==null?"":'-'+$F{DS6})]]></expression>
