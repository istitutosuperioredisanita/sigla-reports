($P{Responsabile}.equals($F{CD_RESPONSABILE_2})?$F{DS2}:
($P{Responsabile}.equals($F{CD_RESPONSABILE_3})?$F{DS3}:
($P{Responsabile}.equals($F{CD_RESPONSABILE_4})?$F{DS4}:
($P{Responsabile}.equals($F{CD_RESPONSABILE_5})?$F{DS5}:
($P{Responsabile}.equals($F{CD_RESPONSABILE_6})?$F{DS6}:"Tutti"))))))]]></expression>
		</element>
