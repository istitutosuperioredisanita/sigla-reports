	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer("2016")]]></defaultValueExpression>
	</parameter>
	<parameter name="cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["073"]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["073.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="cdr" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT v.*, p.fl_nuovo_pdg
FROM V_SIT_DETT_GAE_RESIDUI_SPE v, parametri_cnr p
WHERE   v.ESERCIZIO = $P{esercizio}
  AND   v.CDS = $P{cds}
  AND   v.UO LIKE DECODE($P{uo},'*','%',$P{uo})
  AND   v.CD_CENTRO_RESPONSABILITA LIKE DECODE($P{cdr},'*','%',$P{cdr})
and v.esercizio = p.esercizio
ORDER BY  v.CDS ASC,  v.UO ASC,  v.CD_COMMESSA ASC,
      v.CD_CENTRO_RESPONSABILITA ASC,
      v.CD_MODULO ASC, v.CD_LINEA_ATTIVITA ASC,
     v.CD_ELEMENTO_VOCE ASC
	]]></query>
