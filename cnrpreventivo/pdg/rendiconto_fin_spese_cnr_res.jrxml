	<query language="sql"><![CDATA[SELECT 
    PRT_REND_FIN_SPESE_ART_CNR.ESER, 
    PRT_REND_FIN_SPESE_ART_CNR.PARTE, PRT_REND_FIN_SPESE_ART_CNR.DS_PARTE, 
    PRT_REND_FIN_SPESE_ART_CNR.TITOLO, PRT_REND_FIN_SPESE_ART_CNR.DS_TITOLO, 
    PRT_REND_FIN_SPESE_ART_CNR.CATEGORIA, PRT_REND_FIN_SPESE_ART_CNR.DS_CATEGORIA, 
    PRT_REND_FIN_SPESE_ART_CNR.SEZIONE, PRT_REND_FIN_SPESE_ART_CNR.DS_SEZIONE,
    PRT_REND_FIN_SPESE_ART_CNR.CAPITOLO, PRT_REND_FIN_SPESE_ART_CNR.DS_CAPITOLO, 
    PRT_REND_FIN_SPESE_ART_CNR.ARTICOLO, PRT_REND_FIN_SPESE_ART_CNR.DS_ARTICOLO,
    PRT_REND_FIN_SPESE_ART_CNR.INIZIALE_R, PRT_REND_FIN_SPESE_ART_CNR.VAR_PIU_R, 
    PRT_REND_FIN_SPESE_ART_CNR.VAR_MENO_R, PRT_REND_FIN_SPESE_ART_CNR.ASSESTATO_R, 
    PRT_REND_FIN_SPESE_ART_CNR.ACCREDITAMENTI_R, PRT_REND_FIN_SPESE_ART_CNR.REGOLARIZZATI_R, 
    PRT_REND_FIN_SPESE_ART_CNR.IN_MENO_R, PRT_REND_FIN_SPESE_ART_CNR.TOT_ACCRED, 
    PRT_REND_FIN_SPESE_ART_CNR.TOT_DA_ACCRED, PRT_REND_FIN_SPESE_ART_CNR.CDS_OR
FROM
    PRT_REND_FIN_SPESE_ART_CNR
WHERE
    $P{cds} = $P{all} AND
    PRT_REND_FIN_SPESE_ART_CNR.ESER = $P{esercizio}
union
SELECT 
    PRT_REND_FI_S_ART_CNR_XCDS.ESER, 
    PRT_REND_FI_S_ART_CNR_XCDS.PARTE, PRT_REND_FI_S_ART_CNR_XCDS.DS_PARTE,
    PRT_REND_FI_S_ART_CNR_XCDS.TITOLO, PRT_REND_FI_S_ART_CNR_XCDS.DS_TITOLO, 
    PRT_REND_FI_S_ART_CNR_XCDS.CATEGORIA, PRT_REND_FI_S_ART_CNR_XCDS.DS_CATEGORIA, 
    PRT_REND_FI_S_ART_CNR_XCDS.SEZIONE, PRT_REND_FI_S_ART_CNR_XCDS.DS_SEZIONE, 
    PRT_REND_FI_S_ART_CNR_XCDS.CAPITOLO, PRT_REND_FI_S_ART_CNR_XCDS.CAPITOLO, 
    PRT_REND_FI_S_ART_CNR_XCDS.ARTICOLO, PRT_REND_FI_S_ART_CNR_XCDS.DS_ARTICOLO,
    PRT_REND_FI_S_ART_CNR_XCDS.INIZIALE_R, PRT_REND_FI_S_ART_CNR_XCDS.VAR_PIU_R, 
    PRT_REND_FI_S_ART_CNR_XCDS.VAR_MENO_R, PRT_REND_FI_S_ART_CNR_XCDS.ASSESTATO_R, 
    PRT_REND_FI_S_ART_CNR_XCDS.ACCREDITAMENTI_R, PRT_REND_FI_S_ART_CNR_XCDS.REGOLARIZZATI_R, 
    PRT_REND_FI_S_ART_CNR_XCDS.IN_MENO_R, PRT_REND_FI_S_ART_CNR_XCDS.TOT_ACCRED, 
    PRT_REND_FI_S_ART_CNR_XCDS.TOT_DA_ACCRED, PRT_REND_FI_S_ART_CNR_XCDS.CDS_OR
FROM
    PRT_REND_FI_S_ART_CNR_XCDS
WHERE
    $P{cds} != $P{all} AND
    PRT_REND_FI_S_ART_CNR_XCDS.ESER = $P{esercizio} AND
    PRT_REND_FI_S_ART_CNR_XCDS.CDS_OR = $P{cds}
ORDER BY
    ESER ASC,
    PARTE ASC,
    TITOLO ASC,
    CATEGORIA ASC,
    SEZIONE ASC,
    CAPITOLO ASC,
    ARTICOLO ASC]]></query>
