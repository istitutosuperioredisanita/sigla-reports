	<query language="sql"><![CDATA[select * from
   PRT_REND_FIN_SPESE_CDS_SAC,
   PRT_FC_FINALE
WHERE
   PRT_REND_FIN_SPESE_CDS_SAC.ESERCIZIO =PRT_FC_FINALE.ESERCIZIO and
   PRT_REND_FIN_SPESE_CDS_SAC.CDS = PRT_FC_FINALE.CDS and
   PRT_REND_FIN_SPESE_CDS_SAC.ESERCIZIO = $P{esercizio} 
ORDER BY RUBRICA,ARTICOLO]]></query>
