	<query language="sql"><![CDATA[
		select * from V_CONS_DISP_COMP_RES_SINTESI v
where exists (select 1 from  v_stm_paramin_sit_sint_gae vp
where v.esercizio = vp.esercizio
and v.cdr = vp.cdr
and v.lda = vp.gae
and id_report = $P{Idrpt})
and esercizio = $P{Esercizio}
	]]></query>
