			</box>
			<expression><![CDATA[$P{NOME_EST}+($P{DESCR_AGG_ENTE}!=null?" - "+$P{DESCR_AGG_ENTE}:"")+
($P{P_CENTRO_RESPONSABILITA}!=null?" - CDR: "+$P{P_CENTRO_RESPONSABILITA}:"")]]></expression>
		</element>
