	<query language="sql"><![CDATA[
		SELECT CD_PROGETTO CD_PROGLIV2, DS_PROGETTO DS_PROGLIV2,
P_CD_PROGETTO CD_PROGLIV1, P_DS_PROGETTO DS_PROGLIV1
FROM V_PROGETTO_PADRE
WHERE ESERCIZIO = $P{P_ESERCIZIO}
AND PG_PROGETTO = $P{P_PG_PROGLIV2}
AND TIPO_FASE='X'
	]]></query>
	<field name="CD_PROGLIV2" class="java.lang.String"/>
	<field name="DS_PROGLIV2" class="java.lang.String"/>
	<field name="CD_PROGLIV1" class="java.lang.String"/>
	<field name="DS_PROGLIV1" class="java.lang.String"/>
	<title height="174">
		<element kind="staticText" x="6" y="8" width="830" height="28" uuid="ee77c521-8172-420a-ad28-dae457243906" hTextAlign="Center" vTextAlign="Middle" fontSize="16" bold="true">
			<text><![CDATA[Situazione Contabile Progetto]]></text>
		</element>
		<element kind="textField" x="6" y="40" width="830" height="20" uuid="6a88edc3-d1d6-4351-a9e5-ad02e17f8d5a" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["ESERCIZIO: "+$P{P_ESERCIZIO}]]></expression>
		</element>
		<element kind="textField" x="6" y="62" width="830" height="20" uuid="87712806-4968-49f0-b4c6-138e5dd69c15" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["CENTRO RESPONSABILITA': "+$P{P_CENTRO_RESPONSABILITA}]]></expression>
		</element>
		<element kind="textField" x="6" y="84" width="830" height="20" uuid="7b168d01-248e-49b3-81b5-d14ca31520a2" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["AREA PROGETTUALE: "+$F{CD_PROGLIV1}+" - PROGETTO: "+$F{CD_PROGLIV2}]]></expression>
		</element>
		<element kind="textField" x="6" y="106" width="830" height="20" uuid="f720df77-d4e6-480d-ab89-f1f10e5d4cf7" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[("".equals($P{P_GAE}) || "*".equals($P{P_GAE}))?"TUTTE LE GAE"+
				($P{P_RESPONSABILE_GAE}!=null && !$P{P_RESPONSABILE_GAE}.equals(-1)?" DEL RESPONSABILE: "+$P{P_RESPONSABILE_GAE}+" - "+
				 $P{P_DS_RESPONSABILE_GAE}:"")
				:"GAE: "+$P{P_GAE}]]></expression>
		</element>
		<element kind="textField" x="6" y="128" width="830" height="20" uuid="26d9f49c-7ed1-4f43-873c-e2665aaaa956" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[($P{P_PRINT_ANNO}||$P{P_PRINT_VOCE})?
"ORDINATA PER "+("V".equals($P{P_ORDINE})?"VOCE/ANNO":"ANNO/VOCE"):""]]></expression>
		</element>
		<element kind="textField" x="6" y="150" width="830" height="20" uuid="e411b11a-ffb8-43e5-ad7e-d6a5e45e1e97" hTextAlign="Center" vTextAlign="Middle">
			<printWhenExpression><![CDATA[$P{P_PRINT_SOLO_GAE_ATTIVE}]]></printWhenExpression>
			<expression><![CDATA["SOLO GAE MOVIMENTATE NELL'ESERCIZIO"]]></expression>
		</element>
		<element kind="break" x="0" y="172" width="100" height="1" uuid="637933de-3cc6-4a99-86db-6274bfbf1998"/>
	</title>
	<pageHeader height="42">
		<element kind="textField" key="textField-184" style="VERB8" x="30" y="6" width="547" height="15" uuid="c6033106-cab0-4e3c-b6a4-f0af7b696abc" blankWhenNull="false" vTextAlign="Middle" rotation="None" fontName="Times New Roman" fontSize="7" bold="true" italic="false" underline="false" strikeThrough="false" pdfFontName="Times-Roman" pdfEncoding="Cp1252">
			<paragraph lineSpacing="Single"/>
			<box>
				<topPen lineWidth="0.0" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineColor="#000000"/>
			</box>
			<expression><![CDATA["SITUAZIONE CONTABILE PROGETTO: "+$F{CD_PROGLIV2}+
				($P{P_GAE}!=null&&!"*".equals($P{P_GAE})?" - GAE: "+$P{P_GAE}:
				 $P{P_RESPONSABILE_GAE}!=null && !$P{P_RESPONSABILE_GAE}.equals(-1)?" - RESPONSABILE: "+$P{P_RESPONSABILE_GAE}+" - "+
				 $P{P_DS_RESPONSABILE_GAE}:"")]]></expression>
		</element>
		<element kind="textField" key="textField-184" style="VERB8" x="54" y="22" width="768" height="15" uuid="3f0ca22e-d402-4bc6-9130-cc0e9bba9170" blankWhenNull="false" vTextAlign="Middle" rotation="None" fontName="Times New Roman" fontSize="7" bold="false" italic="false" underline="false" strikeThrough="false" pdfFontName="Times-Roman" pdfEncoding="Cp1252">
