	<parameter name="cdr" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT     * FROM  V_ANALITICA_LDA_COMRES
WHERE
ESERCIZIO = $P{esercizio} AND
CDS LIKE decode($P{cds},'*','%',$P{cds}) AND
(UO like decode($P{uo},'*','%',$P{uo}) or
uo_aff = $P{uo}) and
cdr like decode($P{cdr},'*','%',$P{cdr})
order by COMMESSA,CDR,MODULO,LDA,VOCE
]]></query>
