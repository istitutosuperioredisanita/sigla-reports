	</parameter>
	<query language="sql"><![CDATA[SELECT     * FROM    PRT_ANALITICA_LDA_ent
WHERE
ESERCIZIO = $P{esercizio} AND
CDS LIKE decode($P{cds},'*','%',$P{cds}) AND
(UO like decode($P{uo},'*','%',$P{uo}) or
uo_aff = $P{uo}) and
cdr like decode($P{cdr},'*','%',$P{cdr}) 
order by cds,uo,cdr,lda,voce]]></query>
