	<parameter name="DIR_IMAGE" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="Idrpt" forPrompting="false" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long(469042)]]></defaultValueExpression>
	</parameter>
	<parameter name="Esercizio" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(2009)]]></defaultValueExpression>
	</parameter>
	<parameter name="CDR" forPrompting="false" class="java.lang.String"/>
	<query language="sql"><![CDATA[select * from v_cons_gae_comp_res_sintesi v
where exists (select 1 from v_stm_paramin_sit_sint_gae vp
where v.esercizio = vp.esercizio
and v.cdr = vp.cdr
and v.lda = vp.gae
and id_report = $P{Idrpt})
and esercizio=$P{Esercizio}
order by cdr, cd_responsabile_terzo,lda,cd_elemento_voce,
pg_obbligazione,pg_obbligazione_scadenzario]]></query>
