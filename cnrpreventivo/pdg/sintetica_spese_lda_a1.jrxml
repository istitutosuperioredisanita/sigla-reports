	<parameter name="cdr" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT     * FROM    PRT_SINTESI_LDA_SPE
WHERE
ESERCIZIO = $P{esercizio} AND
CDS LIKE decode($P{cds},'*','%',$P{cds}) AND
(UO like decode($P{uo},'*','%',$P{uo}) or
uo_aff = $P{uo}) and
cdr like decode($P{cdr},'*','%',$P{cdr})
order by cds,uo,cdr,lda]]></query>
