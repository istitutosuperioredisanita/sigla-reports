	<variable name="SUM_INIZIALI_RIB_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{INIZIALI_RIB}]]></expression>
	</variable>
