<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="totali_x_natura_dett_imp" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR9" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNR9G" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR8G" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer("2007")]]></defaultValueExpression>
	</parameter>
	<parameter name="cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043"]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043.002"]]></defaultValueExpression>
	</parameter>
	<parameter name="cdr" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043.002.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="etr_spe" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["E"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="commessa" class="java.lang.String" forPrompting="false"/>
	<query language="sql"><![CDATA[
		SELECT v.*, p.fl_nuovo_pdg FROM V_SIT_DETT_GAE_RESIDUI_SPE v, parametri_cnr p
WHERE v.ESERCIZIO = $P{esercizio}
  AND  v.CDS = $P{cds}
  AND  v.UO = $P{uo}
  AND  v.CD_CENTRO_RESPONSABILITA = $P{cdr}
 AND  v.CD_COMMESSA = $P{commessa}
and v.esercizio = p.esercizio
ORDER BY  cd_natura asc
	]]></query>
	<field name="ESERCIZIO" class="java.lang.Integer"/>
	<field name="CDS" class="java.lang.String"/>
	<field name="UO" class="java.lang.String"/>
	<field name="CD_CENTRO_RESPONSABILITA" class="java.lang.String"/>
	<field name="DS_CDR" class="java.lang.String"/>
