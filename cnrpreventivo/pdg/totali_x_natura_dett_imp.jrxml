						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[($F{FL_NUOVO_PDG}.equals( "N" )?"Tot Commessa ":"Totale Area Progettuale ")+$P{commessa}+" Natura "+$F{CD_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-2" style="TNR8G" x="172" y="4" width="55" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right" markup="styled">
