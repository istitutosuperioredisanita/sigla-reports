	</parameter>
	<query language="sql"><![CDATA[
		SELECT v.*, p.FL_NUOVO_PDG
FROM V_SIT_ANAL_GAE_RESIDUI_SPE v, PARAMETRI_CNR p
WHERE  v.ESERCIZIO = $P{esercizio}
  AND  v.CDS = $P{cds}
  AND  v.UO LIKE DECODE($P{uo},'*','%',$P{uo})
  AND  v.CD_CENTRO_RESPONSABILITA LIKE DECODE($P{cdr},'*','%',$P{cdr})
and v.esercizio = p.esercizio
ORDER BY  v.CDS ASC, v.UO ASC, v.CD_COMMESSA ASC, v.esercizio_res ASC,
     v.CD_CENTRO_RESPONSABILITA ASC,  v.CD_MODULO ASC,
     v.CD_LINEA_ATTIVITA ASC, v.CD_ELEMENTO_VOCE ASC
	]]></query>
