	<query language="sql"><![CDATA[
		SELECT ESERCIZIO, STATO, PG_CONTRATTO, OGGETTO
FROM CONTRATTO
WHERE PG_PROGETTO = $P{P_PG_PROGETTO}
AND (CD_UNITA_ORGANIZZATIVA=SUBSTR($P{P_CENTRO_RESPONSABILITA},1,7) OR
SUBSTR($P{P_CENTRO_RESPONSABILITA},1,7)=$P{P_UO_COORDINATRICE})
ORDER BY ESERCIZIO, STATO, PG_CONTRATTO
	]]></query>
