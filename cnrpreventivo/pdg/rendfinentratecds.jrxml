	<parameter name="esercizio" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(2006)]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select * from
   PRT_REND_FIN_ENTRATE_CDS,
   PRT_FC_FINALE
WHERE
   PRT_REND_FIN_ENTRATE_CDS.ESERCIZIO =PRT_FC_FINALE.ESERCIZIO and
   PRT_REND_FIN_ENTRATE_CDS.CDS = PRT_FC_FINALE.CDS and
   PRT_REND_FIN_ENTRATE_CDS.ESERCIZIO = $P{esercizio} and
   PRT_REND_FIN_ENTRATE_CDS.CDS = $P{cds}  AND
CAPITOLO !='00.001'
ORDER BY TITOLO,CAPITOLO]]></query>
