	<style name="TNR8G" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer("2007")]]></defaultValueExpression>
	</parameter>
	<parameter name="cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043"]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043.002"]]></defaultValueExpression>
	</parameter>
	<parameter name="cdr" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043.002.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="etr_spe" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["E"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="commessa" class="java.lang.String" forPrompting="false"/>
	<query language="sql"><![CDATA[
		SELECT v.*, p.fl_nuovo_pdg FROM V_SIT_ANAL_GAE_RESIDUI_SPE v, parametri_cnr p
WHERE v.ESERCIZIO = $P{esercizio}
  AND v.CDS = $P{cds}
  AND v.UO = $P{uo}
  AND v.CD_CENTRO_RESPONSABILITA  = $P{cdr}
AND v.CD_COMMESSA = $P{commessa}
and v.esercizio = p.esercizio
ORDER BY  v.cd_natura asc
	]]></query>
