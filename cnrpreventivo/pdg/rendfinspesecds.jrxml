	<query language="sql"><![CDATA[select * from
   PRT_REND_FIN_SPESE_CDS,
   PRT_FC_FINALE
WHERE
   PRT_REND_FIN_SPESE_CDS.ESERCIZIO =PRT_FC_FINALE.ESERCIZIO and
   PRT_REND_FIN_SPESE_CDS.CDS = PRT_FC_FINALE.CDS and
   PRT_REND_FIN_SPESE_CDS.ESERCIZIO = $P{esercizio} and
   PRT_REND_FIN_SPESE_CDS.CDS = $P{cds} 
ORDER BY PARTE,TITOLO,SEZIONE,RUBRICA]]></query>
