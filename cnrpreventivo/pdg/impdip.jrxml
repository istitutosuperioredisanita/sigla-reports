	<parameter name="DIR_IMAGE" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(2006)]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA[new String("000001")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select * from PRT_IMP_DIP where
eserc=$P{esercizio} and
uo  like decode($P{uo},'*','%',substr($P{uo},1,3)||substr($P{uo},4,3))
order by uo]]></query>
	<field name="CODANAG" class="java.math.BigDecimal"/>
	<field name="MATRICOLA" class="java.math.BigDecimal"/>
