	<parameter name="P_ORDINE" class="java.lang.String">
		<description><![CDATA["V": Voce - "A": Anno]]></description>
		<defaultValueExpression><![CDATA["A"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT SUM(DECODE(TI_GESTIONE,'E',TOT_NUMMOV,0)) NUM_DETTAGLI_ETR,
       SUM(DECODE(TI_GESTIONE,'S',TOT_NUMMOV,0)) NUM_DETTAGLI_SPE,
       CD_CENTRO_RESPONSABILITA, PG_PROGETTO PG_PROGLIV2
FROM TMP_STAMPA_SITUAZIONE_PROGETTI
WHERE ESERCIZIO = $P{P_ESERCIZIO}
AND   TIPO_RECORD = 'PRINC'
GROUP BY CD_CENTRO_RESPONSABILITA, PG_PROGETTO
ORDER BY CD_CENTRO_RESPONSABILITA
	]]></query>
	<field name="NUM_DETTAGLI_ETR" class="java.lang.Integer"/>
	<field name="NUM_DETTAGLI_SPE" class="java.lang.Integer"/>
	<field name="CD_CENTRO_RESPONSABILITA" class="java.lang.String"/>
	<field name="PG_PROGLIV2" class="java.lang.Integer"/>
