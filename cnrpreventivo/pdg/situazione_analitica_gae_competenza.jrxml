		<defaultValueExpression><![CDATA["073.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="cdr" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["073.000.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="etr_spe" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["S"]]></defaultValueExpression>
