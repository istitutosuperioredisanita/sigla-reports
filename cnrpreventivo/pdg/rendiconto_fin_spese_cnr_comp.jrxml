		<defaultValueExpression><![CDATA[new String("")]]></defaultValueExpression>
	</parameter>
	<parameter name="all" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA[new String("*")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
    PRT_AVANZO_DISAVANZO.TIPO AVANZO_TIPO, 
     nvl(PRT_AVANZO_DISAVANZO.DS_VOCE_AVANZO_DISAVANZO,' ') AVANZO_DISAVANZO_DS, 
    nvl(PRT_AVANZO_DISAVANZO.INIZIALE,0) AVANZO_INIZIALE, 
    nvl(PRT_AVANZO_DISAVANZO.VAR_PIU,0) AVANZO_VAR_PIU, 
    nvl(PRT_AVANZO_DISAVANZO.VAR_MENO,0) AVANZO_VAR_MENO, 
nvl(PRT_AVANZO_DISAVANZO.ASSESTATO,0) AVANZO_ASSESTATO, 
    PRT_REND_FIN_SPESE_ART_CNR.ESER,
    PRT_REND_FIN_SPESE_ART_CNR.PARTE, PRT_REND_FIN_SPESE_ART_CNR.DS_PARTE, 
    PRT_REND_FIN_SPESE_ART_CNR.TITOLO, PRT_REND_FIN_SPESE_ART_CNR.DS_TITOLO, 
    PRT_REND_FIN_SPESE_ART_CNR.CATEGORIA, PRT_REND_FIN_SPESE_ART_CNR.DS_CATEGORIA, 
    PRT_REND_FIN_SPESE_ART_CNR.SEZIONE, PRT_REND_FIN_SPESE_ART_CNR.DS_SEZIONE,
    PRT_REND_FIN_SPESE_ART_CNR.CAPITOLO, PRT_REND_FIN_SPESE_ART_CNR.DS_CAPITOLO, 
    PRT_REND_FIN_SPESE_ART_CNR.ARTICOLO, PRT_REND_FIN_SPESE_ART_CNR.DS_ARTICOLO, 
    PRT_REND_FIN_SPESE_ART_CNR.INIZIALE, PRT_REND_FIN_SPESE_ART_CNR.VAR_PIU, 
    PRT_REND_FIN_SPESE_ART_CNR.VAR_MENO, PRT_REND_FIN_SPESE_ART_CNR.ASSESTATO, 
    PRT_REND_FIN_SPESE_ART_CNR.IMPEGNATO, PRT_REND_FIN_SPESE_ART_CNR.ACCREDITAMENTI, 
    PRT_REND_FIN_SPESE_ART_CNR.REGOLARIZZATI, 
    PRT_REND_FIN_SPESE_ART_CNR.DA_ACCRED, PRT_REND_FIN_SPESE_ART_CNR.IN_MENO, 
    PRT_REND_FIN_SPESE_ART_CNR.IN_PIU, PRT_REND_FIN_SPESE_ART_CNR.CDS_OR, 
    (select sum(IM_CASSA_INIZIALE) from esercizio
    where   PRT_REND_FIN_SPESE_ART_CNR.ESER = ESERCIZIO.ESERCIZIO ) im_cassa_iniziale
FROM
    PRT_AVANZO_DISAVANZO,
    PRT_REND_FIN_SPESE_ART_CNR
WHERE
    $P{cds} =  $P{all} AND
    PRT_AVANZO_DISAVANZO.ESER(+) = PRT_REND_FIN_SPESE_ART_CNR.ESER AND
    PRT_AVANZO_DISAVANZO.CDS (+)= PRT_REND_FIN_SPESE_ART_CNR.CDS AND 
    PRT_REND_FIN_SPESE_ART_CNR.ESER = $P{esercizio} AND
    PRT_AVANZO_DISAVANZO.TIPO(+) = 'D_C'
UNION
SELECT 
    PRT_AVANZO_DISAVANZO.TIPO, 
    nvl(PRT_AVANZO_DISAVANZO.DS_VOCE_AVANZO_DISAVANZO,' '), 
    nvl(PRT_AVANZO_DISAVANZO.INIZIALE,0) iNIZIALE, 
    nvl(PRT_AVANZO_DISAVANZO.VAR_PIU,0) VAR_PIU, 
    nvl(PRT_AVANZO_DISAVANZO.VAR_MENO,0) VAR_MENO, 
nvl(PRT_AVANZO_DISAVANZO.ASSESTATO,0) ASSESTATO, 
    PRT_REND_FI_S_ART_CNR_XCDS.ESER, 
    PRT_REND_FI_S_ART_CNR_XCDS.PARTE, PRT_REND_FI_S_ART_CNR_XCDS.DS_PARTE,
    PRT_REND_FI_S_ART_CNR_XCDS.TITOLO, PRT_REND_FI_S_ART_CNR_XCDS.DS_TITOLO, 
    PRT_REND_FI_S_ART_CNR_XCDS.CATEGORIA, PRT_REND_FI_S_ART_CNR_XCDS.DS_CATEGORIA, 
    PRT_REND_FI_S_ART_CNR_XCDS.SEZIONE, PRT_REND_FI_S_ART_CNR_XCDS.DS_SEZIONE, 
    PRT_REND_FI_S_ART_CNR_XCDS.CAPITOLO, PRT_REND_FI_S_ART_CNR_XCDS.DS_CAPITOLO,
    PRT_REND_FI_S_ART_CNR_XCDS.ARTICOLO, PRT_REND_FI_S_ART_CNR_XCDS.DS_ARTICOLO, 
    PRT_REND_FI_S_ART_CNR_XCDS.INIZIALE, PRT_REND_FI_S_ART_CNR_XCDS.VAR_PIU, 
    PRT_REND_FI_S_ART_CNR_XCDS.VAR_MENO, PRT_REND_FI_S_ART_CNR_XCDS.ASSESTATO, 
    PRT_REND_FI_S_ART_CNR_XCDS.IMPEGNATO, PRT_REND_FI_S_ART_CNR_XCDS.ACCREDITAMENTI, 
    PRT_REND_FI_S_ART_CNR_XCDS.REGOLARIZZATI, 
    PRT_REND_FI_S_ART_CNR_XCDS.DA_ACCRED, PRT_REND_FI_S_ART_CNR_XCDS.IN_MENO, 
    PRT_REND_FI_S_ART_CNR_XCDS.IN_PIU, PRT_REND_FI_S_ART_CNR_XCDS.CDS_OR, 
    ESERCIZIO.IM_CASSA_INIZIALE
FROM
    PRT_AVANZO_DISAVANZO PRT_AVANZO_DISAVANZO,
    PRT_REND_FI_S_ART_CNR_XCDS PRT_REND_FI_S_ART_CNR_XCDS,
    ESERCIZIO ESERCIZIO
WHERE
    $P{cds} !=  $P{all} AND
    PRT_AVANZO_DISAVANZO.ESER(+)= PRT_REND_FI_S_ART_CNR_XCDS.ESER AND
    PRT_AVANZO_DISAVANZO.CDS(+) = PRT_REND_FI_S_ART_CNR_XCDS.CDS_OR AND
    PRT_REND_FI_S_ART_CNR_XCDS.CDS_OR = ESERCIZIO.CD_CDS AND
    PRT_REND_FI_S_ART_CNR_XCDS.ESER = ESERCIZIO.ESERCIZIO AND
    PRT_REND_FI_S_ART_CNR_XCDS.ESER = $P{esercizio} AND
    PRT_REND_FI_S_ART_CNR_XCDS.CDS_OR = $P{cds} AND
    PRT_AVANZO_DISAVANZO.TIPO (+)= 'D_D'
ORDER BY
    ESER ASC,
    PARTE ASC,
    TITOLO ASC,
    CATEGORIA ASC,
    SEZIONE ASC,
    CAPITOLO ASC,
    ARTICOLO ASC]]></query>
