<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="totali_x_natura" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR9" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNR9G" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR8G" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer("2007")]]></defaultValueExpression>
	</parameter>
	<parameter name="cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043"]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043.002"]]></defaultValueExpression>
	</parameter>
	<parameter name="cdr" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["043.002.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="etr_spe" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["E"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="commessa" class="java.lang.String" forPrompting="false"/>
	<query language="sql"><![CDATA[
		SELECT v.*, p.fl_nuovo_pdg FROM V_SIT_ANALITICA_GAE_COMPETENZA v, parametri_cnr p
WHERE  v.ESERCIZIO = $P{esercizio}
  AND  v.CDS = $P{cds}
  AND  v.UO = $P{uo}
  AND  v.CD_CENTRO_RESPONSABILITA = $P{cdr}
  AND  v.TI_GESTIONE = $P{etr_spe}
  AND  v.CD_COMMESSA = $P{commessa}
and v.esercizio = p.esercizio
ORDER BY  cd_natura asc
	]]></query>
	<field name="ESERCIZIO" class="java.lang.Integer"/>
	<field name="CDS" class="java.lang.String"/>
	<field name="UO" class="java.lang.String"/>
	<field name="CD_CENTRO_RESPONSABILITA" class="java.lang.String"/>
	<field name="DS_CDR" class="java.lang.String"/>
	<field name="CD_LINEA_ATTIVITA" class="java.lang.String"/>
	<field name="DENOMINAZIONE" class="java.lang.String"/>
	<field name="CD_NATURA" class="java.lang.String"/>
	<field name="CD_PROGETTO" class="java.lang.String"/>
	<field name="DS_PROGETTO" class="java.lang.String"/>
	<field name="CD_COMMESSA" class="java.lang.String"/>
	<field name="DS_COMMESSA" class="java.lang.String"/>
	<field name="CD_MODULO" class="java.lang.String"/>
	<field name="DS_MODULO" class="java.lang.String"/>
	<field name="TI_APPARTENENZA" class="java.lang.String"/>
	<field name="TI_GESTIONE" class="java.lang.String"/>
	<field name="CD_ELEMENTO_VOCE" class="java.lang.String"/>
	<field name="CD_VOCE" class="java.lang.String"/>
	<field name="DS_ELEMENTO_VOCE" class="java.lang.String"/>
	<field name="IM_STANZ_INIZIALE_A1" class="java.math.BigDecimal"/>
	<field name="VARIAZIONI_PIU" class="java.math.BigDecimal"/>
	<field name="VARIAZIONI_MENO" class="java.math.BigDecimal"/>
	<field name="ASSESTATO_COMP" class="java.math.BigDecimal"/>
	<field name="IM_OBBL_ACC_COMP" class="java.math.BigDecimal"/>
	<field name="DA_ASSUMERE" class="java.math.BigDecimal"/>
	<field name="IM_ASS_DOC_AMM_SPE" class="java.math.BigDecimal"/>
	<field name="IM_ASS_DOC_AMM_ETR" class="java.math.BigDecimal"/>
	<field name="IM_MANDATI_REVERSALI_PRO" class="java.math.BigDecimal"/>
	<field name="DA_PAGARE_INCASSARE" class="java.math.BigDecimal"/>
	<field name="FL_NUOVO_PDG" class="java.lang.String"/>
	<variable name="SUM_IM_STANZ_INIZIALE_A1_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{IM_STANZ_INIZIALE_A1}]]></expression>
	</variable>
	<variable name="SUM_VARIAZIONI_PIU_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{VARIAZIONI_PIU}]]></expression>
	</variable>
	<variable name="SUM_ASSESTATO_COMP_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{ASSESTATO_COMP}]]></expression>
	</variable>
	<variable name="SUM_IM_OBBL_ACC_COMP_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{IM_OBBL_ACC_COMP}]]></expression>
	</variable>
	<variable name="SUM_DA_ASSUMERE_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{DA_ASSUMERE}]]></expression>
	</variable>
	<variable name="SUM_IM_ASS_DOC_AMM_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[($P{etr_spe}.equals("E")?$F{IM_ASS_DOC_AMM_ETR}:$F{IM_ASS_DOC_AMM_SPE})]]></expression>
	</variable>
	<variable name="SUM_IM_MANDATI_REVERSALI_PRO_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{IM_MANDATI_REVERSALI_PRO}]]></expression>
	</variable>
	<variable name="SUM_DA_PAGARE_INCASSARE_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{DA_PAGARE_INCASSARE}]]></expression>
	</variable>
	<variable name="SUM_VARIAZIONI_MENO_NATURA" class="java.math.BigDecimal" resetType="Group" resetGroup="CD_NATURA" calculation="Sum">
		<expression><![CDATA[$F{VARIAZIONI_MENO}]]></expression>
	</variable>
	<group name="CD_NATURA">
		<expression><![CDATA[$F{CD_NATURA}]]></expression>
		<groupHeader>
			<band splitType="Stretch"/>
		</groupHeader>
		<groupFooter>
			<band height="22" splitType="Stretch">
				<element kind="textField" textAdjust="StretchHeight" key="textField-1" style="TNR9G" x="0" y="4" width="258" height="13" blankWhenNull="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[($F{FL_NUOVO_PDG}.equals("N")?"Totale Commessa ":"Totale Area Progettuale ")+$P{commessa}+" Natura "+$F{CD_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-2" style="TNR8G" x="261" y="4" width="59" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right" markup="styled">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_IM_STANZ_INIZIALE_A1_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-3" style="TNR8G" x="322" y="4" width="55" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_VARIAZIONI_PIU_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-4" style="TNR8G" x="379" y="4" width="53" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_VARIAZIONI_MENO_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-5" style="TNR8G" x="434" y="4" width="55" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_ASSESTATO_COMP_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-6" style="TNR8G" x="491" y="4" width="63" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_IM_OBBL_ACC_COMP_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-7" style="TNR8G" x="556" y="4" width="60" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_DA_ASSUMERE_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-8" style="TNR8G" x="618" y="4" width="60" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_IM_ASS_DOC_AMM_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-9" style="TNR8G" x="680" y="4" width="60" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_IM_MANDATI_REVERSALI_PRO_NATURA}]]></expression>
				</element>
				<element kind="textField" key="textField-10" style="TNR8G" x="742" y="4" width="60" height="13" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{SUM_DA_PAGARE_INCASSARE_NATURA}]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader splitType="Stretch"/>
