<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="rendiconto_fin_spese_cnr_dz" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR10" default="true" fontName="Times New Roman" pdfFontName="Times-Roman"/>
	<style name="TNR10BOLD" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRG8" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer("2011")]]></defaultValueExpression>
	</parameter>
	<parameter name="stampaArticolo" class="java.lang.Boolean" forPrompting="false">
		<description><![CDATA[Livello di stampa del report:
(FALSE) Capitolo
(TRUE) Articolo]]></description>
		<defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression>
	</parameter>
	<parameter name="cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[new String("*")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		Select 1 sub1, 1 sub2 from dual
union all
Select 2 sub1, 2 sub2 from dual
	]]></query>
	<field name="SUB1" class="java.math.BigDecimal"/>
	<field name="SUB2" class="java.math.BigDecimal"/>
	<group name="subreport1" startNewPage="true" resetPageNumber="true">
		<expression><![CDATA[$F{SUB1}]]></expression>
		<groupHeader>
			<band height="25" splitType="Stretch">
				<printWhenExpression><![CDATA[new Boolean($F{SUB1}.equals(new BigDecimal(1)))]]></printWhenExpression>
				<element kind="subreport" key="subreport-1" positionType="Float" x="0" y="0" width="820" height="25" usingCache="true">
					<parameter name="esercizio">
						<expression><![CDATA[$P{esercizio}]]></expression>
					</parameter>
					<parameter name="stampaArticolo">
						<expression><![CDATA[$P{stampaArticolo}]]></expression>
					</parameter>
					<parameter name="stampadataepagina">
						<expression><![CDATA[new String("N")]]></expression>
					</parameter>
					<parameter name="cds">
						<expression><![CDATA[$P{cds}]]></expression>
					</parameter>
					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					<expression><![CDATA[$P{DIR_SUBREPORT}+"rendiconto_fin_spese_cnr_comp.jasper"]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<group name="subreport2" startNewPage="true" resetPageNumber="true">
		<expression><![CDATA[$F{SUB2}]]></expression>
		<groupHeader>
			<band height="25" splitType="Stretch">
				<printWhenExpression><![CDATA[new Boolean($F{SUB2}.equals(new BigDecimal(2)))]]></printWhenExpression>
				<element kind="subreport" key="subreport-2" positionType="Float" x="0" y="0" width="820" height="25" printInFirstWholeBand="true" usingCache="true">
					<parameter name="esercizio">
						<expression><![CDATA[$P{esercizio}]]></expression>
					</parameter>
					<parameter name="stampaArticolo">
						<expression><![CDATA[$P{stampaArticolo}]]></expression>
					</parameter>
					<parameter name="stampadataepagina">
						<expression><![CDATA[new String("N")]]></expression>
					</parameter>
					<parameter name="cds">
						<expression><![CDATA[$P{cds}]]></expression>
					</parameter>
					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					<expression><![CDATA[$P{DIR_SUBREPORT}+"rendiconto_fin_spese_cnr_res.jasper"]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader splitType="Stretch"/>
	<columnHeader splitType="Stretch"/>
	<detail>
		<band splitType="Stretch"/>
	</detail>
	<columnFooter splitType="Stretch"/>
	<pageFooter height="25" splitType="Stretch">
		<element kind="textField" key="textField-1" style="TNRG8" x="37" y="6" width="161" height="13" evaluationTime="Report" pattern="dd/MM/yyyy HH.mm.ss" blankWhenNull="false">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA["Data di stampa "+ new SimpleDateFormat("dd/MM/yyyy HH.mm.ss").format(new java.util.Date())]]></expression>
		</element>
		<element kind="textField" key="textField-2" style="TNRG8" x="664" y="6" width="100" height="13" blankWhenNull="false" hTextAlign="Right">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA["Pagina " + $V{PAGE_NUMBER} + " di "]]></expression>
		</element>
		<element kind="textField" key="textField-3" style="TNRG8" x="764" y="6" width="55" height="13" evaluationTime="Report" blankWhenNull="false">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[" " + $V{PAGE_NUMBER} + ""]]></expression>
		</element>
	</pageFooter>
	<summary splitType="Stretch"/>
</jasperReport>
