	<query language="sql"><![CDATA[SELECT *
FROM v_var_stanz_res
WHERE ESERCIZIO = $P{Esercizio} 
AND PG_VARIAZIONE = $P{Variazione}
order by PG_VARIAZIONE ,CD_CDR_ASSEGNATARIO]]></query>
