	<parameter name="etr_spe" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["S"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT * FROM V_SIT_ANALITICA_GAE_COMPETENZA
WHERE ESERCIZIO = $P{esercizio}
   and CDS like decode($P{cds},CNRCTB020.GETCDCDSENTE ($P{esercizio}),'%',$P{cds})
   and cds not like CNRCTB020.GETCDCDSENTE($P{esercizio})
  AND UO LIKE DECODE($P{uo},'*','%',$P{uo})
  AND CD_CENTRO_RESPONSABILITA LIKE DECODE($P{cdr},'*','%',$P{cdr})
  AND TI_GESTIONE = $P{etr_spe}
ORDER BY CDS ASC,UO ASC,CD_CENTRO_RESPONSABILITA ASC,
         CD_ELEMENTO_VOCE ASC, CD_LINEA_ATTIVITA ASC
	]]></query>
