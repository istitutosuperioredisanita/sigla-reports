	</variable>
	<variable name="domicilio_comune" class="java.lang.String" resetType="None">
		<expression><![CDATA[$F{CAP_COMUNE_FISCALE}.trim()+ " " + $F{DS_COMUNE}.trim()]]></expression>
	</variable>
	<variable name="DARE" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[($F{SEZIONE}.equals("D")?$F{IM_MOVIMENTO}:new BigDecimal("0"))]]></expression>
	</variable>
	<variable name="AVERE" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[($F{SEZIONE}.equals("A")?$F{IM_MOVIMENTO}:new BigDecimal("0"))]]></expression>
	</variable>
