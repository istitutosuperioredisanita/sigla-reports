	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select (gest.IM_DEC_IST_EST+gest.IM_DEC_IST_INT) TOT_ENT_IST_A1,cd_classificazione,residuo_prev PREVISIONE_CASSA,CD_LIVELLO1,CD_LIVELLO2,CD_LIVELLO3,CD_LIVELLO4,CD_LIVELLO5,CD_LIVELLO6,nr_livello,
gest.ds_classificazione,gest.cd_missione,gest.cd_dipartimento,pdg_missione.ds_missione,pdg_programma.ds_programma,
decode(NR_livello,1,ds_Livello1S, null) Titolo,decode(NR_livello,2,ds_Livello2S, null) Tipologia,
 decode(NR_livello,3,ds_Livello3S, null) Categoria,decode(NR_livello,4,ds_Livello4S, null) Capitolo,
 decode(NR_livello,5,ds_Livello5S, null) Articolo,decode(NR_livello,6,ds_Livello6S, null) Voce
from gestionale_spese_2016 gest, parametri_livelli liv,pdg_missione,pdg_programma,dipartimento_peso
where gest.esercizio=2016 and
dipartimento_peso.esercizio(+)=2016 and
dipartimento_peso.cd_dipartimento(+)=  gest.cd_dipartimento and
((( (gest.IM_DEC_IST_EST+gest.IM_DEC_IST_INT)!=0 or residuo_prev!=0) and nr_livello=6) or nr_livello!= 6)
and pdg_missione.cd_missione(+)= gest.cd_missione
and pdg_programma.cd_programma(+)= gest.cd_dipartimento
and gest.esercizio = LIV.ESERCIZIO
--order by esercizio,cd_classificazione,nr_livello
order by gest.esercizio,
decode(cd_missione,' ',0,'RI',1,'SIG','2','DP',3,'FO',4,'PG',5), dipartimento_peso.peso,cd_classificazione,nr_livello,ds_classificazione
	]]></query>
