	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="aEs" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer("2007")]]></defaultValueExpression>
	</parameter>
	<parameter name="aCd_cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["999"]]></defaultValueExpression>
	</parameter>
	<parameter name="aPg_da" class="java.lang.Long" forPrompting="false">
		<defaultValueExpression><![CDATA[new Long("72")]]></defaultValueExpression>
	</parameter>
	<parameter name="pg_reversale" class="java.math.BigDecimal" forPrompting="false">
		<defaultValueExpression><![CDATA[new java.math.BigDecimal("1")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT *
FROM VPG_REVERSALE
Where CD_CDS = $P{aCd_cds}
And ESERCIZIO = $P{aEs}
And PG_REVERSALE = $P{pg_reversale}
ORDER BY ESERCIZIO, CD_CDS, PG_REVERSALE, Decode(TI_RECORD,'A',1,'D',2,'E',3,'C',4,5)
	]]></query>
