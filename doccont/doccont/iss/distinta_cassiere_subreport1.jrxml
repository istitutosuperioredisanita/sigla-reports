	</parameter>
	<parameter name="esercizio" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["2014"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["999"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_unita_organizzativa" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["000.407"]]></defaultValueExpression>
	</parameter>
	<parameter name="pg_distinta" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["161"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from VP_DISTINTA
where ESERCIZIO = to_number($P{esercizio})
and CD_CDS = $P{cd_cds}
and CD_UNITA_ORGANIZZATIVA = $P{cd_unita_organizzativa}
and ( PG_DISTINTA = to_number($P{pg_distinta}) or to_number($P{pg_distinta}) = -1 )
order by ESERCIZIO, CD_CDS, CD_UNITA_ORGANIZZATIVA, PG_DISTINTA, TIPO_DOC, STATO, PG_DOC
	]]></query>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="ESERCIZIO" class="java.math.BigDecimal"/>
	<field name="CD_CDS" class="java.lang.String"/>
	<field name="CD_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
	<field name="DS_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
	<field name="PG_DISTINTA" class="java.math.BigDecimal"/>
	<field name="PG_DISTINTA_DEF" class="java.math.BigDecimal"/>
	<field name="DT_INVIO" class="java.sql.Timestamp"/>
	<field name="IM_TOT_DOC" class="java.math.BigDecimal"/>
	<field name="IM_TOT_RIT" class="java.math.BigDecimal"/>
	<field name="PG_DOC" class="java.math.BigDecimal"/>
	<field name="TI_DOC" class="java.lang.String"/>
	<field name="DS_DOC" class="java.lang.String"/>
	<field name="DT_EMISSIONE" class="java.sql.Timestamp"/>
	<field name="DT_ANNULLAMENTO" class="java.sql.Timestamp"/>
	<field name="DT_RITRASMISSIONE" class="java.sql.Timestamp"/>
	<field name="STATO" class="java.lang.String"/>
	<field name="PG_DISTINTA_PREC" class="java.math.BigDecimal"/>
	<field name="IM_DOC" class="java.math.BigDecimal"/>
	<field name="IM_RITENUTE" class="java.math.BigDecimal"/>
	<field name="CODICE_FISCALE" class="java.lang.String"/>
	<field name="DS_ANAGRAFICA" class="java.lang.String"/>
	<field name="ABI" class="java.lang.String"/>
	<field name="CAB" class="java.lang.String"/>
	<field name="NUMERO_CONTO" class="java.lang.String"/>
	<field name="IBAN" class="java.lang.String"/>
	<field name="FL_FLUSSO" class="java.lang.String"/>
	<field name="UO_DOCCONT" class="java.lang.String"/>
	<variable name="RiportoTotNetto" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$V{RiportoTotDoc}.subtract( $V{RiportoTotRit} )]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="RiportoTotDoc" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_TOT_DOC} == null ? new BigDecimal(0) : $F{IM_TOT_DOC}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="RiportoTotRit" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_TOT_RIT} == null ? new BigDecimal(0) : $F{IM_TOT_RIT}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="tipoDoc" class="java.lang.String" resetType="Group" resetGroup="TipoDocB">
		<expression><![CDATA[$F{TIPO_DOC}.equals( "M" ) ? "MANDATI" : "REVERSALI"]]></expression>
	</variable>
	<variable name="DettLordo" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IM_DOC} == null ? new BigDecimal(0) : $F{IM_DOC}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="DettRitenute" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IM_RITENUTE} == null ? new BigDecimal(0) : $F{IM_RITENUTE}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="DettNetto" class="java.math.BigDecimal">
		<expression><![CDATA[$V{DettLordo}.subtract( $V{DettRitenute} )]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="AnnullatiLordo" class="java.math.BigDecimal" resetType="Group" resetGroup="Stato" calculation="Sum">
		<expression><![CDATA[$F{STATO}.trim().equals( "A" ) ? $V{DettLordo} : new BigDecimal(0)]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="AnnullatiRitenute" class="java.math.BigDecimal" resetType="Group" resetGroup="Stato" calculation="Sum">
		<expression><![CDATA[$F{STATO}.trim().equals( "A" ) ? $V{DettRitenute} : new BigDecimal(0)]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="AnnullatiNetto" class="java.math.BigDecimal" resetType="Group" resetGroup="Stato" calculation="Sum">
		<expression><![CDATA[$F{STATO}.trim().equals( "A" ) ? $V{DettNetto} : new BigDecimal(0)]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="TotLordo" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$V{IM_DOC_STATO}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="TotNetto" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$V{IM_NETTO_STATO}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="TotRitenute" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$V{IM_RITENUTE_STATO}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="descTotale" class="java.lang.String">
		<expression><![CDATA[$F{TIPO_DOC}.equals( "M" ) ? "TOTALE PAGATO" : "TOTALE INCASSATO"]]></expression>
	</variable>
	<variable name="AnnRitrasmTotLordo" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$F{STATO}.equals("A") && $F{DT_RITRASMISSIONE} != null ?
$V{IM_DOC_STATO}:new BigDecimal(0)]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="AnnRitrasmTotRitenute" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$F{STATO}.equals("A") ? $F{DT_RITRASMISSIONE} != null ? $V{DettRitenute} : new BigDecimal(0) : new BigDecimal(0)]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="AnnRitrasmTotNetto" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$F{STATO}.equals("A") ? $F{DT_RITRASMISSIONE} != null ? $V{DettNetto} : new BigDecimal(0) : new BigDecimal(0)]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="aRiportareLordo" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$V{RiportoTotDoc}.add(
$V{TotLordo}).subtract($V{AnnRitrasmTotLordo})]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="aRiportareRitenute" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$V{RiportoTotRit}.add( $V{TotRitenute} ).subtract($V{AnnRitrasmTotRitenute})]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="aRiportareNetto" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$V{RiportoTotNetto}.add( $V{TotNetto} ).subtract($V{AnnRitrasmTotNetto})]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="banca" class="java.lang.String" resetType="Group" resetGroup="UnitaOrganizzativa">
		<expression><![CDATA[$F{ABI} + "  " + $F{CAB} + "  " + $F{NUMERO_CONTO}+($F{IBAN}!=null?"Iban "+$F{IBAN}:" ")]]></expression>
	</variable>
	<variable name="IM_DOC_STATO" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_DOC} == null ? new BigDecimal(0) :
$F{STATO}.trim().equals("A")?$F{IM_DOC}.negate():$F{IM_DOC}]]></expression>
	</variable>
	<variable name="IM_DOC_STATO_NON_ANN" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_DOC} == null ? new BigDecimal(0) :
$F{STATO}.trim().equals("A")?new BigDecimal(0):$F{IM_DOC}]]></expression>
	</variable>
	<variable name="TotLordo_a_riportare" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$V{IM_DOC_STATO_NON_ANN}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="IM_RITENUTA_STATO_NON_ANN" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_DOC} == null ? new BigDecimal(0) :
$F{STATO}.trim().equals("A")?new BigDecimal(0):$F{IM_RITENUTE}]]></expression>
	</variable>
	<variable name="TotRitenute_a_riportare" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$V{IM_RITENUTA_STATO_NON_ANN}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="IM_RITENUTE_STATO" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_DOC} == null ? new BigDecimal(0) :
$F{STATO}.trim().equals("A")?$F{IM_RITENUTE}.negate():$F{IM_RITENUTE}]]></expression>
	</variable>
	<variable name="TotNetto_a_riportare" class="java.math.BigDecimal" resetType="Group" resetGroup="TipoDoc" calculation="Sum">
		<expression><![CDATA[$V{IM_NETTO_STATO_NON_ANN}]]></expression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="IM_NETTO_STATO_NON_ANN" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_DOC} == null ? new BigDecimal(0) :
$F{STATO}.trim().equals("A")?new BigDecimal(0):$F{IM_DOC}.subtract($F{IM_RITENUTE})]]></expression>
	</variable>
	<variable name="IM_NETTO_STATO" class="java.math.BigDecimal" resetType="None">
		<expression><![CDATA[$F{IM_DOC} == null ? new BigDecimal(0) :
$F{STATO}.trim().equals("A")?($F{IM_DOC}.subtract($F{IM_RITENUTE})).negate():($F{IM_DOC}.subtract($F{IM_RITENUTE}))]]></expression>
	</variable>
