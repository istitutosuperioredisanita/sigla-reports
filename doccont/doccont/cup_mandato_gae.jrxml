	<query language="sql"><![CDATA[
		SELECT * FROM prt_cup_mandato_gae
WHERE
   cd_CDS LIKE DECODE($P{cds},'*','%',$P{cds})
  AND cd_Cup like DECODE($P{cup},'*','%',$P{cup})
order by esercizio,cd_cds,uo,pg_mandato,pg_obbligazione
	]]></query>
