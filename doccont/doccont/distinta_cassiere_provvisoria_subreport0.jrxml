		<defaultValueExpression><![CDATA["2014"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["000"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_unita_organizzativa" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["000.407"]]></defaultValueExpression>
	</parameter>
	<parameter name="pg_distinta" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select distinct vp.* from vp_distinta_prov vp,(
select dd.* from (
select a.* from (
select m.esercizio, m.cd_cds, m.pg_mandato
from distinta_cassiere_det d, mandato m
where d.esercizio = m.esercizio
and d.cd_cds = m.cd_cds
and d.pg_mandato = m.pg_mandato
and ti_mandato ='A'
and d.esercizio = $P{esercizio}
and d.cd_cds = $P{cd_cds}
and d.cd_unita_organizzativa = $P{cd_unita_organizzativa}
and pg_distinta = $P{pg_distinta}) dm, ass_mandato_reversale a
where dm.esercizio = a.esercizio_mandato
and dm.cd_cds = a.cd_cds_mandato
and dm.pg_mandato = a.pg_mandato) dma, distinta_cassiere_det dd
where dma.esercizio_reversale = dd.esercizio
and dma.cd_cds_reversale = dd.cd_cds
and dma.pg_reversale = dd.pg_reversale) ddd
where ddd.esercizio = vp.esercizio
and ddd.pg_distinta = vp.pg_distinta
and ddd.cd_cds = vp.cd_cds
and ddd.cd_unita_organizzativa = vp.cd_unita_organizzativa
	]]></query>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="ESERCIZIO" class="java.math.BigDecimal"/>
	<field name="CD_CDS" class="java.lang.String"/>
	<field name="CD_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
	<field name="DS_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
