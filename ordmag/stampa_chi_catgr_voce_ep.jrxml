				<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="150" height="30" uuid="bbfa151b-1f7a-4786-acab-9cb355d00799" textAdjust="StretchHeight" hTextAlign="Center" vTextAlign="Middle">
