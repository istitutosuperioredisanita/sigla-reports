	<variable name="ImportoTotOrdine" resetType="Group" incrementType="Group" calculation="Sum" resetGroup="GruppoOrdine" incrementGroup="GruppoRiga" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IM_TOTALE_RIGA}]]></expression>
	</variable>
	<variable name="ImpTotOrdineNetto" incrementType="Group" calculation="Sum" incrementGroup="GruppoRiga" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IM_IMPONIBILE}]]></expression>
	</variable>
	<variable name="TotaleIva" incrementType="Group" calculation="Sum" incrementGroup="GruppoRiga" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IM_IVA_DIVISA}]]></expression>
	</variable>
	<variable name="Impegno" resetType="Group" resetGroup="GruppoRiga" class="java.lang.String">
		<expression><![CDATA[$F{PG_OBBLIGAZIONE} != null  ? "-"+ $F{ESERCIZIO_OBB}+"/"+$F{PG_OBBLIGAZIONE}+"/"+$F{PG_OBBLIGAZIONE_SCADENZARIO}+"	EUR	"+$F{IM_SCADENZA} : null]]></expression>
	</variable>
	<variable name="Impegni" resetType="Group" incrementType="Group" resetGroup="GruppoOrdine" incrementGroup="GruppoRiga" class="java.lang.String">
		<expression><![CDATA[$V{Impegni}!=null ? ($V{Impegni}+"<br>"+$V{Impegno}) :$V{Impegno}]]></expression>
	</variable>
	<variable name="ImpTotConsegna" resetType="Group" resetGroup="GruppoConsegna" class="java.math.BigDecimal">
		<expression><![CDATA[new java.math.BigDecimal ( $F{PREZZO_UNITARIO}.doubleValue()*$F{QUANTITA}.doubleValue())]]></expression>
	</variable>
	<variable name="ImportoConsegneOriginale" incrementType="Group" calculation="Sum" incrementGroup="GruppoConsegna" class="java.math.BigDecimal">
		<expression><![CDATA[new java.math.BigDecimal (  $F{PREZZO_UNITARIO}.doubleValue()*$F{QUANTITA}.doubleValue() ).setScale(2, RoundingMode.HALF_UP)]]></expression>
	</variable>
	<group name="GruppoOrdine">
		<expression><![CDATA[($F{CD_CDS}+$F{CD_UNITA_OPER_CONS}+$F{ESERCIZIO_CONS}+$F{CD_NUMERATORE_CONS}+$F{NUMERO_CONS})]]></expression>
