<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ModuloRimborsoSpeseCnrAss" pageWidth="595" pageHeight="842" columnWidth="465" leftMargin="65" rightMargin="65" topMargin="60" bottomMargin="60" scriptletClass="it.cnr.jasperreports.scriptlet.sigla.Blt_visite_stampe_candidaturaScriptlet" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0000000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<style name="TNR8" default="false" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG8" default="false" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC8" default="false" fontName="Times New Roman" fontSize="8" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR9" default="false" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" default="false" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC9" default="false" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" default="false" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" default="false" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" default="false" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" default="false" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" default="false" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" default="false" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" default="false" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" default="false" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" default="false" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" default="false" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" default="false" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" default="false" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" default="false" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" default="false" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" default="false" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long"/>
	<parameter name="flag_to_update" class="java.lang.String"/>
	<query language="sql"><![CDATA[
		select
a.dt_ini_visita, a.dt_fin_visita, a.num_prot_autoriz_partenza, a.dt_prot_autoriz_partenza, s.dt_nascita, s.codice_fiscale, l.ds_comune comune_nascita, e.anno_fin, e.anno_ini,
s.ti_sesso sesso_autorizzato,
b.denominazione_sede ds_terzo_autorizzato,
c.ds_cdr,
(select h.via_sede from terzo h where c.cd_unita_organizzativa = h.cd_unita_organizzativa) indirizzo_istituto,
(select h.denominazione_sede from terzo h where g.cd_respons_ita = h.cd_terzo) ds_responsabile_ita,
(select h.denominazione_sede from terzo h where g.cd_respons_str = h.cd_terzo) ds_responsabile_str,
(select h.cap_comune_sede from terzo h where c.cd_unita_organizzativa = h.cd_unita_organizzativa) cap_istituto,
(select l.ds_comune from terzo h, comune l where c.cd_unita_organizzativa = h.cd_unita_organizzativa and h.pg_comune_sede = l.pg_comune) comune_istituto, a.fl_pagamento_con_bonifico,
e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str, e.nome_ente_str,
g.ds_progetto_ita, e.importo_diaria_ita, e.fl_spese_visto, e.cd_divisa_ita,
e.fl_rimborso_treno, e.importo_mensile_ita, h.fl_assimilato_dip
from blt_visite a, blt_autorizzati h, terzo b, cdr c, blt_accordi e, nazione f, blt_progetti g, anagrafico s, comune l
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = h.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and h.cd_cdr_terzo = c.cd_centro_responsabilita
and h.cd_accordo = e.cd_accordo
and e.pg_nazione_str = f.pg_nazione
and a.cd_accordo = g.cd_accordo
and a.cd_progetto = g.cd_progetto
and s.cd_anag = b.cd_anag
and s.pg_comune_nascita = l.pg_comune
	]]></query>
	<field name="DT_INI_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA" class="java.sql.Timestamp"/>
	<field name="NUM_PROT_AUTORIZ_PARTENZA" class="java.math.BigDecimal"/>
	<field name="DT_PROT_AUTORIZ_PARTENZA" class="java.sql.Timestamp"/>
	<field name="DT_NASCITA" class="java.sql.Timestamp"/>
	<field name="CODICE_FISCALE" class="java.lang.String"/>
	<field name="COMUNE_NASCITA" class="java.lang.String"/>
	<field name="ANNO_FIN" class="java.math.BigDecimal"/>
	<field name="ANNO_INI" class="java.math.BigDecimal"/>
	<field name="SESSO_AUTORIZZATO" class="java.lang.String"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="DS_CDR" class="java.lang.String"/>
	<field name="INDIRIZZO_ISTITUTO" class="java.lang.String"/>
	<field name="DS_RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="DS_RESPONSABILE_STR" class="java.lang.String"/>
	<field name="CAP_ISTITUTO" class="java.lang.String"/>
	<field name="COMUNE_ISTITUTO" class="java.lang.String"/>
	<field name="FL_PAGAMENTO_CON_BONIFICO" class="java.lang.String"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<field name="NOME_ENTE_STR" class="java.lang.String"/>
	<field name="DS_PROGETTO_ITA" class="java.lang.String"/>
	<field name="IMPORTO_DIARIA_ITA" class="java.math.BigDecimal"/>
	<field name="FL_SPESE_VISTO" class="java.lang.String"/>
	<field name="CD_DIVISA_ITA" class="java.lang.String"/>
	<field name="FL_RIMBORSO_TRENO" class="java.lang.String"/>
	<field name="IMPORTO_MENSILE_ITA" class="java.math.BigDecimal"/>
	<field name="FL_ASSIMILATO_DIP" class="java.lang.String"/>
	<variable name="numGiorni" class="java.lang.Long">
		<expression><![CDATA[$P{REPORT_SCRIPTLET}.getGiorniVisita($F{DT_INI_VISITA}, $F{DT_FIN_VISITA})]]></expression>
	</variable>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<detail>
		<band height="70" splitType="Stretch">
			<element kind="staticText" key="staticText-1" style="TNR11" x="259" y="0" width="23" height="15" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Al]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNR11" x="290" y="0" width="175" height="59" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Consiglio Nazionale delle Ricerche
Ufficio Accordi e Relazioni Internazionali
Piazzale Aldo Moro, 7
00185 Roma]]></text>
			</element>
		</band>
		<band height="45">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="55" y="25" width="410" height="12" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Accordo di cooperazione scientifica tra CNR e "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENTE_STR}+" - "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennio":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennio":"Anni"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+". Progetto comune di ricerca "+$F{DS_RESPONSABILE_ITA}.toUpperCase()+" / "+$F{DS_RESPONSABILE_STR}.toUpperCase()+"."]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNR11" x="0" y="25" width="44" height="20" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Oggetto:]]></text>
			</element>
		</band>
		<band height="35">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="55" y="0" width="410" height="15" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Attestato di soggiorno."]]></expression>
			</element>
		</band>
		<band height="32">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="12" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Si attesta che "+($F{SESSO_AUTORIZZATO}.equals("M" )?"il Dott.":"la Dott.ssa")+" "+$F{DS_TERZO_AUTORIZZATO}.toUpperCase()+", ospite in Italia nel quadro dell’Accordo CNR/"+$F{ACRONIMO_ENTE_STR}+", ha svolto un soggiorno di ricerca presso questo Istituto dal .......................... al ............................"]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="290" y="0" width="175" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["IL DIRETTORE"]]></expression>
			</element>
		</band>
		<band height="140">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="175" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Data"]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="290" y="0" width="175" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Timbro"]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="23" width="175" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
				<expression><![CDATA["............................................."]]></expression>
			</element>
		</band>
		<band height="100">
			<element kind="rectangle" x="0" y="0" width="465" height="78"/>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="20" y="10" width="445" height="12" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="10" italic="true">
				<expression><![CDATA["Compilare in presenza di restituzione al CNR di somma non dovuta da parte dello studioso straniero.\n\n          Dati del bonifico:\n\n               Numero ....................               Data .........................               Importo ...................."]]></expression>
			</element>
		</band>
	</detail>
	<summary splitType="Stretch"/>
</jasperReport>
