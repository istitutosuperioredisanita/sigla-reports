<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="TrasmissioneCandidatura" pageWidth="595" pageHeight="842" columnWidth="465" leftMargin="65" rightMargin="65" topMargin="30" bottomMargin="20" scriptletClass="it.cnr.jasperreports.scriptlet.sigla.Blt_visite_stampe_candidaturaScriptlet" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.1000000000000005"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR8" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG8" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC8" fontName="Times New Roman" fontSize="8" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR9" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC9" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long" forPrompting="false"/>
	<parameter name="flag_to_update" class="java.lang.String" forPrompting="false"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select
a.dt_ini_visita, a.dt_fin_visita, e.anno_ini, e.anno_fin, e.fax_respons_str,
b.denominazione_sede ds_terzo_autorizzato, g.cd_respons_ita, g.cd_respons_str,
e.nome_ente_str, e.nome_respons_str, e.cognome_respons_str,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_ita) responsabile_ita,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_str) responsabile_str,
e.ds_nazione_eng, e.ds_aggettivo_nazional,
e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str, g.ds_progetto_ita, g.ds_progetto_eng, e.email_respons_ita, e.telef_respons_ita, e.fax_respons_ita, a.im_rimb_previsto
from blt_visite a, blt_autorizzati h, terzo b, blt_accordi e, nazione f, blt_progetti g
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = e.cd_accordo
and a.cd_accordo = h.cd_accordo
and a.cd_accordo = g.cd_accordo
and h.cd_accordo = e.cd_accordo
and h.cd_accordo = g.cd_accordo
and g.cd_accordo = e.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_progetto = g.cd_progetto
and g.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and e.pg_nazione_str = f.pg_nazione
	]]></query>
	<field name="DT_INI_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA" class="java.sql.Timestamp"/>
	<field name="ANNO_INI" class="java.math.BigDecimal"/>
	<field name="ANNO_FIN" class="java.math.BigDecimal"/>
	<field name="FAX_RESPONS_STR" class="java.lang.String"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="CD_RESPONS_ITA" class="java.math.BigDecimal"/>
	<field name="CD_RESPONS_STR" class="java.math.BigDecimal"/>
	<field name="NOME_ENTE_STR" class="java.lang.String"/>
	<field name="NOME_RESPONS_STR" class="java.lang.String"/>
	<field name="COGNOME_RESPONS_STR" class="java.lang.String"/>
	<field name="RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="RESPONSABILE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENG" class="java.lang.String"/>
	<field name="DS_AGGETTIVO_NAZIONAL" class="java.lang.String"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<field name="DS_PROGETTO_ITA" class="java.lang.String"/>
	<field name="DS_PROGETTO_ENG" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_ITA" class="java.lang.String"/>
	<field name="TELEF_RESPONS_ITA" class="java.lang.String"/>
	<field name="FAX_RESPONS_ITA" class="java.lang.String"/>
	<field name="IM_RIMB_PREVISTO" class="java.math.BigDecimal"/>
	<variable name="numGiorni" class="java.lang.Long">
		<expression><![CDATA[$P{REPORT_SCRIPTLET}.getGiorniVisita($F{DT_INI_VISITA}, $F{DT_FIN_VISITA})]]></expression>
	</variable>
	<background splitType="Prevent"/>
	<pageHeader height="60" splitType="Prevent">
		<element kind="staticText" key="staticText-23" style="TNR11" x="27" y="27" width="172" height="14" forecolor="#244061" hTextAlign="Center" fontName="Times New Roman" fontSize="8" italic="true">
			<text><![CDATA[International Relations and Agreements Office]]></text>
		</element>
		<element kind="image" key="image-1" x="0" y="0" width="199" height="28" scaleImage="FillFrame" onErrorType="Icon">
			<expression><![CDATA[$P{DIR_IMAGE}+"Logo CNR-2010-ENG-low.png"]]></expression>
		</element>
	</pageHeader>
	<detail>
		<band height="18" splitType="Prevent">
			<element kind="staticText" key="staticText-1" style="TNR11" x="262" y="0" width="31" height="14" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[To]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="168" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+")"]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="168" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Office of International Affairs"]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="168" height="14" pattern="" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{DS_NAZIONE_ENG}+""]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="164" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Attn. "+$F{COGNOME_RESPONS_STR}+" "+$F{NOME_RESPONS_STR}+""]]></expression>
			</element>
		</band>
		<band height="70" splitType="Prevent">
			<element kind="staticText" key="staticText-1" style="TNR11" x="0" y="40" width="51" height="14" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Ref.:]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="40" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Agreement on scientific cooperation between CNR and "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENG}+" - "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennium":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennium":"Years"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+". Joint research project "+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+"."]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="298" y="0" width="167" height="14" pattern="" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Fax "+$F{FAX_RESPONS_STR}+""]]></expression>
			</element>
		</band>
		<band height="35" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="0" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Acceptance of "+$F{DS_AGGETTIVO_NAZIONAL}+" nominee"]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="staticText" key="staticText-1" style="TNR11" x="0" y="0" width="56" height="14" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Dear Sir,]]></text>
			</element>
		</band>
		<band height="30" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Please be informed that the CNR accepts the nominee of the following "+$F{DS_AGGETTIVO_NAZIONAL}+" scientist wishing to carry out a research stay in Italy:"]]></expression>
			</element>
		</band>
		<band height="30" splitType="Prevent">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="0" width="122" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[NAME AND SURNAME]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="182" y="0" width="98" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[STARTING DATE
]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="280" y="0" width="78" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[DUE AMOUNT]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="358" y="0" width="107" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[JOINT PROJECT]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="122" y="0" width="60" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[DURATION]]></text>
			</element>
		</band>
		<band height="30" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="122" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{DS_TERZO_AUTORIZZATO}+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="122" y="0" width="60" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$V{numGiorni}+" days"]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="182" y="0" width="98" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA})+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="358" y="0" width="107" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="280" y="0" width="78" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Euro "+new java.text.DecimalFormat("#,##0.00").format($F{IM_RIMB_PREVISTO})+""]]></expression>
			</element>
		</band>
		<band height="40" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Best regards,"]]></expression>
			</element>
		</band>
		<band height="59" splitType="Prevent">
			<element kind="staticText" key="staticText-24" style="TNR11" x="286" y="0" width="179" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Virginia Coda Nunziante]]></text>
			</element>
			<element kind="staticText" key="staticText-23" style="TNR11" x="286" y="14" width="179" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Head,]]></text>
			</element>
			<element kind="staticText" key="staticText-23" style="TNR11" x="286" y="28" width="179" height="31" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[International Relations and Agreements Office]]></text>
			</element>
		</band>
	</detail>
	<pageFooter height="28" splitType="Prevent">
		<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="12" width="465" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="8">
			<expression><![CDATA["Piazzale Aldo Moro, 7 - 00185 Roma - Tel. "+$F{TELEF_RESPONS_ITA}+" - Fax "+$F{FAX_RESPONS_ITA}+" - email "+$F{EMAIL_RESPONS_ITA}+""]]></expression>
		</element>
		<element kind="line" x="0" y="5" width="465" height="1">
			<pen lineWidth="0.25"/>
		</element>
	</pageFooter>
	<summary splitType="Prevent"/>
</jasperReport>
