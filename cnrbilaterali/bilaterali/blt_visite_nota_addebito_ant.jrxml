				<text><![CDATA[Date, ..............................................]]></text>
			</element>
		</band>
		<band height="28">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="-1" y="0" width="466" height="15" blankWhenNull="false" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" italic="true">
				<expression><![CDATA["Subject: Advance amount received for a research stay of "+$V{numGiorni}+" days in Italy, starting from "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA})+", which took place within the framework of the Agreement of Scientific Cooperation between CNR and "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENG}+" – "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennium":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennium":"Years"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+", as quoted in the Contract, Ref No. AMMCNT – CNR .............................. dated ...................................."]]></expression>
			</element>
		</band>
		<band height="36">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="15" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" italic="true">
				<expression><![CDATA["Oggetto: Acconto compenso per un soggiorno di ricerca di "+$V{numGiorni}+" giorni, dal "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA})+", effettuato nell’ambito dell’Accordo di cooperazione scientifica CNR/"+$F{ACRONIMO_ENTE_STR}+" ("+$F{DS_NAZIONE_ENTE_STR}+") – "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennio":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennio":"Anni"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+", di cui al Contratto, prot. AMMCNT – CNR n. ............................... del ......................................"]]></expression>
			</element>
		</band>
		<band height="14">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="0" width="178" height="14" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
