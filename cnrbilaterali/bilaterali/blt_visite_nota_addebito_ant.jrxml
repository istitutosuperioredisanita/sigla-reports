<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ModuloRimborsoSpeseCnrAss" pageWidth="595" pageHeight="842" columnWidth="465" leftMargin="65" rightMargin="65" topMargin="30" bottomMargin="20" scriptletClass="it.cnr.jasperreports.scriptlet.sigla.Blt_visite_stampe_candidaturaScriptlet" language="java">
