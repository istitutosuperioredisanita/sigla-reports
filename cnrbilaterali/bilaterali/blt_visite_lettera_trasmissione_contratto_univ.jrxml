<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Lettera_trasm_contratto_univ" pageWidth="595" pageHeight="842" columnWidth="465" leftMargin="65" rightMargin="65" topMargin="30" bottomMargin="20" scriptletClass="it.cnr.jasperreports.scriptlet.sigla.Blt_visite_stampe_candidaturaScriptlet" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.100000000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<style name="TNR8" default="false" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG8" default="false" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC8" default="false" fontName="Times New Roman" fontSize="8" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR9" default="false" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" default="false" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC9" default="false" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" default="false" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" default="false" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" default="false" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" default="false" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" default="false" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" default="false" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" default="false" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" default="false" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" default="false" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" default="false" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" default="false" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" default="false" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" default="false" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" default="false" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" default="false" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long"/>
	<parameter name="flag_to_update" class="java.lang.String"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select
a.dt_ini_visita, a.dt_fin_visita, e.telef_respons_ita, e.fax_respons_ita, e.email_respons_ita, e.nome_respons_str, e.cognome_respons_str, b.denominazione_sede ds_terzo_autorizzato, e.telef_respons_str, e.fax_respons_str, e.email_respons_str, c.ds_cdr, e.fl_atti_amministrativi,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_ita) responsabile_ita,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_str) responsabile_str,
(select l.ds_comune from comune l where  h.pg_comune_ente_di_appartenenza =l.pg_comune) comune_ente_di_appartenenza,
s.ti_sesso sesso_autorizzato, h.cap_ente_di_appartenenza,
e.fl_lettera_invito, e.email_trasmissione_passaporto, e.fl_viaggi_interni,
e.anno_ini, e.anno_fin, h.ente_di_appartenenza, h.indirizzo_ente_di_appartenenza, e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str, e.nome_ente_str, e.indirizzo_ente_str, e.citta_ente_str, g.ds_progetto_ita, e.importo_diaria_ita, e.fl_spese_visto, e.cd_divisa_ita,
e.fl_rimborso_treno, e.importo_mensile_ita, h.fl_assimilato_dip, e.ds_nazione_eng
from blt_visite a, blt_autorizzati h, terzo b, cdr c, blt_accordi e, nazione f, blt_progetti g, anagrafico s
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = h.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and h.cd_cdr_terzo = c.cd_centro_responsabilita
and h.cd_accordo = e.cd_accordo
and e.pg_nazione_str = f.pg_nazione
and a.cd_accordo = g.cd_accordo
and a.cd_progetto = g.cd_progetto
and s.cd_anag = b.cd_anag
	]]></query>
	<field name="DT_INI_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA" class="java.sql.Timestamp"/>
	<field name="TELEF_RESPONS_ITA" class="java.lang.String"/>
	<field name="FAX_RESPONS_ITA" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_ITA" class="java.lang.String"/>
	<field name="NOME_RESPONS_STR" class="java.lang.String"/>
	<field name="COGNOME_RESPONS_STR" class="java.lang.String"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="TELEF_RESPONS_STR" class="java.lang.String"/>
	<field name="FAX_RESPONS_STR" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_STR" class="java.lang.String"/>
	<field name="DS_CDR" class="java.lang.String"/>
	<field name="FL_ATTI_AMMINISTRATIVI" class="java.lang.String"/>
	<field name="RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="RESPONSABILE_STR" class="java.lang.String"/>
	<field name="COMUNE_ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="SESSO_AUTORIZZATO" class="java.lang.String"/>
	<field name="CAP_ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="FL_LETTERA_INVITO" class="java.lang.String"/>
	<field name="EMAIL_TRASMISSIONE_PASSAPORTO" class="java.lang.String"/>
	<field name="FL_VIAGGI_INTERNI" class="java.lang.String"/>
	<field name="ANNO_INI" class="java.math.BigDecimal"/>
	<field name="ANNO_FIN" class="java.math.BigDecimal"/>
	<field name="ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="INDIRIZZO_ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<field name="NOME_ENTE_STR" class="java.lang.String"/>
	<field name="INDIRIZZO_ENTE_STR" class="java.lang.String"/>
	<field name="CITTA_ENTE_STR" class="java.lang.String"/>
	<field name="DS_PROGETTO_ITA" class="java.lang.String"/>
	<field name="IMPORTO_DIARIA_ITA" class="java.math.BigDecimal"/>
	<field name="FL_SPESE_VISTO" class="java.lang.String"/>
	<field name="CD_DIVISA_ITA" class="java.lang.String"/>
	<field name="FL_RIMBORSO_TRENO" class="java.lang.String"/>
	<field name="IMPORTO_MENSILE_ITA" class="java.math.BigDecimal"/>
	<field name="FL_ASSIMILATO_DIP" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENG" class="java.lang.String"/>
	<variable name="numGiorni" class="java.lang.Long">
		<expression><![CDATA[$P{REPORT_SCRIPTLET}.getGiorniVisita($F{DT_INI_VISITA}, $F{DT_FIN_VISITA})]]></expression>
	</variable>
	<background splitType="Prevent"/>
	<pageHeader height="60" splitType="Prevent">
		<element kind="staticText" key="staticText-23" style="TNR11" x="25" y="28" width="174" height="14" forecolor="#244061" hTextAlign="Center" fontName="Times New Roman" fontSize="8" italic="true">
			<text><![CDATA[Ufficio Accordi e Relazioni Internazionali]]></text>
		</element>
		<element kind="image" key="image-1" x="0" y="0" width="199" height="28" scaleImage="FillFrame" onErrorType="Icon">
			<expression><![CDATA[$P{DIR_IMAGE}+"Logo CNR-2010-ITA-low.png"]]></expression>
		</element>
	</pageHeader>
	<detail>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[$F{DS_TERZO_AUTORIZZATO}.toUpperCase()]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="255" y="0" width="44" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[($F{SESSO_AUTORIZZATO}.equals("M")?"Al Dott.":"Alla Dott.ssa")]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[$F{ENTE_DI_APPARTENENZA}]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[$F{INDIRIZZO_ENTE_DI_APPARTENENZA}]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{CAP_ENTE_DI_APPARTENENZA}+" - "+$F{COMUNE_ENTE_DI_APPARTENENZA}+""]]></expression>
			</element>
		</band>
		<band height="45" splitType="Prevent">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="25" width="51" height="14" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Oggetto:]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="25" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["Accordo di cooperazione scientifica tra CNR e "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENTE_STR}+" - "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennio":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennio":"Anni"))+" "+$F{ANNO_INI}+"-"+$F{ANNO_FIN}+". Progetto comune di ricerca "+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+"."]]></expression>
			</element>
		</band>
		<band height="35" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="0" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Trasmissione, per la sottoscrizione, del contratto di prestazione d'opera in regime di lavoro autonomo occasionale."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Si comunica che e' pervenuta al CNR l'accettazione da parte dell'Ente straniero (in allegato) del soggiorno di ricerca richiesto dalla S.V. della durata di "+$V{numGiorni}+" giorni, a decorrere dal "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA})+" nell'ambito del Progetto comune di ricerca '"+$F{DS_PROGETTO_ITA}+"' (Reponsabile italiano "+($F{SESSO_AUTORIZZATO}.equals("M")?"Dott.":"Dott.ssa")+" "+$F{RESPONSABILE_ITA}.toUpperCase()+", Responsabile straniero "+($F{SESSO_AUTORIZZATO}.equals("M")?"Dott.":"Dott.ssa")+" "+$F{RESPONSABILE_STR}.toUpperCase()+")."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Si trasmette il contratto (all. 2) relativo al soggiorno sopra citato, che dovrà essere sottoscritto e restituito in originale all'Ufficio scrivente (anticipandolo via fax o per e-mail) per il perfezionamento dello stesso (cioe' la sottoscrizione del contratto anche da parte del CNR). Si prega di voler verificare, in particolare, i dati personali e le date del soggiorno inseriti nel contratto e di segnalare eventuali inesattezze prima della sottoscrizione."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["La S.V. sara' autorizzata per iscritto dall'Ufficio scrivente a dare inizio al soggiorno, con restituzione di una copia del contratto perfezionato."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ATTI_AMMINISTRATIVI}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Al fine di poter far predisporre in tempo utile, all'Ente ospitante, tutti gli atti amministrativi necessari, si invita la S.V. a comunicare con urgenza i dati relativi al soggiorno in "+$F{DS_NAZIONE_ENTE_STR}+" "+($F{EMAIL_TRASMISSIONE_PASSAPORTO}!= null?"e il proprio numero di passaporto a:":"a")+""]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ATTI_AMMINISTRATIVI}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="40" y="0" width="425" height="14" printWhenDetailOverflows="true" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Dr. "+$F{NOME_RESPONS_STR}+" "+$F{COGNOME_RESPONS_STR}+""]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ATTI_AMMINISTRATIVI}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="40" y="1" width="425" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{ACRONIMO_ENTE_STR}+" - "+$F{NOME_ENTE_STR}+" - Office of International Relations"]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="40" y="1" width="425" height="14" printWhenDetailOverflows="true" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[$F{INDIRIZZO_ENTE_STR}]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ATTI_AMMINISTRATIVI}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="40" y="0" width="425" height="14" printWhenDetailOverflows="true" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{CITTA_ENTE_STR}+" ("+$F{DS_NAZIONE_ENG}+")"]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ATTI_AMMINISTRATIVI}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="40" y="0" width="425" height="14" printWhenDetailOverflows="true" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Tel. "+$F{TELEF_RESPONS_STR}+" - Fax "+$F{FAX_RESPONS_STR}+" - email: "+$F{EMAIL_RESPONS_STR}+""]]></expression>
			</element>
		</band>
		<band height="20">
			<printWhenExpression><![CDATA[$F{FL_LETTERA_INVITO}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Alla presente si allega, inoltre, la lettera di invito di "+$F{ACRONIMO_ENTE_STR}+" necessaria per richidere il visto. Secondo le disposizioni vigenti, al momento della richiesta del visto, vanno forniti anche i dati riguardanti i luoghi di lavoro (in Italia e quello relativo al soggiorno in "+$F{DS_NAZIONE_ENTE_STR}+") e la qualifica ricoperta."]]></expression>
			</element>
		</band>
		<band height="15">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Si ricorda che il CNR non rimborsera' alcuna spesa sostenuta dalla S.V.:"]]></expression>
			</element>
		</band>
		<band height="15">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="55" y="0" width="410" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["in presenza di un contratto non sottoscritto da entrambe le parti;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="40" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="40">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="40" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="55" y="0" width="410" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["o in assenza dell'autorizzazione scritta ad iniziare il soggiorno."]]></expression>
			</element>
		</band>
		<band height="50">
			<element kind="staticText" key="staticText-23" style="TNR11" x="272" y="0" width="193" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[IL DIRETTORE]]></text>
			</element>
			<element kind="staticText" key="staticText-24" style="TNR11" x="272" y="14" width="193" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Dott.ssa Virginia Coda Nunziante]]></text>
			</element>
		</band>
	</detail>
	<pageFooter height="28" splitType="Prevent">
		<element kind="line" x="0" y="5" width="465" height="1">
			<pen lineWidth="0.25"/>
		</element>
		<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="12" width="465" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="8">
			<expression><![CDATA["Piazzale Aldo Moro, 7 - 00185 Roma - Tel. "+$F{TELEF_RESPONS_ITA}+" - Fax "+$F{FAX_RESPONS_ITA}+" - email "+$F{EMAIL_RESPONS_ITA}+""]]></expression>
		</element>
	</pageFooter>
	<summary splitType="Prevent"/>
</jasperReport>
