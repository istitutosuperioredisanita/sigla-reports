	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long" forPrompting="false"/>
	<parameter name="flag_to_update" class="java.lang.String" forPrompting="false"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="pie_pagina" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select
a.dt_ini_visita, a.dt_fin_visita, e.ds_nazione_eng, e.fax_respons_str,
b.denominazione_sede ds_terzo_autorizzato, g.cd_respons_ita, g.cd_respons_str,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_ita) responsabile_ita,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_str) responsabile_str,
s.ti_sesso sesso_autorizzato,
e.nome_ente_str, e.nome_respons_str, e.cognome_respons_str,
e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str, g.ds_progetto_ita, g.ds_progetto_eng, e.email_respons_ita, e.telef_respons_ita, e.fax_respons_ita, e.anno_ini, e.anno_fin
from blt_visite a, blt_autorizzati h, terzo b, blt_accordi e, nazione f, blt_progetti g, anagrafico s
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = e.cd_accordo
and a.cd_accordo = h.cd_accordo
and a.cd_accordo = g.cd_accordo
and h.cd_accordo = e.cd_accordo
and h.cd_accordo = g.cd_accordo
and g.cd_accordo = e.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_progetto = g.cd_progetto
and g.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and e.pg_nazione_str = f.pg_nazione
and s.cd_anag = b.cd_anag
	]]></query>
	<field name="DT_INI_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA" class="java.sql.Timestamp"/>
	<field name="DS_NAZIONE_ENG" class="java.lang.String"/>
	<field name="FAX_RESPONS_STR" class="java.lang.String"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="CD_RESPONS_ITA" class="java.math.BigDecimal"/>
	<field name="CD_RESPONS_STR" class="java.math.BigDecimal"/>
	<field name="RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="RESPONSABILE_STR" class="java.lang.String"/>
	<field name="SESSO_AUTORIZZATO" class="java.lang.String"/>
	<field name="NOME_ENTE_STR" class="java.lang.String"/>
	<field name="NOME_RESPONS_STR" class="java.lang.String"/>
	<field name="COGNOME_RESPONS_STR" class="java.lang.String"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<field name="DS_PROGETTO_ITA" class="java.lang.String"/>
	<field name="DS_PROGETTO_ENG" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_ITA" class="java.lang.String"/>
	<field name="TELEF_RESPONS_ITA" class="java.lang.String"/>
	<field name="FAX_RESPONS_ITA" class="java.lang.String"/>
	<field name="ANNO_INI" class="java.math.BigDecimal"/>
	<field name="ANNO_FIN" class="java.math.BigDecimal"/>
	<variable name="numGiorni" class="java.lang.Long">
		<expression><![CDATA[$P{REPORT_SCRIPTLET}.getGiorniVisita($F{DT_INI_VISITA}, $F{DT_FIN_VISITA})]]></expression>
	</variable>
	<background splitType="Stretch"/>
	<pageHeader height="100" splitType="Stretch">
		<element kind="staticText" key="staticText-23" style="TNR11" x="27" y="27" width="150" height="14" forecolor="#244061" hTextAlign="Center" fontName="Times New Roman" fontSize="8" italic="true">
			<text><![CDATA[International Relations and Agreements Office]]></text>
		</element>
		<element kind="image" key="image-1" x="0" y="0" width="177" height="28" scaleImage="FillFrame" onErrorType="Icon">
			<expression><![CDATA[$P{DIR_IMAGE}+"Logo CNR-2010-ENG-low.png"]]></expression>
		</element>
	</pageHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<element kind="staticText" key="staticText-1" style="TNR11" x="247" y="0" width="50" height="14" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[To]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="168" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+")"]]></expression>
			</element>
		</band>
		<band height="18">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="168" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Office of International Affairs"]]></expression>
			</element>
		</band>
		<band height="18">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="168" height="14" pattern="" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{DS_NAZIONE_ENG}+""]]></expression>
			</element>
		</band>
		<band height="17">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="297" y="0" width="168" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Attn. "+$F{NOME_RESPONS_STR}.toUpperCase()+" "+$F{COGNOME_RESPONS_STR}.toUpperCase()+""]]></expression>
			</element>
		</band>
		<band height="60">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="40" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Agreement on scientific cooperation between CNR and "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENG}+" - "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennium":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennium":"Years"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+". Joint research project '"+$F{DS_PROGETTO_ENG}+"' ("+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+")."]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNR11" x="0" y="40" width="51" height="14" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Subject:]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="298" y="0" width="167" height="14" pattern="" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Fax "+$F{FAX_RESPONS_STR}+""]]></expression>
			</element>
		</band>
		<band height="50">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="0" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Italian nominee."]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="staticText" key="staticText-1" style="TNR11" x="0" y="0" width="56" height="14" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Dear Sir,]]></text>
			</element>
		</band>
		<band height="30">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Please find herewith enclosed the application form of the following Italian scientist wishing to carry out a research stay in "+$F{DS_NAZIONE_ENG}+":"]]></expression>
			</element>
		</band>
		<band height="30">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="4" width="137" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[NAME AND SURNAME]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="211" y="4" width="93" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[STARTING DATE
]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="304" y="4" width="161" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[JOINT PROJECT]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="137" y="4" width="74" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[DURATION]]></text>
			</element>
		</band>
		<band height="30">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="137" y="0" width="74" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$V{numGiorni}+" days"]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="137" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{DS_TERZO_AUTORIZZATO}.toUpperCase()+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="304" y="0" width="161" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="211" y="0" width="93" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA})+""]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["You are kindly requested to grant "+($F{SESSO_AUTORIZZATO}.equals("M")?"him":"her")+" the hospitality treatment provided by the above Agreement."]]></expression>
			</element>
		</band>
		<band height="18">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Waiting for your kind reply and hoping in a fruitful cooperation."]]></expression>
			</element>
		</band>
		<band height="40">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Best regards,"]]></expression>
			</element>
		</band>
		<band height="80">
			<element kind="staticText" key="staticText-24" style="TNR11" x="286" y="0" width="179" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Virginia Coda Nunziante]]></text>
			</element>
			<element kind="staticText" key="staticText-23" style="TNR11" x="286" y="14" width="179" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Head,]]></text>
			</element>
			<element kind="staticText" key="staticText-23" style="TNR11" x="286" y="28" width="179" height="28" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[International Relations and Agreements Office]]></text>
			</element>
		</band>
	</detail>
	<pageFooter height="28">
		<printWhenExpression><![CDATA[$P{pie_pagina}]]></printWhenExpression>
		<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="12" width="465" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="8">
			<expression><![CDATA["Piazzale Aldo Moro, 7 - 00185 Roma - Tel. "+$F{TELEF_RESPONS_ITA}+" - Fax "+$F{FAX_RESPONS_ITA}+" - email "+$F{EMAIL_RESPONS_ITA}+""]]></expression>
		</element>
		<element kind="line" x="0" y="5" width="465" height="1">
			<pen lineWidth="0.25"/>
		</element>
	</pageFooter>
	<summary splitType="Stretch"/>
</jasperReport>
