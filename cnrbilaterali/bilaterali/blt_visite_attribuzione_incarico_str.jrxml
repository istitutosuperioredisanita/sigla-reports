<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Provv_Attribuz_Incarico_univ_e_str" pageWidth="595" pageHeight="842" columnWidth="465" leftMargin="65" rightMargin="65" topMargin="20" bottomMargin="40" scriptletClass="it.cnr.jasperreports.scriptlet.sigla.Blt_visite_stampe_candidaturaScriptlet" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.2100000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<style name="TNR8" default="false" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG8" default="false" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC8" default="false" fontName="Times New Roman" fontSize="8" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR9" default="false" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" default="false" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC9" default="false" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" default="false" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" default="false" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" default="false" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" default="false" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" default="false" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" default="false" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" default="false" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" default="false" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" default="false" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" default="false" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" default="false" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" default="false" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" default="false" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" default="false" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" default="false" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long" forPrompting="false"/>
	<parameter name="flag_to_update" class="java.lang.String" forPrompting="false"/>
	<parameter name="DIR_IMAGE" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select
a.dt_ini_visita, a.dt_fin_visita, a.luogo_visita, e.num_prot_lista_congiunta, e.dt_prot_lista_congiunta,
b.denominazione_sede ds_terzo_autorizzato,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_ita) responsabile_ita,
(select s.ti_sesso from anagrafico s, terzo b where b.cd_anag = s.cd_anag and b.cd_terzo = g.cd_respons_ita) sesso_responsabile_ita,
(select s.ti_sesso from anagrafico s, terzo b where b.cd_anag = s.cd_anag and b.cd_terzo = g.cd_respons_str) sesso_responsabile_str,
s.ti_sesso sesso_autorizzato,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_str) responsabile_str,
e.nome_ente_str, e.data_firma_accordo, e.data_firma_addendum, e.num_prot_dec_contr, e.data_prot_dec_cont,
e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str, h.ti_italiano_estero,
g.ds_progetto_ita, a.num_prot_candidatura, a.dt_prot_candidatura, e.anno_fin, e.anno_ini
from blt_visite a, blt_autorizzati h, terzo b, blt_accordi e, nazione f, blt_progetti g, anagrafico s
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = h.cd_accordo
and a.cd_accordo = g.cd_accordo
and h.cd_accordo = g.cd_accordo
and h.cd_accordo = e.cd_accordo
and g.cd_accordo = e.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_progetto = g.cd_progetto
and h.cd_progetto = g.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and a.cd_terzo = b.cd_terzo
and e.pg_nazione_str = f.pg_nazione
and s.cd_anag = b.cd_anag
	]]></query>
	<field name="DT_INI_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA" class="java.sql.Timestamp"/>
	<field name="LUOGO_VISITA" class="java.lang.String"/>
	<field name="NUM_PROT_LISTA_CONGIUNTA" class="java.math.BigDecimal"/>
	<field name="DT_PROT_LISTA_CONGIUNTA" class="java.sql.Timestamp"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="SESSO_RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="SESSO_RESPONSABILE_STR" class="java.lang.String"/>
	<field name="SESSO_AUTORIZZATO" class="java.lang.String"/>
	<field name="RESPONSABILE_STR" class="java.lang.String"/>
	<field name="NOME_ENTE_STR" class="java.lang.String"/>
	<field name="DATA_FIRMA_ACCORDO" class="java.sql.Timestamp"/>
	<field name="DATA_FIRMA_ADDENDUM" class="java.sql.Timestamp"/>
	<field name="NUM_PROT_DEC_CONTR" class="java.math.BigDecimal"/>
	<field name="DATA_PROT_DEC_CONT" class="java.sql.Timestamp"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<field name="TI_ITALIANO_ESTERO" class="java.lang.String"/>
	<field name="DS_PROGETTO_ITA" class="java.lang.String"/>
	<field name="NUM_PROT_CANDIDATURA" class="java.math.BigDecimal"/>
	<field name="DT_PROT_CANDIDATURA" class="java.sql.Timestamp"/>
	<field name="ANNO_FIN" class="java.math.BigDecimal"/>
	<field name="ANNO_INI" class="java.math.BigDecimal"/>
	<variable name="numGiorni" class="java.lang.Long">
		<expression><![CDATA[$P{REPORT_SCRIPTLET}.getGiorniVisita($F{DT_INI_VISITA}, $F{DT_FIN_VISITA})]]></expression>
	</variable>
	<background splitType="Stretch"/>
	<pageHeader height="110" splitType="Stretch">
		<element kind="image" key="image-1" x="0" y="0" width="465" height="58" scaleImage="FillFrame" onErrorType="Icon">
			<expression><![CDATA[$P{DIR_IMAGE}+"Logo CNR-2010-ITA-09-high.png"]]></expression>
		</element>
		<element kind="staticText" key="staticText-23" style="TNR11" x="0" y="58" width="465" height="14" forecolor="#244061" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
			<text><![CDATA[Ufficio Accordi e Relazioni Internazionali]]></text>
		</element>
	</pageHeader>
	<detail>
		<band height="60" splitType="Stretch">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="40" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["Accordo di cooperazione scientifica tra CNR e "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENTE_STR}+" - "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennio":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennio":"Anni"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+". Progetto comune di ricerca  "+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+"."]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNR11" x="0" y="40" width="51" height="14" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Oggetto:]]></text>
			</element>
		</band>
		<band height="50">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="0" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Individuazione contraente - attribuzione incarico di collaborazione "+
($F{SESSO_AUTORIZZATO}.equals("M")?"al Dott.":"alla Dott.ssa")+
" "+$F{DS_TERZO_AUTORIZZATO}.toUpperCase()+"."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Stretch">
			<element kind="staticText" key="staticText-23" style="TNRG11" x="0" y="0" width="465" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="true">
				<text><![CDATA[IL DIRETTORE]]></text>
			</element>
		</band>
		<band height="20">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["<style pdfFontName='Times-Bold' isBold='true'>VISTI</style> l’Accordo di cooperazione scientifica tra CNR e "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENTE_STR}+", sottoscritto dalle Parti il "+new SimpleDateFormat("dd/MM/yyyy").format($F{DATA_FIRMA_ACCORDO})+" e l’Addendum del "+new SimpleDateFormat("dd/MM/yyyy").format($F{DATA_FIRMA_ADDENDUM})+" riguardante le attivita' "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"del biennio":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"del triennio":"per gli anni"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+";"]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["<style pdfFontName='Times-Bold' isBold='true'>CONSIDERATO</style> che l’attività oggetto degli incarichi non è soggetta al procedimento di verifica delle professionalità interne in quanto gli incarichi stessi non sono riconducibili all’art. 7, comma 6, del D.Lgs. n. 165 del 2001 ma trovano fonte normativa dall’Accordo CNR/"+$F{ACRONIMO_ENTE_STR}+";"]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["<style pdfFontName='Times-Bold' isBold='true'>VISTO</style> il provvedimento, prot. AMMCNT – CNR n. "+$F{NUM_PROT_DEC_CONTR}+" del "+new SimpleDateFormat("dd/MM/yyyy").format($F{DATA_PROT_DEC_CONT})+", con il quale il Direttore dell’Ufficio Accordi e Relazioni Internazionali emana la Decisione di contrattare per l’affidamento di collaborazioni aventi ad oggetto soggiorni di ricerca in "+$F{DS_NAZIONE_ENTE_STR}+" ed in Italia nell'ambito dell'Accordo CNR/"+$F{ACRONIMO_ENTE_STR}+";"]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["<style pdfFontName='Times-Bold' isBold='true'>VISTA</style> la lista congiunta CNR/"+$F{ACRONIMO_ENTE_STR}+""+($F{NUM_PROT_LISTA_CONGIUNTA}!=null?", prot. AMMCNT - CNR n. "+$F{NUM_PROT_LISTA_CONGIUNTA}+" del "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_PROT_LISTA_CONGIUNTA})+",":"")+" dei Progetti comuni di ricerca approvati "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"per il biennio":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"per il triennio":"per gli anni"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+";"]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["<style pdfFontName='Times-Bold' isBold='true'>CONSIDERATO</style> che nel Progetto comune di ricerca '"+$F{DS_PROGETTO_ITA}+"' (Responsabile italiano "+($F{SESSO_RESPONSABILE_ITA}.equals("M")?"Dott.":"Dott.ssa")+" "+$F{RESPONSABILE_ITA}.toUpperCase()+", Responsabile straniero "+($F{SESSO_RESPONSABILE_STR}.equals("M")?"Dott.":"Dott.ssa")+" "+$F{RESPONSABILE_STR}.toUpperCase()+"), approvato congiuntamente da CNR e "+$F{ACRONIMO_ENTE_STR}+", "+($F{SESSO_AUTORIZZATO}.equals("M")?"il Dott.":"la Dott.ssa")+" "+$F{DS_TERZO_AUTORIZZATO}.toUpperCase()+" risulta tra i candidati inseriti nel Progetto;"]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="staticText" key="staticText-23" style="TNRG11" x="0" y="0" width="465" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="true">
				<text><![CDATA[DISPONE]]></text>
			</element>
		</band>
		<band height="40">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["di attribuire "+($F{SESSO_AUTORIZZATO}.equals("M")?"al Dott.":"alla Dott.ssa")+" "+$F{DS_TERZO_AUTORIZZATO}.toUpperCase()+" l’incarico di collaborazione per prestazione d’opera, in regime di lavoro autonomo occasionale, per lo svolgimento, nell’ambito dell’Accordo di cooperazione scientifica tra CNR e "+
$F{ACRONIMO_ENTE_STR}+", di un soggiorno di ricerca di "+$V{numGiorni}+
" gg. da svolgersi "+
($F{TI_ITALIANO_ESTERO}.equals("I")?"in "+$F{DS_NAZIONE_ENTE_STR}+"":"presso l'"+$F{LUOGO_VISITA}+"")+
", dal "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA})+
" al "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_FIN_VISITA})+"."]]></expression>
			</element>
		</band>
		<band height="50">
			<element kind="staticText" key="staticText-24" style="TNR11" x="289" y="14" width="176" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Dott.ssa Virginia Coda Nunziante]]></text>
			</element>
			<element kind="staticText" key="staticText-23" style="TNR11" x="289" y="0" width="176" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[IL DIRETTORE]]></text>
			</element>
		</band>
	</detail>
	<summary splitType="Stretch"/>
</jasperReport>
