<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="DocumentiCandidatura" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<style name="TNR8" default="false" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG8" default="false" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC8" default="false" fontName="Times New Roman" fontSize="8" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR9" default="false" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" default="false" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC9" default="false" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" default="false" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" default="false" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" default="false" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" default="false" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" default="false" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" default="false" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" default="false" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" default="false" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" default="false" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" default="false" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" default="false" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" default="false" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" default="false" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" default="false" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" default="false" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long"/>
	<parameter name="flag_to_update" class="java.lang.String" forPrompting="false"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select a.cd_accordo,  e.telef_respons_ita, e.fax_respons_ita, e.email_respons_ita
from blt_visite a, blt_autorizzati h, terzo b, cdr c, blt_accordi e, nazione f, blt_progetti g
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = h.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and h.cd_cdr_terzo = c.cd_centro_responsabilita
and h.cd_accordo = e.cd_accordo
and e.pg_nazione_str = f.pg_nazione
and a.cd_accordo = g.cd_accordo
and a.cd_progetto = g.cd_progetto
	]]></query>
	<field name="CD_ACCORDO" class="java.lang.String"/>
	<field name="TELEF_RESPONS_ITA" class="java.lang.String"/>
	<field name="FAX_RESPONS_ITA" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_ITA" class="java.lang.String"/>
	<detail>
		<band height="2" splitType="Prevent">
			<element kind="subreport" key="subreport-2" printRepeatedValues="false" x="0" y="1" width="595" height="1" usingCache="false">
				<parameter name="SUBREPORT_DIR">
					<expression><![CDATA[$P{SUBREPORT_DIR}]]></expression>
				</parameter>
				<parameter name="pg_ver_rec">
					<expression><![CDATA[$P{pg_ver_rec}]]></expression>
				</parameter>
				<parameter name="pg_visita">
					<expression><![CDATA[$P{pg_visita}]]></expression>
				</parameter>
				<parameter name="cd_accordo">
					<expression><![CDATA[$P{cd_accordo}]]></expression>
				</parameter>
				<parameter name="cd_progetto">
					<expression><![CDATA[$P{cd_progetto}]]></expression>
				</parameter>
				<parameter name="flag_to_update">
					<expression><![CDATA[$P{flag_to_update}]]></expression>
				</parameter>
				<parameter name="cd_terzo">
					<expression><![CDATA[$P{cd_terzo}]]></expression>
				</parameter>
				<parameter name="pie_pagina">
					<expression><![CDATA[false]]></expression>
				</parameter>
				<parameter name="pg_autorizzazione">
					<expression><![CDATA[$P{pg_autorizzazione}]]></expression>
				</parameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<expression><![CDATA[$P{SUBREPORT_DIR} + "blt_visite_disp_finanziarie_cnr.jasper"]]></expression>
			</element>
		</band>
		<band height="2" splitType="Prevent">
			<element kind="subreport" key="subreport-2" printRepeatedValues="false" x="0" y="1" width="595" height="1" usingCache="false">
				<parameter name="SUBREPORT_DIR">
					<expression><![CDATA[$P{SUBREPORT_DIR}]]></expression>
				</parameter>
				<parameter name="pg_ver_rec">
					<expression><![CDATA[$P{pg_ver_rec}]]></expression>
				</parameter>
				<parameter name="pg_visita">
					<expression><![CDATA[$P{pg_visita}]]></expression>
				</parameter>
				<parameter name="cd_accordo">
					<expression><![CDATA[$P{cd_accordo}]]></expression>
				</parameter>
				<parameter name="cd_progetto">
					<expression><![CDATA[$P{cd_progetto}]]></expression>
				</parameter>
				<parameter name="flag_to_update">
					<expression><![CDATA[$P{flag_to_update}]]></expression>
				</parameter>
				<parameter name="cd_terzo">
					<expression><![CDATA[$P{cd_terzo}]]></expression>
				</parameter>
				<parameter name="pie_pagina">
					<expression><![CDATA[false]]></expression>
				</parameter>
				<parameter name="pg_autorizzazione">
					<expression><![CDATA[$P{pg_autorizzazione}]]></expression>
				</parameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<expression><![CDATA[$P{SUBREPORT_DIR} + "blt_visite_trasmissione_candidatura_cnr.jasper"]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="28" splitType="Prevent">
		<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="65" y="8" width="465" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="8">
			<expression><![CDATA["Piazzale Aldo Moro, 7 - 00185 Roma - Tel. "+$F{TELEF_RESPONS_ITA}+" - Fax "+$F{FAX_RESPONS_ITA}+" - email "+$F{EMAIL_RESPONS_ITA}+""]]></expression>
		</element>
		<element kind="line" x="65" y="3" width="465" height="1">
			<pen lineWidth="0.25"/>
		</element>
	</pageFooter>
</jasperReport>
