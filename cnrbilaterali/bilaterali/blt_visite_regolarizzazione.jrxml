	<style name="TNRC9" default="false" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" default="false" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" default="false" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" default="false" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" default="false" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" default="false" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" default="false" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" default="false" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" default="false" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" default="false" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" default="false" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" default="false" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" default="false" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" default="false" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" default="false" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" default="false" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long" forPrompting="false"/>
	<parameter name="flag_to_update" class="java.lang.String" forPrompting="false"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["/home/mspasiano/STAMPE BILATERALI/"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select
a.dt_ini_visita, a.dt_fin_visita, a.dt_fin_visita_effettiva, a.dt_ini_visita_effettiva,
b.denominazione_sede ds_terzo_autorizzato,
ri.denominazione_sede ds_responsabile_ita, a.im_rimb_spese,
rs.denominazione_sede ds_responsabile_str, a.num_prot_accett_ente_str, a.dt_prot_accett_ente_str,
e.nome_ente_str, e.data_firma_accordo, e.data_firma_addendum, e.num_prot_dec_contr, e.data_prot_dec_cont, a.pg_repertorio, a.num_prot_rimb_spese, a.dt_prot_rimb_spese,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_ita) responsabile_ita,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_str) responsabile_str,
(select s.ti_sesso from anagrafico s where s.cd_anag = b.cd_terzo) sesso_autorizzato,
e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str, e.telef_respons_ita, e.fax_respons_ita, e.email_respons_ita,
g.ds_progetto_ita, a.num_prot_attrib_incarico, a.dt_prot_attrib_incarico, a.num_prot_contratto, a.data_prot_contratto, h.fl_assimilato_dip, s.codice_iban,
a.esercizio_obblig, a.esercizio_ori_obblig, a.pg_obbligazione,
a.num_prot_candidatura, a.dt_prot_candidatura,
c.num_delibera, c.data_delibera, g.cd_respons_ita, g.cd_respons_str,
d.cd_elemento_voce, d.dt_registrazione, d.im_obbligazione,
d.cd_terzo, d.cd_unita_organizzativa, p.ds_elemento_voce,
(select s.ti_sesso from anagrafico s where s.cd_anag = b.cd_terzo) sesso_autorizzato,
(select distinct h.cd_linea_attivita from obbligazione_scad_voce h
where a.cd_cds_obblig = h.cd_cds
and a.esercizio_obblig = h.esercizio
and a.esercizio_ori_obblig = h.esercizio_originale
and a.pg_obbligazione = h.pg_obbligazione
and rownum < 2) cd_linea_attivita,
(select m.ds_linea_attivita from linea_attivita m
 where (m.cd_centro_responsabilita, m.cd_linea_attivita) in (select distinct h.cd_centro_responsabilita, h.cd_linea_attivita from obbligazione_scad_voce h
                               where a.cd_cds_obblig = h.cd_cds
                               and a.esercizio_obblig = h.esercizio
                               and a.esercizio_ori_obblig = h.esercizio_originale
                               and a.pg_obbligazione = h.pg_obbligazione
                               and rownum < 2)) ds_linea_attivita
from blt_visite a, blt_autorizzati h, terzo b, blt_accordi e, nazione f, blt_progetti g, blt_esercizio c, obbligazione d, elemento_voce p, terzo ri, terzo rs, banca s
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = h.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and a.esercizio_obblig = c.esercizio
and h.cd_accordo = e.cd_accordo
and e.pg_nazione_str = f.pg_nazione
and a.cd_accordo = g.cd_accordo
and a.cd_progetto = g.cd_progetto
and g.cd_respons_ita = ri.cd_terzo
and g.cd_respons_str = rs.cd_terzo
and a.cd_cds_obblig = d.cd_cds
and a.esercizio_obblig = d.esercizio
and a.esercizio_ori_obblig = d.esercizio_originale
and a.pg_obbligazione = d.pg_obbligazione
and d.esercizio = p.esercizio
and d.ti_appartenenza = p.ti_appartenenza
and d.ti_gestione = p.ti_gestione
and d.cd_elemento_voce = p.cd_elemento_voce
and s.cd_terzo = b.cd_terzo
	]]></query>
	<field name="DT_INI_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA_EFFETTIVA" class="java.sql.Timestamp"/>
	<field name="DT_INI_VISITA_EFFETTIVA" class="java.sql.Timestamp"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="DS_RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="IM_RIMB_SPESE" class="java.math.BigDecimal"/>
	<field name="DS_RESPONSABILE_STR" class="java.lang.String"/>
	<field name="NUM_PROT_ACCETT_ENTE_STR" class="java.math.BigDecimal"/>
	<field name="DT_PROT_ACCETT_ENTE_STR" class="java.sql.Timestamp"/>
	<field name="NOME_ENTE_STR" class="java.lang.String"/>
	<field name="DATA_FIRMA_ACCORDO" class="java.sql.Timestamp"/>
	<field name="DATA_FIRMA_ADDENDUM" class="java.sql.Timestamp"/>
	<field name="NUM_PROT_DEC_CONTR" class="java.math.BigDecimal"/>
	<field name="DATA_PROT_DEC_CONT" class="java.sql.Timestamp"/>
	<field name="PG_REPERTORIO" class="java.math.BigDecimal"/>
	<field name="NUM_PROT_RIMB_SPESE" class="java.math.BigDecimal"/>
	<field name="DT_PROT_RIMB_SPESE" class="java.sql.Timestamp"/>
	<field name="RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="RESPONSABILE_STR" class="java.lang.String"/>
	<field name="SESSO_AUTORIZZATO" class="java.lang.String"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<field name="TELEF_RESPONS_ITA" class="java.lang.String"/>
	<field name="FAX_RESPONS_ITA" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_ITA" class="java.lang.String"/>
	<field name="DS_PROGETTO_ITA" class="java.lang.String"/>
	<field name="NUM_PROT_ATTRIB_INCARICO" class="java.math.BigDecimal"/>
	<field name="DT_PROT_ATTRIB_INCARICO" class="java.sql.Timestamp"/>
	<field name="NUM_PROT_CONTRATTO" class="java.math.BigDecimal"/>
	<field name="DATA_PROT_CONTRATTO" class="java.sql.Timestamp"/>
	<field name="FL_ASSIMILATO_DIP" class="java.lang.String"/>
	<field name="CODICE_IBAN" class="java.lang.String"/>
	<field name="ESERCIZIO_OBBLIG" class="java.math.BigDecimal"/>
	<field name="ESERCIZIO_ORI_OBBLIG" class="java.math.BigDecimal"/>
	<field name="PG_OBBLIGAZIONE" class="java.math.BigDecimal"/>
	<field name="NUM_PROT_CANDIDATURA" class="java.math.BigDecimal"/>
	<field name="DT_PROT_CANDIDATURA" class="java.sql.Timestamp"/>
	<field name="NUM_DELIBERA" class="java.lang.String"/>
	<field name="DATA_DELIBERA" class="java.sql.Timestamp"/>
	<field name="CD_RESPONS_ITA" class="java.math.BigDecimal"/>
	<field name="CD_RESPONS_STR" class="java.math.BigDecimal"/>
	<field name="CD_ELEMENTO_VOCE" class="java.lang.String"/>
	<field name="DT_REGISTRAZIONE" class="java.sql.Timestamp"/>
	<field name="IM_OBBLIGAZIONE" class="java.math.BigDecimal"/>
	<field name="CD_TERZO" class="java.math.BigDecimal"/>
	<field name="CD_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
	<field name="DS_ELEMENTO_VOCE" class="java.lang.String"/>
	<field name="CD_LINEA_ATTIVITA" class="java.lang.String"/>
	<field name="DS_LINEA_ATTIVITA" class="java.lang.String"/>
	<variable name="numGiorni" class="java.lang.Long">
		<expression><![CDATA[$P{REPORT_SCRIPTLET}.getGiorniVisita($F{DT_INI_VISITA}, $F{DT_FIN_VISITA})]]></expression>
	</variable>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader height="60" splitType="Stretch">
		<element kind="staticText" key="staticText-23" style="TNR11" x="25" y="28" width="174" height="14" forecolor="#244061" hTextAlign="Center" fontName="Times New Roman" fontSize="8" italic="true">
			<text><![CDATA[Ufficio Accordi e Relazioni Internazionali]]></text>
		</element>
		<element kind="image" key="image-1" x="0" y="0" width="199" height="28" scaleImage="FillFrame" onErrorType="Icon">
			<expression><![CDATA[$P{DIR_IMAGE}+"Logo CNR-2010-ITA-low.png"]]></expression>
		</element>
	</pageHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["Ufficio Monitoraggio Risorse e Ragioneria della Struttura Amministrativa Centrale"]]></expression>
			</element>
		</band>
		<band height="18">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["CNR Sede"]]></expression>
			</element>
		</band>
		<band height="15">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["Sig.ra Valentina Poce"]]></expression>
			</element>
		</band>
		<band height="15">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["email: valentina.poce@cnr.it"]]></expression>
			</element>
		</band>
		<band height="15">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["Sig. Maurizio Iovenitti"]]></expression>
			</element>
		</band>
		<band height="15">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["email: maurizio.iovenitti@cnr.it"]]></expression>
			</element>
		</band>
		<band height="45">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="25" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Accordo di cooperazione scientifica tra CNR e "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENTE_STR}+" - Biennio ....... . Progetto comune di ricerca "+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+"."]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="25" width="51" height="14" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Oggetto:]]></text>
			</element>
		</band>
		<band height="35">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="0" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Richiesta di regolarizzazione amministrativa."]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="1" width="465" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["In riferimento alla circolare n. 13/09 del 19/05/2009, si richiede la modifica delle registrazioni degli incarichi così come indicato nella tabelle seguente nelle colonne 'Stipula', 'Inizio validità', 'Fine validità' e 'Proroga':"]]></expression>
			</element>
		</band>
		<band height="20">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="78" y="0" width="74" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[ID procedura]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="152" y="0" width="46" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Terzo]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="0" width="78" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Es. procedura]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="198" y="0" width="58" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Stipula]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="256" y="0" width="80" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Inizio validità]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="336" y="0" width="80" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Fine validità]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="416" y="0" width="49" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Proroga]]></text>
			</element>
		</band>
		<band height="45">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="78" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11"/>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="78" y="0" width="74" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{PG_REPERTORIO}+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="152" y="0" width="46" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+$F{CD_TERZO}+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="199" y="0" width="57" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+new SimpleDateFormat("dd/MM/yyyy").format($F{DATA_PROT_CONTRATTO})+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="256" y="0" width="80" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA_EFFETTIVA})+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="336" y="0" width="80" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[""+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_FIN_VISITA_EFFETTIVA})+""]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="416" y="0" width="49" height="14" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11"/>
		</band>
		<band height="50">
			<element kind="staticText" key="staticText-24" style="TNR11" x="272" y="14" width="193" height="14" printWhenDetailOverflows="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Dott.ssa Virginia Coda Nunziante]]></text>
			</element>
			<element kind="staticText" key="staticText-23" style="TNR11" x="272" y="0" width="193" height="14" printWhenDetailOverflows="true" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[IL DIRETTORE]]></text>
			</element>
		</band>
	</detail>
	<pageFooter height="28">
		<element kind="line" x="0" y="5" width="465" height="1">
			<pen lineWidth="0.25"/>
		</element>
		<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="12" width="465" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="8">
			<expression><![CDATA["Piazzale Aldo Moro, 7 - 00185 Roma - Tel. "+$F{TELEF_RESPONS_ITA}+" - Fax "+$F{FAX_RESPONS_ITA}+" - email "+$F{EMAIL_RESPONS_ITA}+""]]></expression>
		</element>
	</pageFooter>
	<summary splitType="Stretch"/>
</jasperReport>
