<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Nota Addebito" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="20" bottomMargin="20" scriptletClass="it.cnr.jasperreports.scriptlet.sigla.Blt_visite_stampe_candidaturaScriptlet" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.2100000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<style name="TNR8" default="false" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG8" default="false" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC8" default="false" fontName="Times New Roman" fontSize="8" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR9" default="false" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" default="false" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC9" default="false" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" default="false" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" default="false" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" default="false" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" default="false" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" default="false" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" default="false" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" default="false" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" default="false" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" default="false" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" default="false" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" default="false" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" default="false" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" default="false" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" default="false" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" default="false" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long" forPrompting="false"/>
	<parameter name="flag_to_update" class="java.lang.String" forPrompting="false"/>
	<parameter name="anticipo" class="java.lang.String">
		<defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select
a.num_prot_attrib_incarico, a.dt_prot_attrib_incarico,
a.prc_oneri_fiscali, a.fl_accettazione_convenzione,
a.im_rimb_spese_ant, a.im_rimb_spese,
b.denominazione_sede ds_terzo_autorizzato,
e.num_articolo_conv_fiscale,
e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str
from blt_visite a, blt_autorizzati h, terzo b, blt_accordi e, nazione f
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = h.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and h.cd_accordo = e.cd_accordo
and e.pg_nazione_str = f.pg_nazione
	]]></query>
	<field name="NUM_PROT_ATTRIB_INCARICO" class="java.math.BigDecimal"/>
	<field name="DT_PROT_ATTRIB_INCARICO" class="java.sql.Timestamp"/>
	<field name="PRC_ONERI_FISCALI" class="java.math.BigDecimal"/>
	<field name="FL_ACCETTAZIONE_CONVENZIONE" class="java.lang.String"/>
	<field name="IM_RIMB_SPESE_ANT" class="java.math.BigDecimal"/>
	<field name="IM_RIMB_SPESE" class="java.math.BigDecimal"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="NUM_ARTICOLO_CONV_FISCALE" class="java.lang.String"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<variable name="LORDO_PERCIPIENTE" class="java.math.BigDecimal">
		<expression><![CDATA[$P{anticipo}.equals( "Y" )?
 ($F{FL_ACCETTAZIONE_CONVENZIONE}.equals( "Y" )?$F{IM_RIMB_SPESE_ANT}:
     $F{IM_RIMB_SPESE_ANT}.divide(BigDecimal.ONE.subtract($F{PRC_ONERI_FISCALI}.divide(BigDecimal.TEN.multiply(BigDecimal.TEN))), 2, BigDecimal.ROUND_HALF_EVEN))
 :
 ($F{FL_ACCETTAZIONE_CONVENZIONE}.equals( "Y" )?$F{IM_RIMB_SPESE}:
     $F{IM_RIMB_SPESE}.divide(BigDecimal.ONE.subtract($F{PRC_ONERI_FISCALI}.divide(BigDecimal.TEN.multiply(BigDecimal.TEN))), 2, BigDecimal.ROUND_HALF_EVEN))]]></expression>
	</variable>
	<variable name="RITENUTA_PERCIPIENTE" class="java.math.BigDecimal">
		<expression><![CDATA[$V{LORDO_PERCIPIENTE}.subtract( $P{anticipo}.equals( "Y" )?$F{IM_RIMB_SPESE_ANT}:$F{IM_RIMB_SPESE})]]></expression>
	</variable>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader height="94" splitType="Stretch">
		<element kind="image" key="image-1" x="0" y="0" width="529" height="80" scaleImage="FillFrame" onErrorType="Icon">
			<expression><![CDATA[$P{SUBREPORT_DIR}+"Logo CNR-2010-ITA-09-high.png"]]></expression>
		</element>
		<element kind="staticText" key="staticText-23" style="TNR11" x="0" y="80" width="529" height="14" forecolor="#244061" hTextAlign="Center" fontName="Times New Roman" fontSize="10">
			<text><![CDATA[Ufficio Accordi e Relazioni Internazionali]]></text>
		</element>
	</pageHeader>
	<detail>
		<band height="85" splitType="Stretch">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="218" height="15" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="10">
				<expression><![CDATA[$F{DS_TERZO_AUTORIZZATO}]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="259" y="15" width="16" height="15" fontName="Times New Roman" fontSize="10" bold="false">
				<text><![CDATA[A]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="275" y="15" width="240" height="15" fontName="Times New Roman" fontSize="10" bold="false">
				<text><![CDATA[Consiglio Nazionale delle Ricerche]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="275" y="29" width="240" height="15" fontName="Times New Roman" fontSize="10" bold="false">
				<text><![CDATA[Piazzale Aldo Moro, 7]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="275" y="43" width="240" height="15" fontName="Times New Roman" fontSize="10" bold="false">
				<text><![CDATA[00185 Roma]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="275" y="56" width="240" height="15" fontName="Times New Roman" fontSize="10" bold="false">
				<text><![CDATA[C.F. 80054330586]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="275" y="70" width="240" height="15" fontName="Times New Roman" fontSize="10" bold="false">
				<text><![CDATA[P. IVA 02118311006]]></text>
			</element>
		</band>
		<band height="15"/>
		<band height="15"/>
		<band height="29"/>
		<band height="19">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="0" width="115" height="16" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[NOTA DI ADDEBITO]]></text>
			</element>
		</band>
		<band height="78">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="515" height="66" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="10">
				<expression><![CDATA["Oggetto: Compenso per soggiorno di ricerca Accordo di cooperazione scientifica CNR/"+$F{ACRONIMO_ENTE_STR}+" ("+$F{DS_NAZIONE_ENTE_STR}+"), di cui al Provvedimento di attribuzione incarico prot. AMMCNT – CNR n. "+$F{NUM_PROT_ATTRIB_INCARICO}+" del "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_PROT_ATTRIB_INCARICO})+" "]]></expression>
			</element>
		</band>
		<band height="123">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="0" width="70" height="16" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[COMPENSO]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="218" y="30" width="127" height="16" hTextAlign="Right" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[TOTALE IMPONIBILE]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="162" y="57" width="183" height="34" blankWhenNull="true" hTextAlign="Right" fontName="Times New Roman" fontSize="10">
				<expression><![CDATA[$F{FL_ACCETTAZIONE_CONVENZIONE}.equals( "Y" )?"IRPEF (non imponibile per Convenzione Italia/"+$F{ACRONIMO_ENTE_STR}+", art. "+$F{NUM_ARTICOLO_CONV_FISCALE}+")":"IRPEF "+$F{PRC_ONERI_FISCALI}+"%"]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-76" style="TNR9" x="369" y="1" width="115" height="15" pattern="€ #,##0.00" blankWhenNull="false" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$V{LORDO_PERCIPIENTE}]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-76" style="TNR9" x="369" y="30" width="115" height="15" pattern="€ #,##0.00" blankWhenNull="false" hTextAlign="Right" vTextAlign="Middle" bold="true">
				<expression><![CDATA[$V{LORDO_PERCIPIENTE}]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-76" style="TNR9" x="369" y="57" width="115" height="15" pattern="€ #,##0.00" blankWhenNull="false" hTextAlign="Right" vTextAlign="Middle" bold="true">
				<expression><![CDATA[$V{RITENUTA_PERCIPIENTE}]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-76" style="TNR9" x="369" y="91" width="115" height="15" pattern="€ #,##0.00" blankWhenNull="false" hTextAlign="Right" vTextAlign="Middle" bold="true">
				<expression><![CDATA[$V{LORDO_PERCIPIENTE}.subtract($V{RITENUTA_PERCIPIENTE})]]></expression>
			</element>
		</band>
		<band height="45">
			<element kind="staticText" key="staticText-1" style="TNRG11" x="330" y="15" width="56" height="16" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[Signature]]></text>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="265" y="1" width="70" height="16" fontName="Times New Roman" fontSize="10">
				<text><![CDATA[COMPENSO]]></text>
			</element>
		</band>
	</detail>
	<summary splitType="Stretch"/>
</jasperReport>
