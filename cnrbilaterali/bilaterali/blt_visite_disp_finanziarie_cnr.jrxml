<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Provvedimento" pageWidth="595" pageHeight="842" columnWidth="465" leftMargin="65" rightMargin="65" topMargin="30" bottomMargin="20" scriptletClass="it.cnr.jasperreports.scriptlet.sigla.Blt_visite_stampe_candidaturaScriptlet" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.210000000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="419"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR8" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG8" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC8" fontName="Times New Roman" fontSize="8" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR9" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC9" fontName="Times New Roman" fontSize="9" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNR10" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNRG10" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC10" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG11" fontName="Times New Roman" fontSize="11" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNRG12" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRC12" fontName="Times New Roman" fontSize="12" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRGC14" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRG14" fontName="Times New Roman" fontSize="14" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16" fontName="Times New Roman" fontSize="16" pdfFontName="Times-Roman"/>
	<style name="TNRC16" fontName="Times New Roman" fontSize="16" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRG16" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRGC16" fontName="Times New Roman" fontSize="16" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR11" fontName="Times New Roman" fontSize="11" pdfFontName="Times-Roman"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_accordo" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_progetto" class="java.lang.String">
		<defaultValueExpression><![CDATA["00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="cd_terzo" class="java.lang.Integer"/>
	<parameter name="pg_autorizzazione" class="java.lang.Long"/>
	<parameter name="pg_visita" class="java.lang.Long"/>
	<parameter name="pg_ver_rec" class="java.lang.Long"/>
	<parameter name="flag_to_update" class="java.lang.String" forPrompting="false"/>
	<parameter name="pie_pagina" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select
a.dt_ini_visita, a.dt_fin_visita, e.telef_respons_ita, e.fax_respons_ita, e.email_respons_ita, e.nome_respons_str, e.cognome_respons_str, h.fl_associato, e.fl_atti_amministrativi,
b.denominazione_sede ds_terzo_autorizzato, e.telef_respons_str, e.fax_respons_str, e.email_respons_str,
c.ds_cdr, e.im_diaria_contrib_sogg_ita, e.im_mensile_contrib_sogg_ita,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_ita) responsabile_ita,
(select b.denominazione_sede from terzo b where b.cd_terzo = g.cd_respons_str) responsabile_str,
s.ti_sesso sesso_autorizzato,
(select l.ds_comune from comune l where h.pg_comune_ente_di_appartenenza = l.pg_comune) comune_ente_di_appartenenza,
c.indirizzo indirizzo_istituto,
c.cd_cap cap_istituto,
(select l.ds_comune from comune l where c.pg_comune = l.pg_comune) comune_istituto, e.fl_lettera_invito, e.email_trasmissione_passaporto, e.fl_viaggi_interni,
e.anno_ini, e.anno_fin, h.ente_di_appartenenza, h.indirizzo_ente_di_appartenenza, h.cap_ente_di_appartenenza,
e.acronimo_ente_str, f.ds_nazione ds_nazione_ente_str, e.nome_ente_str, e.indirizzo_ente_str, e.citta_ente_str,
g.ds_progetto_ita, e.importo_diaria_ita, e.fl_spese_visto, e.cd_divisa_ita, c.co_indirizzo,
(select l.cd_provincia from anagrafico s, comune l where s.cd_anag = h.cd_terzo and c.pg_comune = l.pg_comune) provincia_istituto,
(select s.ti_sesso from anagrafico s, terzo b where b.cd_anag = s.cd_anag and b.cd_terzo = g.cd_respons_ita) sesso_responsabile_ita,
(select s.ti_sesso from anagrafico s, terzo b where b.cd_anag = s.cd_anag and b.cd_terzo = g.cd_respons_str) sesso_responsabile_str,
e.fl_rimborso_treno, e.importo_mensile_ita, h.fl_assimilato_dip, e.ds_nazione_eng
from blt_visite a, blt_autorizzati h, terzo b, blt_istituti c, blt_accordi e, nazione f, blt_progetti g, anagrafico s
where a.cd_accordo = $P{cd_accordo}
and a.cd_progetto = $P{cd_progetto}
and a.cd_terzo = $P{cd_terzo}
and a.pg_autorizzazione = $P{pg_autorizzazione}
and a.pg_visita = $P{pg_visita}
and a.cd_accordo = h.cd_accordo
and a.cd_progetto = h.cd_progetto
and a.cd_terzo = h.cd_terzo
and h.cd_terzo = b.cd_terzo
and h.cd_cdr_terzo = c.cd_centro_responsabilita (+)
and h.cd_accordo = e.cd_accordo
and e.pg_nazione_str = f.pg_nazione
and a.cd_accordo = g.cd_accordo
and a.cd_progetto = g.cd_progetto
and s.cd_anag = b.cd_anag
	]]></query>
	<field name="DT_INI_VISITA" class="java.sql.Timestamp"/>
	<field name="DT_FIN_VISITA" class="java.sql.Timestamp"/>
	<field name="TELEF_RESPONS_ITA" class="java.lang.String"/>
	<field name="FAX_RESPONS_ITA" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_ITA" class="java.lang.String"/>
	<field name="NOME_RESPONS_STR" class="java.lang.String"/>
	<field name="COGNOME_RESPONS_STR" class="java.lang.String"/>
	<field name="FL_ASSOCIATO" class="java.lang.String"/>
	<field name="FL_ATTI_AMMINISTRATIVI" class="java.lang.String"/>
	<field name="DS_TERZO_AUTORIZZATO" class="java.lang.String"/>
	<field name="TELEF_RESPONS_STR" class="java.lang.String"/>
	<field name="FAX_RESPONS_STR" class="java.lang.String"/>
	<field name="EMAIL_RESPONS_STR" class="java.lang.String"/>
	<field name="DS_CDR" class="java.lang.String"/>
	<field name="IM_DIARIA_CONTRIB_SOGG_ITA" class="java.math.BigDecimal"/>
	<field name="IM_MENSILE_CONTRIB_SOGG_ITA" class="java.math.BigDecimal"/>
	<field name="RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="RESPONSABILE_STR" class="java.lang.String"/>
	<field name="SESSO_AUTORIZZATO" class="java.lang.String"/>
	<field name="COMUNE_ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="INDIRIZZO_ISTITUTO" class="java.lang.String"/>
	<field name="CAP_ISTITUTO" class="java.lang.String"/>
	<field name="COMUNE_ISTITUTO" class="java.lang.String"/>
	<field name="FL_LETTERA_INVITO" class="java.lang.String"/>
	<field name="EMAIL_TRASMISSIONE_PASSAPORTO" class="java.lang.String"/>
	<field name="FL_VIAGGI_INTERNI" class="java.lang.String"/>
	<field name="ANNO_INI" class="java.math.BigDecimal"/>
	<field name="ANNO_FIN" class="java.math.BigDecimal"/>
	<field name="ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="INDIRIZZO_ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="CAP_ENTE_DI_APPARTENENZA" class="java.lang.String"/>
	<field name="ACRONIMO_ENTE_STR" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENTE_STR" class="java.lang.String"/>
	<field name="NOME_ENTE_STR" class="java.lang.String"/>
	<field name="INDIRIZZO_ENTE_STR" class="java.lang.String"/>
	<field name="CITTA_ENTE_STR" class="java.lang.String"/>
	<field name="DS_PROGETTO_ITA" class="java.lang.String"/>
	<field name="IMPORTO_DIARIA_ITA" class="java.math.BigDecimal"/>
	<field name="FL_SPESE_VISTO" class="java.lang.String"/>
	<field name="CD_DIVISA_ITA" class="java.lang.String"/>
	<field name="CO_INDIRIZZO" class="java.lang.String"/>
	<field name="PROVINCIA_ISTITUTO" class="java.lang.String"/>
	<field name="SESSO_RESPONSABILE_ITA" class="java.lang.String"/>
	<field name="SESSO_RESPONSABILE_STR" class="java.lang.String"/>
	<field name="FL_RIMBORSO_TRENO" class="java.lang.String"/>
	<field name="IMPORTO_MENSILE_ITA" class="java.math.BigDecimal"/>
	<field name="FL_ASSIMILATO_DIP" class="java.lang.String"/>
	<field name="DS_NAZIONE_ENG" class="java.lang.String"/>
	<variable name="numGiorni" class="java.lang.Long">
		<expression><![CDATA[$P{REPORT_SCRIPTLET}.getGiorniVisita($F{DT_INI_VISITA}, $F{DT_FIN_VISITA})]]></expression>
	</variable>
	<background splitType="Prevent"/>
	<title splitType="Prevent"/>
	<pageHeader height="120" splitType="Prevent">
		<element kind="image" key="image-1" x="0" y="0" width="199" height="28" scaleImage="FillFrame" onErrorType="Icon">
			<expression><![CDATA[$P{DIR_IMAGE}+"Logo CNR-2010-ITA-low.png"]]></expression>
		</element>
		<element kind="staticText" key="staticText-23" style="TNR11" x="25" y="28" width="174" height="14" forecolor="#244061" hTextAlign="Center" fontName="Times New Roman" fontSize="8" italic="true">
			<text><![CDATA[Ufficio Accordi e Relazioni Internazionali]]></text>
		</element>
	</pageHeader>
	<detail>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="221" y="0" width="78" height="14" blankWhenNull="true" hTextAlign="Right" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA[($F{SESSO_AUTORIZZATO}.equals("M")?"Al Dott.":"Alla Dott.ssa")]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA[$F{DS_TERZO_AUTORIZZATO}.toUpperCase()]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("Y")
?
$F{FL_ASSOCIATO}.equals("N")?($F{DS_CDR}+($F{CO_INDIRIZZO}==null?"":"\n"+$F{CO_INDIRIZZO})):$F{ENTE_DI_APPARTENENZA}
:$F{ENTE_DI_APPARTENENZA}]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("Y")
?$F{FL_ASSOCIATO}.equals("N")?($F{DS_CDR}==null)?"":(($F{INDIRIZZO_ISTITUTO}==null)?"INDIRIZZO NON INDIVIDUATO":$F{INDIRIZZO_ISTITUTO}):$F{INDIRIZZO_ENTE_DI_APPARTENENZA}
:$F{INDIRIZZO_ENTE_DI_APPARTENENZA}]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="315" y="0" width="150" height="14" blankWhenNull="true" hTextAlign="Left" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("Y")
?$F{FL_ASSOCIATO}.equals("N")?$F{DS_CDR}==null?"":($F{COMUNE_ISTITUTO}==null?"COMUNE NON INDIVIDUATO":$F{CAP_ISTITUTO}+" "+$F{COMUNE_ISTITUTO})+" - "+$F{PROVINCIA_ISTITUTO}:""+$F{CAP_ENTE_DI_APPARTENENZA}+" - "+$F{COMUNE_ENTE_DI_APPARTENENZA}+""
:""+$F{CAP_ENTE_DI_APPARTENENZA}+" - "+$F{COMUNE_ENTE_DI_APPARTENENZA}+""]]></expression>
			</element>
		</band>
		<band height="95" splitType="Prevent">
			<element kind="staticText" key="staticText-1" style="TNR11" x="0" y="75" width="51" height="14" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[Oggetto:]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="75" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false">
				<expression><![CDATA["Accordo di cooperazione scientifica tra CNR e "+$F{NOME_ENTE_STR}+" ("+$F{ACRONIMO_ENTE_STR}+"), "+$F{DS_NAZIONE_ENTE_STR}+" - "+($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(BigDecimal.ONE)==0?"Biennio":($F{ANNO_FIN}.subtract($F{ANNO_INI}).compareTo(new BigDecimal(2))==0?"Triennio":"Anni"))+ " " +$F{ANNO_INI}+"-"+$F{ANNO_FIN}+". Progetto comune di ricerca "+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+"."]]></expression>
			</element>
		</band>
		<band height="65" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="51" y="0" width="414" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Comunicazione disposizioni finanziarie."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Si informa che in data odierna è stata trasmessa a "+$F{ACRONIMO_ENTE_STR}+" la candidatura della S.V. per un soggiorno di ricerca in "+$F{DS_NAZIONE_ENTE_STR}+", della durata di "+$V{numGiorni}+" giorni, a decorrere dal "+new SimpleDateFormat("dd/MM/yyyy").format($F{DT_INI_VISITA})+", nell'ambito del Progetto comune di ricerca '"+$F{DS_PROGETTO_ITA}+"' (Responsabile italiano "+($F{SESSO_RESPONSABILE_ITA}.equals("M")?"Dott.":"Dott.ssa")+" "+$F{RESPONSABILE_ITA}.toUpperCase()+", Responsabile straniero "+($F{SESSO_RESPONSABILE_STR}.equals("M")?"Dott.":"Dott.ssa")+" "+$F{RESPONSABILE_STR}.toUpperCase()+")."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{EMAIL_TRASMISSIONE_PASSAPORTO}!=null]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Si invita la S.V. a trasmettere una copia del passaporto in corso di validita' al seguente indirizzo di posta elettronica "+$F{EMAIL_TRASMISSIONE_PASSAPORTO}+" facendo riferimento all'Accordo e al Progetto comune di ricerca "+$F{RESPONSABILE_ITA}.toUpperCase()+" / "+$F{RESPONSABILE_STR}.toUpperCase()+"."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["L'Accordo CNR/"+$F{ACRONIMO_ENTE_STR}+" prevede che il supporto finanziario allo studioso italiano sia limitato alla copertura delle spese relative al soggiorno."]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Saranno a carico di "+$F{ACRONIMO_ENTE_STR}+":"]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_VIAGGI_INTERNI}.equals("N")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["i viaggi interni, effettuati nel Paese ospitante mediante mezzi pubblici ordinari, necessari per lo svolgimento della ricerca secondo il programma di visita approvato;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA[$F{IM_DIARIA_CONTRIB_SOGG_ITA}!=null?"il rimborso delle spese per l'alloggio fino ad un massimo di "+$F{CD_DIVISA_ITA}+" "+new java.text.DecimalFormat("#,##0.00").format($F{IM_DIARIA_CONTRIB_SOGG_ITA})+" al giorno o per soggiorni di lunga durata un contributo mensile di "+$F{CD_DIVISA_ITA}+" "+new java.text.DecimalFormat("#,##0.00").format($F{IM_MENSILE_CONTRIB_SOGG_ITA})+";":"la fornitura dell'alloggio;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{IMPORTO_DIARIA_ITA}!= null]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["un contributo di soggiorno, così come previsto dall'Accordo CNR - "+$F{ACRONIMO_ENTE_STR}+"."]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Sara' a carico del CNR il rimborso delle seguenti spese:"]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["il viaggio andata e ritorno, dal luogo di provenienza fino a quello di destinazione (o altro indicato nei singoli Accordi), su mezzi pubblici ordinari:"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["in aereo: saranno totalmente rimborsate se sostenute acquistando il titolo a tariffa economica. Qualora vengano acquistati biglietti a tariffa superiore, il CNR provvedera' al rimborso dell'importo corrispondente alla tariffa economica vigente al momento della partenza"+($F{FL_RIMBORSO_TRENO}.equals("Y")?",":";")]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_RIMBORSO_TRENO}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["o in treno: saranno totalmente rimborsate se sostenute acquistando il biglietto di 2a classe/WL doppio. Qualora vengano utilizzati biglietti a tariffa superiore, il CNR provvederà al rimborso dell’importo corrispondente alla tariffa di 2a classe vigente al momento della partenza;"]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_SPESE_VISTO}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["il visto d’ingresso nel paese di destinazione"+($F{FL_LETTERA_INVITO}.equals("Y")?", assicurazione sanitaria (obbligatoria per la concessione del visto ed esclusivamente per il periodo di soggiorno autorizzato)":"")+" e la tassa d’imbarco aeroportuale;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false" italic="false">
				<expression><![CDATA["gli spostamenti in Italia dal luogo di lavoro o di residenza, su mezzi pubblici ordinari, per raggiungere "+($F{FL_RIMBORSO_TRENO}.equals("Y")?"l’aeroporto/stazione ferroviaria":"l’aeroporto")+" di partenza;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_VIAGGI_INTERNI}.equals("Y")]]></printWhenExpression>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["i viaggi interni, effettuati nel Paese ospitante mediante mezzi pubblici ordinari, necessari per lo svolgimento della ricerca secondo il programma di visita approvato;"]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false" italic="false">
				<expression><![CDATA["il taxi (solo se utilizzato per il trasporto dei materiali o per la mancanza o il cessato servizio di mezzi pubblici). La richiesta del rimborso dovrà essere corredata di motivazione scritta;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false" italic="false">
				<expression><![CDATA["la sovrattassa per eccesso bagaglio (solo per il trasporto di materiale necessario allo svolgimento della ricerca). La richiesta del rimborso dovrà essere corredata di motivazione scritta."]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Si ricorda che dal 01/02/2001 per adeguarsi alla normativa fiscale, il rimborso delle spese di viaggio deve essere ricondotto nell'ambito dell'art. 5 del DPR 23/10/1972 n. 633 in materia di IVA e degli art. 67, comma 1, lettera L e art. 49, comma 1, del Testo Unico delle imposte sui redditi in materia di IRPEF. Pertanto in sede di liquidazione delle spese il CNR applichera' la ritenuta d'acconto IRPEF del 20%, successivamente recuperabile in sede di dichiarazione dei redditi, con conservazione della documentazione originale, per il percettore della somma."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("Y")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["L'Ufficio scrivente, una volta pervenuta l'accettazione da parte dell'Ente straniero, autorizzera' per iscritto la S.V. a dare inizio al soggiorno. In assenza di tale autorizzazione il CNR non rimborserà alcuna spesa sostenuta."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["L'Ufficio scrivente, una volta pervenuta l'accettazione da parte dell'Ente straniero, inviera' alla S.V. il contratto di prestazione d'opera in regime di lavoro autonomo occasionale, relativo al citato soggiorno di ricerca, da sottoscrivere e restituire in originale."]]></expression>
			</element>
		</band>
		<band height="20" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
				<expression><![CDATA["Il soggiorno potra' iniziare solo dopo il perfezionamento del contratto (cioe' la sottoscrizione del contratto anche da parte del CNR) e la trasmissione alla S.V. dello stesso, sottoscritto da entrambe le Parti."]]></expression>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="0" width="466" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11">
				<expression><![CDATA["Il CNR non rimborsera' alcuna spesa sostenuta dalla S.V.:"]]></expression>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false" italic="false">
				<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
				<expression><![CDATA["in presenza di un contratto non perfezionato;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false" italic="false">
				<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
				<expression><![CDATA["o in assenza dell'autorizzazione scritta a dare inizio al soggiorno;"]]></expression>
			</element>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
		</band>
		<band height="18" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
			<element kind="staticText" key="staticText-1" style="TNRG11" x="35" y="0" width="15" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11" bold="false">
				<text><![CDATA[-]]></text>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="50" y="0" width="415" height="14" blankWhenNull="true" hTextAlign="Justified" fontName="Times New Roman" fontSize="11" bold="false" italic="false">
				<printWhenExpression><![CDATA[$F{FL_ASSIMILATO_DIP}.equals("N")]]></printWhenExpression>
				<expression><![CDATA["o in presenza di spostamenti di date di inizio e fine soggiorno concordati con l'Istituzione straniera e sopraggiunti dopo la sottoscrizione del contratto, non autorizzati per iscritto dall'Ufficio scrivente."]]></expression>
			</element>
		</band>
		<band height="50" splitType="Prevent">
			<element kind="staticText" key="staticText-24" style="TNR11" x="281" y="29" width="183" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[Dott.ssa Virginia Coda Nunziante]]></text>
			</element>
			<element kind="staticText" key="staticText-23" style="TNR11" x="281" y="15" width="183" height="14" hTextAlign="Center" fontName="Times New Roman" fontSize="11">
				<text><![CDATA[IL DIRETTORE]]></text>
			</element>
		</band>
	</detail>
	<pageFooter height="28" splitType="Stretch">
		<printWhenExpression><![CDATA[$P{pie_pagina}]]></printWhenExpression>
		<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR11" x="0" y="12" width="465" height="12" blankWhenNull="true" hTextAlign="Center" fontName="Times New Roman" fontSize="8">
			<expression><![CDATA["Piazzale Aldo Moro, 7 - 00185 Roma - Tel. "+$F{TELEF_RESPONS_ITA}+" - Fax "+$F{FAX_RESPONS_ITA}+" - email "+$F{EMAIL_RESPONS_ITA}+""]]></expression>
		</element>
		<element kind="line" x="0" y="5" width="465" height="1">
			<pen lineWidth="0.25"/>
		</element>
	</pageFooter>
	<summary splitType="Prevent"/>
</jasperReport>
