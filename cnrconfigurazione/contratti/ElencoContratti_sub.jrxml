					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$V{decode_importo}]]></expression>
			</element>
			<element kind="textField" key="textField" style="NORMAL" x="685" y="0" width="60" height="10" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right">
				<box>
