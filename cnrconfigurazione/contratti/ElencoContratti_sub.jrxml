					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$V{decode_natura}]]></expression>
			</element>
			<element kind="textField" key="textField" style="NORMAL" x="155" y="0" width="165" height="10" blankWhenNull="true">
