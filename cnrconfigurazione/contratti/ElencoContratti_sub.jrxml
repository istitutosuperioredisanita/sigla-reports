<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ElencoContratti_sub" pageWidth="830" pageHeight="595" orientation="Landscape" columnWidth="830" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="NORMAL" default="true" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="BOLD" style="NORMAL" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TITLE" style="BOLD" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="progressivo" class="java.math.BigDecimal" forPrompting="false">
		<defaultValueExpression><![CDATA[new BigDecimal(409)]]></defaultValueExpression>
	</parameter>
	<parameter name="stato" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["D"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" class="java.math.BigDecimal" forPrompting="false">
		<defaultValueExpression><![CDATA[new BigDecimal(2005)]]></defaultValueExpression>
	</parameter>
	<parameter name="VERSIONE" class="java.lang.String" forPrompting="false">
		<description><![CDATA[versione 1.0  [29/9/2006] by Aurelio D'Amico]]></description>
	</parameter>
	<query language="sql"><![CDATA[
		select * from PRT_ELENCO_CONTRATTI
where ESERCIZIO_PADRE = $P{esercizio}
  and STATO_PADRE = $P{stato}
  and PG_CONTRATTO_PADRE = $P{progressivo}
order by ESERCIZIO, PG_CONTRATTO, STATO
	]]></query>
	<field name="CD_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
	<field name="ESERCIZIO" class="java.math.BigDecimal"/>
	<field name="STATO" class="java.lang.String"/>
	<field name="PG_CONTRATTO" class="java.math.BigDecimal"/>
	<field name="ESERCIZIO_PADRE" class="java.math.BigDecimal"/>
	<field name="STATO_PADRE" class="java.lang.String"/>
	<field name="PG_CONTRATTO_PADRE" class="java.math.BigDecimal"/>
	<field name="NATURA_CONTABILE" class="java.lang.String"/>
	<field name="CD_PROTOCOLLO_GENERALE" class="java.lang.String"/>
	<field name="CD_TERZO_FIRMATARIO" class="java.math.BigDecimal"/>
	<field name="CD_TERZO_RESP" class="java.math.BigDecimal"/>
	<field name="FIG_GIUR_EST" class="java.math.BigDecimal"/>
	<field name="OGGETTO" class="java.lang.String"/>
	<field name="CD_TIPO_CONTRATTO" class="java.lang.String"/>
	<field name="DT_STIPULA" class="java.sql.Timestamp"/>
	<field name="DT_INIZIO_VALIDITA" class="java.sql.Timestamp"/>
	<field name="DT_FINE_VALIDITA" class="java.sql.Timestamp"/>
	<field name="DT_PROROGA" class="java.sql.Timestamp"/>
	<field name="IM_CONTRATTO_ATTIVO" class="java.math.BigDecimal"/>
	<field name="IM_CONTRATTO_PASSIVO" class="java.math.BigDecimal"/>
	<field name="IM_SPESA_ASS" class="java.math.BigDecimal"/>
	<field name="IM_ENTRATA_ASS" class="java.math.BigDecimal"/>
	<field name="DS_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
	<field name="DS_TERZO_FIRMATARIO" class="java.lang.String"/>
	<field name="DS_TERZO_RESP" class="java.lang.String"/>
	<field name="DS_FIG_GIUR_EST" class="java.lang.String"/>
	<field name="DS_TIPO_CONTRATTO" class="java.lang.String"/>
	<variable name="identificativo" class="java.lang.String">
		<expression><![CDATA[$F{ESERCIZIO}.toString() + " " + $F{PG_CONTRATTO}.toString() + " " + $F{STATO}]]></expression>
	</variable>
	<variable name="decode_natura" class="java.lang.String">
		<expression><![CDATA[$F{NATURA_CONTABILE}.equals("A")?"Attivo":$F{NATURA_CONTABILE}.equals("P")?"Passivo":$F{NATURA_CONTABILE}.equals("E")?"Attivo e Passivo":$F{NATURA_CONTABILE}.equals("N")?"Senza flussi finanziari":""]]></expression>
	</variable>
	<variable name="terzo_a" class="java.lang.String">
		<expression><![CDATA[$F{CD_TERZO_FIRMATARIO}.toString().equals("0")?"": "a) " + $F{CD_TERZO_FIRMATARIO}.toString()]]></expression>
	</variable>
	<variable name="decode_importo" class="java.math.BigDecimal">
		<expression><![CDATA[$F{NATURA_CONTABILE}.equals("A")?$F{IM_CONTRATTO_ATTIVO}:$F{NATURA_CONTABILE}.equals("P")?$F{IM_CONTRATTO_PASSIVO}:new BigDecimal(0)]]></expression>
	</variable>
	<variable name="terzo_b" class="java.lang.String">
		<expression><![CDATA[$F{CD_TERZO_RESP}.toString().equals("0")?"": "b) " + $F{CD_TERZO_RESP}.toString()]]></expression>
	</variable>
	<variable name="terzo_c" class="java.lang.String">
		<expression><![CDATA[$F{FIG_GIUR_EST}.toString().equals("0")?"": "b) " + $F{FIG_GIUR_EST}.toString()]]></expression>
	</variable>
	<variable name="anno_id" class="java.lang.String">
		<expression><![CDATA[$F{ESERCIZIO} + " " + $F{PG_CONTRATTO}]]></expression>
	</variable>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader splitType="Stretch"/>
	<columnHeader splitType="Stretch"/>
	<detail>
		<band height="34" splitType="Stretch">
			<element kind="textField" key="textField" style="NORMAL" x="20" y="0" width="39" height="10" blankWhenNull="true">
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$V{identificativo}]]></expression>
			</element>
			<element kind="textField" key="textField" style="NORMAL" x="20" y="20" width="39" height="10" blankWhenNull="false">
				<box>
