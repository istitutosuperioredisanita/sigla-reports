					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$F{DT_PROROGA}]]></expression>
			</element>
			<element kind="textField" key="textField" style="NORMAL" x="635" y="0" width="50" height="10" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right">
				<box>
