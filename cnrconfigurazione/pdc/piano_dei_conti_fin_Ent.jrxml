<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="piano_dei_conti_fin_Ent" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNRGC14" fontName="Times New Roman" fontSize="14" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNRC10" fontName="Times New Roman" italic="true" pdfFontName="Times-Italic"/>
	<style name="TNRGC12" fontName="Times New Roman" fontSize="12" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR10" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNR8" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNRG10" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRG12" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNRG8" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR9" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNRG9" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR9GC" fontName="Times New Roman" fontSize="9" bold="true" italic="true" pdfFontName="Times-BoldItalic"/>
	<style name="TNR16G" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="Esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2014)]]></defaultValueExpression>
	</parameter>
	<parameter name="Ti_gestione" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["E"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select distinct  v1.cd_livello1, v1.ds_classificazione ds_1,
 v2.cd_livello2, v2.ds_classificazione ds_2,
 v3.cd_livello3, v3.ds_classificazione ds_3, ev.cd_elemento_voce
from v_classificazione_voci v1, v_classificazione_voci v2, v_classificazione_voci v3, elemento_voce ev
where v1.id_classificazione=v2.id_class_padre
and v2.id_classificazione=v3.id_class_padre
and v1.id_class_padre is null
and v1.esercizio =$P{Esercizio}
and v1.ti_gestione =$P{Ti_gestione}
and ev.fl_partita_giro = 'N'
and v1.esercizio = v2.esercizio
and v1.esercizio = v3.esercizio
and v1.ti_gestione = v2.ti_gestione
and v1.ti_gestione = v3.ti_gestione
and v3.esercizio = ev.esercizio
and v3.ti_gestione = ev.ti_gestione
and v3.id_classificazione = ev.id_classificazione
	]]></query>
	<field name="CD_LIVELLO1" class="java.lang.String"/>
	<field name="DS_1" class="java.lang.String"/>
	<field name="CD_LIVELLO2" class="java.lang.String"/>
	<field name="DS_2" class="java.lang.String"/>
	<field name="CD_LIVELLO3" class="java.lang.String"/>
	<field name="DS_3" class="java.lang.String"/>
	<field name="CD_ELEMENTO_VOCE" class="java.lang.String"/>
	<sortField name="CD_LIVELLO1"/>
	<sortField name="CD_LIVELLO2"/>
	<sortField name="CD_ELEMENTO_VOCE"/>
	<group name="cd_livello1">
		<expression><![CDATA[$F{CD_LIVELLO1}]]></expression>
		<groupHeader>
			<band height="18" splitType="Stretch">
				<element kind="textField" textAdjust="StretchHeight" key="textField" style="TNRG10" x="4" y="6" width="585" height="12" removeLineWhenBlank="true" blankWhenNull="true">
					<expression><![CDATA["TITOLO "+"0"+$F{CD_LIVELLO1}+" - "+$F{DS_1}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<group name="cd_livello2">
		<expression><![CDATA[$F{CD_LIVELLO2}]]></expression>
		<groupHeader>
			<band height="19" splitType="Stretch">
				<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNRG10" x="13" y="6" width="578" height="12" removeLineWhenBlank="true" blankWhenNull="true">
					<expression><![CDATA["CATEGORIA "+$F{CD_LIVELLO2}+" - "+$F{DS_2}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<background splitType="Stretch"/>
	<title height="54" splitType="Stretch">
		<element kind="image" key="image-1" x="2" y="1" width="497" height="40">
			<expression><![CDATA[$P{DIR_IMAGE}+"CNR.JPG"]]></expression>
		</element>
	</title>
	<pageHeader height="29" splitType="Stretch">
		<element kind="line" key="line-1" x="0" y="26" width="585" height="1" direction="BottomUp"/>
		<element kind="textField" key="textField-11" style="TNR16G" x="1" y="4" width="534" height="20" blankWhenNull="false">
			<box>
				<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="0.0" lineColor="#000000"/>
				<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA["Piano dei Conti Finanziario - Esercizio "+$P{Esercizio}+" - "+"Entrate"]]></expression>
		</element>
	</pageHeader>
	<columnHeader splitType="Stretch"/>
	<detail>
		<band height="17" splitType="Stretch">
			<element kind="textField" textAdjust="StretchHeight" key="textField-7" style="TNR8" mode="Opaque" x="102" y="5" width="100" height="12" removeLineWhenBlank="true" blankWhenNull="true">
				<expression><![CDATA["(0"+$F{CD_LIVELLO1}+"."+$F{CD_LIVELLO2}+"."+$F{CD_LIVELLO3}+")"]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-8" style="TNR8" x="206" y="5" width="385" height="12" blankWhenNull="true">
				<expression><![CDATA[$F{DS_3}]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" key="textField-10" style="TNR8" mode="Opaque" x="15" y="5" width="85" height="12" removeLineWhenBlank="true" pattern="" blankWhenNull="true">
				<expression><![CDATA[$F{CD_ELEMENTO_VOCE}]]></expression>
			</element>
		</band>
	</detail>
	<columnFooter splitType="Stretch"/>
	<pageFooter splitType="Stretch"/>
	<summary splitType="Stretch"/>
</jasperReport>
