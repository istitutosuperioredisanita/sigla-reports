		<defaultValueExpression><![CDATA[new Integer(2014)]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from PRT_PDCF_ENTR_CNR
where
esercizio = $P{esercizio}
order by esercizio,voce
	]]></query>
