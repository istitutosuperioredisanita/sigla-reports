			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="11" width="555" height="17" uuid="7ac903fa-55d2-4e21-a610-fa7dda8d3df3" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["1 - Originalità scientifica della proposta\r\nPunteggio (attribuire punteggio da 1 a 10)): : "  + $F{punteggio_originalita_scientifica} + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_originalita_scientifica} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="10" width="555" height="17" uuid="ae569f93-4b65-45b7-8ff9-06ecb89dfdb5" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["2 - Qualificazione dei proponenti\r\nPunteggio (attribuire un punteggio da 1 a 10): "  +  $F{punteggio_qualificazione_proponenti}  + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_qualificazione_proponenti} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="10" width="555" height="17" uuid="490c5503-b865-4ce3-a6f6-9fc1e0a34273" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["3 - Documentazione e presentazione del progetto (piano di lavoro e metodologia)\r\nPunteggio (attribuire un punteggio da 1 a 10): "  + $F{punteggio_documentazione_presentazione_progetto} + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_documentazione_presentazione_progetto} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="10" width="555" height="17" uuid="8ee5071a-874a-4189-8411-44783a8d6eae" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["4 - Utilità e necessità della collaborazione bilaterale\r\nPunteggio (attribuire un punteggio da 1 a 10): "  + $F{punteggio_utilita_necessita_collaborazione} + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_utilita_necessita_collaborazione} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="10" width="555" height="17" uuid="576a9aae-c724-49bf-88fd-7c878a7513eb" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["5 - Potenzialità di creare ricerca e sviluppo per il CNR\r\nPunteggio (attribuire un punteggio da 1 a 10): "  + $F{punteggio_potenzialita_ricerca_sviluppo_CNR} + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_potenzialita_ricerca_sviluppo_CNR} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="10" width="555" height="17" uuid="50ae8835-3b1a-4443-89b0-5b771b3a358e" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["6 - Potenzialità di attrarre investimenti privati\r\nPunteggio (attribuire un punteggio da 1 a 10): "  + $F{punteggio_potenzialita_investimenti_privati} + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_potenzialita_investimenti_privati} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="10" width="555" height="17" uuid="d6228200-81e7-41b0-9fb5-dac17aac0d70" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["7 - Sfruttamento e/o diffusione/pubblicazione dei risultati\r\nPunteggio (attribuire un punteggio da 1 a 10): "  + $F{punteggio_sfruttamento_diffusione_risultati} + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_sfruttamento_diffusione_risultati} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="27">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="10" width="555" height="17" uuid="464a4527-2b2e-4b20-b74d-bbdd43e69ad7" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["8 - Congruità economica del progetto\r\nPunteggio (attribuire un punteggio da 1 a 10): "  + $F{punteggio_congruita_economica_progetto} + "\r\ncommento: " + "<style isBold=\"false\">" + $F{commento_congruita_economica_progetto} + "\r\n\r\n</style>"]]></expression>
			</element>
		</band>
		<band height="50">
			<element kind="textField" positionType="Float" stretchType="ElementGroupHeight" x="0" y="4" width="555" height="17" uuid="ea0380ba-4b74-4cc0-9211-d4c15956bc52" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified" markup="styled" fontName="Times New Roman" fontSize="11" bold="true" italic="false">
				<paragraph lineSpacing="1_1_2"/>
				<expression><![CDATA["Giudizio Complessivo\r\n"  + $F{giudizio_complessivo} ]]></expression>
			</element>
		</band>
	</detail>
