&& $F{dataAvvioSmartWorking}.length() > 0]]></printWhenExpression>
			<element kind="textField" key="staticText-1" style="TNRG12" x="0" y="2" width="224" height="13" uuid="f161e5a4-8abf-49eb-9bc4-35a64fce224f" markup="none" fontSize="10" bold="true">
