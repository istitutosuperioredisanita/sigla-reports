					<text><![CDATA[IL DIRIGENTE a.i.]]></text>
				</element>
				<element kind="staticText" key="staticText-11" x="0" y="30" width="10" height="13" uuid="eb4cb962-a8c6-4466-a510-72b0b63aff72" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
				<element kind="staticText" key="staticText-5" style="TNR11" x="10" y="30" width="515" height="26" uuid="0b0fe0b2-d6ee-4550-abc3-6a395d43c145" hTextAlign="Justified">
					<text><![CDATA[Visto il provvedimento del Direttore Generale n. 051 prot. n. 39764 del 27.05.2022 di conferimento incarico di direzione ad interim dell'Ufficio Gestione Risorse Umane al Dott. Pierluigi Raimondi]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<group name="Detail_2">
		<expression/>
		<groupHeader>
			<band height="19" splitType="Stretch">
				<element kind="textField" key="textField-3" style="TNR11" x="10" y="1" width="525" height="13" removeLineWhenBlank="true" uuid="7e904a48-be8a-4360-8523-d40a018f8965" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Visto il proprio provvedimento n. "+$F{provv_num}+" in data "+$F{provv_data}+", mediante il quale è stato riconosciuto a "+
$F{dip_nominativo}.trim()+" in servizio presso "+$F{tab_descr_est}+" - "+$F{sede_id}+
", il diritto "+($F{provv_diritto_ricon}==null?"":"a "+$F{provv_diritto_ricon})+" ai sensi dell'art. 33 della Legge 5.2.1992, n.104, come modificato, da ultimo, dalla Legge 4.11.2010, n.183;"]]></expression>
				</element>
				<element kind="staticText" key="staticText-15" x="0" y="1" width="10" height="13" uuid="df7535d5-f684-42e6-8499-3f5858f7d727" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<group name="Detail_3">
		<expression/>
		<groupHeader>
			<band height="19" splitType="Stretch">
				<element kind="textField" key="textField-7" style="TNR11" x="10" y="0" width="525" height="13" uuid="e87b0562-7054-460d-8be6-bb83732b70ab" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Considerato che "+$F{dip_nominativo}.trim()+" ha comunicato che a far data dal "+$F{data_fine_diritto}+" sono intervenuti eventi per i quali è venuto meno il diritto ad usufruire di tali benefici per prestare assistenza a "+
$F{disab_cognome}+" "+$F{disab_nome}+";"]]></expression>
				</element>
				<element kind="staticText" key="staticText-21" x="0" y="0" width="10" height="13" uuid="5f7a498c-e73a-457f-8574-c313d2e1789f" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="21" splitType="Stretch">
				<element kind="textField" key="textField-5" style="TNR11" x="10" y="0" width="525" height="13" uuid="468db1e2-fb44-4478-9083-e3ee097a75c0" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Il dipendente "+$F{dip_nominativo}.trim()+" in servizio presso "+$F{tab_descr_est}+", a far data dal "+
$F{data_fine_diritto2}+
" non ha più diritto alla fruizione dei permessi mensili, ai sensi dell'art. 33 della Legge 5.2.1992, n.104, come modificato, da ultimo, dalla Legge 4.11.2010, n.183."]]></expression>
				</element>
			</band>
		</groupFooter>
