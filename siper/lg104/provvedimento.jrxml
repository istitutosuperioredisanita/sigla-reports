				<text><![CDATA[DISPONE]]></text>
			</element>
			<element kind="staticText" key="staticText-25" style="TNR11" x="10" y="0" width="515" height="13" uuid="fc6a704f-c4b0-4839-bad8-9f0f503c7c81" hTextAlign="Justified">
				<text><![CDATA[Ritenuta la necessità di provvedere;]]></text>
			</element>
			<element kind="staticText" key="staticText-26" x="0" y="0" width="10" height="13" uuid="e18199a0-8c58-49f1-99ea-cd7b01ac470d" hTextAlign="Center">
				<text><![CDATA[-]]></text>
			</element>
		</band>
	</detail>
