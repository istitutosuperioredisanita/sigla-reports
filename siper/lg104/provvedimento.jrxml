	<group name="Domanda_Id" startNewPage="true">
		<expression><![CDATA[$F{domanda_id}]]></expression>
		<groupHeader>
			<band height="167">
				<element kind="staticText" key="staticText-2" style="TNRG14" x="0" y="115" width="535" height="20" uuid="0c969657-94df-4889-b006-80cf9b9e76b5" hTextAlign="Center">
					<text><![CDATA[Direzione Centrale Gestione delle Risorse]]></text>
				</element>
				<element kind="staticText" key="staticText-3" style="TNR12" x="0" y="136" width="535" height="31" uuid="eba7f566-fd9d-49bf-bce0-55839a634eec" hTextAlign="Center">
					<text><![CDATA[Ufficio Gestione Risorse Umane
Dott. Pierluigi Raimondi
]]></text>
				</element>
				<element kind="staticText" key="staticText-1" style="TNRG11" x="0" y="88" width="56" height="16" uuid="24c65cc2-00d4-4695-8b73-bf6cfdc3919d">
					<text><![CDATA[Oggetto:]]></text>
				</element>
				<element kind="textField" key="textField-2" style="TNR11" x="56" y="88" width="479" height="16" uuid="6fe4d461-9316-46e7-9d1c-58fc5de74883" textAdjust="StretchHeight" blankWhenNull="true">
					<expression><![CDATA[$F{dip_nominativo}.trim()+" Legge 104/92"]]></expression>
				</element>
				<element kind="textField" key="textField" style="TNR11" x="0" y="45" width="144" height="14" uuid="f2270f9c-07bb-4169-b657-82caae1fd20e" textAdjust="StretchHeight" blankWhenNull="true">
					<expression><![CDATA["Cod. Assenza: "+$F{provv_cod_assenza}]]></expression>
				</element>
				<element kind="textField" key="textField" style="TNR11" x="0" y="31" width="100" height="14" uuid="27e9df82-4a44-4aef-b70c-18fe0ed58675" textAdjust="StretchHeight" blankWhenNull="true">
					<expression><![CDATA["Sede: "+$F{sede_id}]]></expression>
				</element>
				<element kind="textField" key="textField" style="TNR11" x="0" y="14" width="112" height="14" uuid="e84ca863-ebf0-4f67-881f-ae904c5e4862" textAdjust="StretchHeight" blankWhenNull="true">
					<expression><![CDATA["Pos. "+$F{dip_pos_fasc}]]></expression>
				</element>
				<element kind="textField" key="textField-1" style="TNR11" x="0" y="0" width="112" height="14" uuid="cc5da1b5-1692-4fea-9077-dee8798f8170" textAdjust="StretchHeight" blankWhenNull="true">
					<expression><![CDATA["Matricola: "+$F{matricola}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="39">
				<element kind="staticText" key="staticText-23" style="TNR11" x="379" y="10" width="133" height="14" uuid="970b4de6-0a61-45c8-9c67-d5ad23038646" hTextAlign="Center">
					<text><![CDATA[IL DIRIGENTE a.i.]]></text>
				</element>
			</band>
		</groupFooter>
	</group>
	<group name="Detail_1">
		<expression><![CDATA[$V{REPORT_COUNT}]]></expression>
		<groupHeader>
			<band height="130" splitType="Stretch">
				<element kind="staticText" key="staticText-4" style="TNR12" x="0" y="4" width="535" height="15" uuid="d7b4f5f8-4a18-43ff-b49f-8c0d469ac075" hTextAlign="Center">
					<text><![CDATA[IL DIRIGENTE a.i.]]></text>
				</element>
				<element kind="staticText" key="staticText-5" style="TNR11" x="10" y="59" width="515" height="13" uuid="9e84acb6-cbcd-46b5-acbf-2954d3f6f95c" hTextAlign="Justified">
					<text><![CDATA[Visto il C.C.N.L. del 19.4.2018 per il personale del Comparto "Istruzione e Ricerca"]]></text>
				</element>
				<element kind="staticText" key="staticText-6" style="TNR11" x="10" y="76" width="515" height="13" uuid="2d05f929-58ff-4760-bd59-4a608d7a01c5" hTextAlign="Justified">
					<text><![CDATA[Visto l'art. 33 della legge 5.2.1992, n. 104, come modificato dalla Legge 4.11.2010, n.183;]]></text>
				</element>
				<element kind="staticText" key="staticText-7" style="TNR11" x="10" y="94" width="515" height="13" uuid="37cf18c1-a885-40b0-92cd-f5810dbea5ae" hTextAlign="Justified">
					<text><![CDATA[Visto l'art. 2, comma 3 ter, del D.L.27.8.1993 n.324, convertito in legge 27.10.1993, n.423;]]></text>
				</element>
				<element kind="staticText" key="staticText-8" style="TNR11" x="10" y="112" width="515" height="13" uuid="78b454c2-2bc9-4b67-bc63-10b2c6347111" hTextAlign="Justified">
					<text><![CDATA[Visto la circolare C.N.R. n. 3/2011 del 20.1.2011;]]></text>
				</element>
				<element kind="staticText" key="staticText-11" x="0" y="59" width="10" height="13" uuid="a94ac3ab-4f33-43eb-830e-a4149610a968" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
				<element kind="staticText" key="staticText-12" x="0" y="76" width="10" height="13" uuid="40fa8a3e-a304-4ccd-9989-742b52dde1d6" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
				<element kind="staticText" key="staticText-13" x="0" y="94" width="10" height="13" uuid="20c5c47b-cfc0-4e6e-9ad3-bdd9ca86e1b3" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
				<element kind="staticText" key="staticText-14" x="0" y="112" width="10" height="13" uuid="8fd87530-1e0c-4655-9287-5bb08ea06012" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
				<element kind="staticText" key="staticText-5" style="TNR11" x="10" y="29" width="515" height="26" uuid="05203c8c-6f6d-4d75-90b4-3bb7bbb47afd" hTextAlign="Justified">
					<text><![CDATA[Visto il provvedimento del Direttore Generale n. 051 prot. n. 39764 del 27.05.2022 di conferimento incarico di direzione ad interim dell'Ufficio Gestione Risorse Umane al Dott. Pierluigi Raimondi]]></text>
				</element>
				<element kind="staticText" key="staticText-11" x="0" y="29" width="10" height="13" uuid="9a0971d8-8833-43f3-8ce3-50a397989103" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="18" splitType="Stretch">
				<element kind="staticText" key="staticText-18" style="TNR11" x="10" y="0" width="515" height="13" removeLineWhenBlank="true" uuid="e7eeb899-a998-4c64-9b2f-f7464b2bdf1f" hTextAlign="Justified">
					<printWhenExpression><![CDATA[$F{old_domanda}]]></printWhenExpression>
					<text><![CDATA[Il presente provvedimento annulla e sostituisce ogni precedente in materia.]]></text>
				</element>
			</band>
		</groupFooter>
	</group>
	<group name="Detail_2">
		<expression/>
		<groupHeader>
			<band height="18" splitType="Stretch">
				<element kind="textField" key="textField-3" style="TNR11" x="10" y="1" width="515" height="13" uuid="8be0e31c-2817-4513-a1d9-5e65b1d8bd2b" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Vista la domanda presentata in data "+$F{data_inizio_diritto}+
", mediante la quale il dipendente "+
$F{dip_nominativo}.trim()+" ha chiesto di poter usufruire dei benefici previsti dalla L.n.104/1992 per "+
($F{tipo_domanda}.equals("S")?"se stesso":"prestare assistenza a "+$F{disab_cognome}+" "+$F{disab_nome})+";"]]></expression>
				</element>
				<element kind="staticText" key="staticText-15" x="0" y="1" width="10" height="13" uuid="e4f487b3-1c8c-44e7-854a-e241dacef200" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="18" splitType="Stretch">
				<element kind="textField" key="textField-6" style="TNR11" x="10" y="0" width="515" height="13" uuid="c2553e07-3e7c-46ff-a558-067e2089ecf0" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Per detti permessi al dipendente "+$F{dip_nominativo}.trim()+" compete il normale trattamento economico, ai sensi dell'art.2, comma 3 ter, del D.L. 27.8.1993 n.324, convertito in legge 27.10.1993, n.423."]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<group name="Detail_3">
		<expression/>
		<groupHeader>
			<band height="18" splitType="Stretch">
				<element kind="textField" key="textField-7" style="TNR11" x="10" y="0" width="515" height="13" uuid="553e7ffa-518f-4efa-aa7f-1dc04bb9d898" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Vista la documentazione presentata da "+$F{dip_nominativo}.trim()+", in servizio presso "+$F{tab_descr_est}.trim()
+" dalla quale risulta che lo stesso può usufruire "+($F{provv_diritto_ricon}==null?"":"di "+$F{provv_diritto_ricon})+" ai sensi dell'art. 33 della Legge 5.2.1992, n.104, come modificato, da ultimo, dalla Legge 4.11.2010, n.183;"]]></expression>
				</element>
				<element kind="staticText" key="staticText-21" x="0" y="0" width="10" height="13" uuid="7229f2e6-12d8-4933-a013-bfd1ce7a941f" hTextAlign="Center">
					<text><![CDATA[-]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="18" splitType="Stretch">
				<element kind="textField" key="textField-8" style="TNR11" x="10" y="0" width="515" height="13" uuid="22c99583-20da-4872-8692-bc205060c17e" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Il dipendente "+$F{dip_nominativo}.trim()+", a decorrere dal "+$F{data_inizio_diritto}+
($F{provv_data_fine}!=null&&$F{provv_data_fine}!=""?" al "+$F{provv_data_fine}:"")+", può usufruire "+($F{provv_diritto_ricon}==null?"":"di "+$F{provv_diritto_ricon})+" ai sensi dell'art. 33 della Legge 5.2.1992, n.104, come modificato, da ultimo, dalla Legge 4.11.2010, n.183."]]></expression>
				</element>
			</band>
			<band height="76">
				<printWhenExpression><![CDATA[$F{provv_data_fine}!=null]]></printWhenExpression>
				<element kind="staticText" key="staticText-18" style="TNR11" x="10" y="0" width="515" height="40" removeLineWhenBlank="true" uuid="8e04bc88-8ec3-4f51-9a35-c0ba7767533a" hTextAlign="Justified">
					<text><![CDATA[Al termine del periodo di cui al punto precedente e nelle more delle eventuali visite di revisione il dipendente potrà continuare ad usufruire dei benefici in argomento fino alla successiva pronuncia della Commissione medica competente.]]></text>
				</element>
				<element kind="staticText" key="staticText-18" style="TNR11" x="10" y="45" width="515" height="26" removeLineWhenBlank="true" uuid="f602ecb4-4f9e-4965-9136-7d4d1e126e93" hTextAlign="Justified">
					<text><![CDATA[Il dipendente è tenuto a comunicare tempestivamente l'esito della visita di revisione inserendo il relativo verbale nell'applicativo SIPER.]]></text>
				</element>
			</band>
			<band height="18">
				<element kind="textField" key="textField-8" style="TNR11" x="10" y="0" width="515" height="13" uuid="e98e7bb8-0b03-4544-b87f-0805ac769a34" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<expression><![CDATA["Il dipendente è tenuto " + ($F{provv_data_fine}==null?"":"altresì ") + "a comunicare tempestivamente qualsiasi variazione inerente il diritto medesimo."]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
