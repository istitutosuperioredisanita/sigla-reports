				<element kind="textField" key="textField-74" style="TNR9" x="10" y="2" width="493" height="25" uuid="2975161e-d6dc-4f7f-bf0a-7b0b914fb719" blankWhenNull="false" hTextAlign="Justified">
					<expression><![CDATA[($F{dip_sesso}.equals("M")?"Il sottoscritto ":"La sottoscritta ")+" "+
$F{dip_nominativo}.trim() + ",  "+($F{dip_sesso}.equals("M")?"nato ":"nata ")
+($F{dip_com_nas}.trim()!=""?" a " + $F{dip_com_nas}.trim():"") + " il "
+ $F{dip_data_nas}
+ ", dipendente CNR matricola " + $F{matricola_dip}
+ ", presenta domanda di partecipazione all'evento organizzato:"]]></expression>
				</element>
			</band>
			<band height="37">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<element kind="subreport" x="1" y="3" width="515" height="30" uuid="e59b64ca-cc63-489a-a4fa-7bc5f91748c5">
					<parameter name="printDisabilitaPartecipanti">
