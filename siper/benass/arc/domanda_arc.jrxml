	<title height="58" splitType="Stretch">
		<element kind="staticText" key="staticText-9" style="SSH12" x="0" y="38" width="513" height="13" removeLineWhenBlank="true" forecolor="#FF0000" uuid="60768384-7d59-4759-a039-3d944b7d01d2" hTextAlign="Center" vTextAlign="Middle" fontSize="10" bold="true" pdfFontName="Helvetica-Bold">
			<printWhenExpression><![CDATA[new Boolean($F{stato_domanda}.equals("SALVATAGGIO_DIP"))]]></printWhenExpression>
