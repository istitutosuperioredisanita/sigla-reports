					<dataSourceExpression><![CDATA[((net.sf.jasperreports.engine.data.JsonDataSource)$P{REPORT_DATA_SOURCE}).subDataSource("partecipanti")]]></dataSourceExpression>
					<expression><![CDATA[$P{SUBREPORT_DIR} +"domanda_arc_subreport_partecipanti.jasper"]]></expression>
				</element>
			</band>
			<band height="27">
				<printWhenExpression><![CDATA[$F{printDichiarazioneCaricoFiscale}.equals("Y")]]></printWhenExpression>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="1" width="493" height="22" uuid="f6eb6423-86a8-4957-81c1-74f53dff36e1" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified" markup="styled" bold="true">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<expression><![CDATA["Il richiedente DICHIARA che i partecipanti all'evento sono a proprio carico fiscale."]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="49" splitType="Stretch">
				<element kind="rectangle" key="rectangle-2" style="SSH10" x="5" y="23" width="505" height="21" uuid="df1b4684-732f-4efa-bdae-af3649ee58a9"/>
				<element kind="textField" key="staticText-25" mode="Opaque" x="1" y="1" width="514" height="20" backcolor="#CCCCCC" uuid="254eeaba-841a-427a-9099-ebd09db8538e" blankWhenNull="false" hTextAlign="Justified" vTextAlign="Middle" fontSize="10" bold="false" pdfFontName="Helvetica-Bold">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<expression><![CDATA[$F{numSchedaReperibilita}+" - DATI PER LA REPERIBILITA'"]]></expression>
				</element>
				<element kind="textField" key="textField-53" style="SSH12" x="11" y="27" width="139" height="14" removeLineWhenBlank="true" uuid="617f091d-91d2-45c6-8b2f-906abc44cb7f" blankWhenNull="false" fontSize="8" bold="true" pdfFontName="Helvetica-Bold">
					<expression><![CDATA["Telefono: " + ($F{telefonoRec}==null?"":$F{telefonoRec})]]></expression>
				</element>
				<element kind="textField" key="textField-54" style="SSH12" x="158" y="27" width="136" height="14" removeLineWhenBlank="true" uuid="b746d13f-5ae8-41e2-8d70-3407990d28c5" blankWhenNull="false" fontSize="8" bold="true" pdfFontName="Helvetica-Bold">
					<expression><![CDATA["Cellulare: " + ($F{cellulareRec}==null?"":$F{cellulareRec})]]></expression>
				</element>
				<element kind="textField" key="textField-63" style="SSH12" x="302" y="27" width="200" height="14" removeLineWhenBlank="true" uuid="455b9ee6-b782-48ee-910f-ebd7b241885e" blankWhenNull="false" fontSize="8" bold="true" pdfFontName="Helvetica-Bold">
					<expression><![CDATA["Email: " + ($F{emailRec}==null?"":$F{emailRec})]]></expression>
				</element>
			</band>
			<band height="109">
				<element kind="textField" key="textField-57" style="TNR9" x="11" y="5" width="491" height="28" uuid="4e3eda4c-1eff-47ac-a556-a911efb7f486" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified">
					<expression><![CDATA[($F{dip_sesso}.equals("M")?"Il sottoscritto ":"La sottoscritta ")+
$F{dip_nominativo}.trim() + " DICHIARA di essere a conoscenza delle conseguenze civili e penali ai sensi dell'art. 76 DPR 445/2000 per coloro che rendono dichiarazioni non veritiere."]]></expression>
				</element>
				<element kind="textField" key="textField-58" style="TNR9" x="11" y="34" width="491" height="39" uuid="39e3715f-8716-4714-9133-326d5fbd50e1" blankWhenNull="false" hTextAlign="Justified">
					<expression><![CDATA[($F{dip_sesso}.equals("M")?"Il sottoscritto ":"La sottoscritta ")+
$F{dip_nominativo}.trim() + " prende atto, ai sensi dell'art.13 della Legge 196/2003 sul trattamento dei dati personali, che i dati contenuti nella presente autocertificazione verranno trattati prevalentemente con procedure informatizzate e potranno essere forniti ad altri organismi pubblici per il raggiungimento delle rispettive finalità istituzionali."]]></expression>
				</element>
				<element kind="staticText" key="staticText-20" style="SSHG8" positionType="FixRelativeToBottom" x="5" y="77" width="502" height="26" removeLineWhenBlank="true" forecolor="#FF0000" uuid="5830341e-ac25-42ca-b2e9-68bf3d187452" hTextAlign="Center" vTextAlign="Middle" fontSize="8" bold="true" pdfFontName="Helvetica-Bold">
					<printWhenExpression><![CDATA[new Boolean($F{stato_domanda}.equals("SALVATAGGIO_DIP"))]]></printWhenExpression>
					<box leftPadding="4"/>
					<text><![CDATA[(*) DOMANDA NON CONFERMATA: ricordarsi di confermare la domanda altrimenti risulterà non valida.]]></text>
				</element>
			</band>
		</groupFooter>
	</group>
	<group name="Dipendente">
		<expression><![CDATA[$F{matricola_dip}]]></expression>
		<groupHeader>
			<band splitType="Stretch"/>
			<band height="54">
				<printWhenExpression><![CDATA[$F{printSchedaIsee}.equals( "Y" )]]></printWhenExpression>
				<element kind="textField" key="staticText-25" mode="Opaque" x="0" y="3" width="514" height="20" backcolor="#CCCCCC" uuid="cfa55e22-ab22-4e4c-ba68-a957e1e84100" blankWhenNull="false" hTextAlign="Justified" vTextAlign="Middle" fontSize="10" bold="false" pdfFontName="Helvetica-Bold">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<expression><![CDATA[$F{numSchedaIsee}+" - "+$F{labelIsee}]]></expression>
				</element>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="27" width="493" height="22" uuid="f4921654-a841-4ad3-9302-fbb8056d2295" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified">
					<printWhenExpression><![CDATA[$F{ban_modello_domanda}==null]]></printWhenExpression>
					<expression><![CDATA[$F{indicatoreIseeAnno1}!=null?
"L'indicatore della situazione economica equivalente (ISEE ORDINARIO) per l'anno è "+$F{indicatoreIseeAnno1}:
($F{ban_anno_inizio_val}<$F{ban_anno_fine_val}&& $F{indicatoreIseeAnno2}!=null)?
"L'indicatore della situazione economica equivalente (ISEE ORDINARIO) per l'anno "+($F{ban_anno_dichiarazione_redditi})+" non risulta inserito nell'apposita anagrafica (oppure non risulta confermato)":
($F{ban_anno_inizio_val}<$F{ban_anno_fine_val}&& $F{indicatoreIseeAnno2}==null)?
($F{dip_sesso}.equals("M")?"Il sottoscritto":"La sottoscritta")
+ " DICHIARA che per gli anni "+$F{ban_anno_dichiarazione_redditi}+ " e " + ($F{ban_anno_dichiarazione_redditi}.intValue()+1)+
" non ha inserito, nell'apposita anagrafica, alcuna dichiarazione ISEE ORDINARIO (oppure non risulta confermata). Pertanto, ai fini della redazione della graduatoria e della determinazione dell'importo spettante sarà considerato un ISEE ORDINARIO presunto della fascia massima.":
($F{dip_sesso}.equals("M")?"Il sottoscritto":"La sottoscritta")
+ " DICHIARA che per " +$F{ban_anno_dichiarazione_redditi} + " l'anno "+$F{ban_anno_dichiarazione_redditi}+
" non ha inserito, nell'apposita anagrafica, alcuna dichiarazione ISEE ORDINARIO (oppure non risulta confermata). Pertanto, ai fini della redazione della graduatoria e della determinazione dell'importo spettante sarà considerato un ISEE ORDINARIO presunto della fascia massima."]]></expression>
				</element>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="27" width="493" height="22" uuid="1b870232-71e1-497e-a7a7-22c67c2d2178" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<printWhenExpression><![CDATA[!($F{ban_modello_domanda}==null)]]></printWhenExpression>
					<expression><![CDATA[($F{dip_sesso}.equals("M")?"Il sottoscritto":"La sottoscritta") + " DICHIARA che ai fini della presente domanda verrà automaticamente considerato l'ISEE ordinario, in stato 'confermato', valido alla scadenza per la presentazione delle domande. In caso contrario l'ISEE verrà considerato al valore più alto previsto."]]></expression>
				</element>
			</band>
			<band height="23">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<printWhenExpression><![CDATA[$F{ban_modello_domanda}==null &&
($F{printSchedaIsee}.equals( "Y" ) &&
$F{ban_anno_inizio_val}<$F{ban_anno_fine_val} && ($F{indicatoreIseeAnno1}!=null || $F{indicatoreIseeAnno2}!=null))]]></printWhenExpression>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="0" width="493" height="23" printWhenGroupChanges="Dipendente" uuid="0c6c2a37-1823-44db-9ba0-1fbb8cb0fdab" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Justified">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<expression><![CDATA[$F{indicatoreIseeAnno2}!=null?
"L'indicatore della situazione economica equivalente (ISEE ORDINARIO) per l'anno "+($F{ban_anno_dichiarazione_redditi}.intValue()+1)+" è "+
$F{indicatoreIseeAnno2}:
"L'indicatore della situazione economica equivalente (ISEE ORDINARIO) per l'anno "+($F{ban_anno_dichiarazione_redditi}.intValue()+1)+" non risulta inserito nell'apposita anagrafica (oppure non risulta confermato)"]]></expression>
				</element>
			</band>
			<band height="25">
				<element kind="textField" key="staticText-25" mode="Opaque" x="0" y="3" width="514" height="20" backcolor="#CCCCCC" uuid="7db9bf1c-e8a3-4e3c-8d30-509ff0a9a920" blankWhenNull="false" hTextAlign="Justified" vTextAlign="Middle" fontSize="10" bold="false" pdfFontName="Helvetica-Bold">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<expression><![CDATA[$F{numSchedaAltreInfo}+" - ALTRE INFORMAZIONI"]]></expression>
				</element>
			</band>
			<band height="25">
				<printWhenExpression><![CDATA[$F{eventoArc}!=null && $F{eventoArc}!=""]]></printWhenExpression>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="1" width="493" height="22" uuid="a89e7bca-eff7-43df-b3f2-b1f3a01fca2c" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified" markup="styled">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<expression><![CDATA["<style isBold='true'>Tipo Evento: </style>"+$F{eventoArc}]]></expression>
				</element>
			</band>
			<band height="25">
				<printWhenExpression><![CDATA[$F{printProvinciaAeroportoStazione}.equals( "Y" )]]></printWhenExpression>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="1" width="493" height="22" uuid="47d52dfa-fe48-4c48-9608-804598ec8bda" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified" markup="styled">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<expression><![CDATA["<style isBold='true'>Provincia Aeroporto/Stazione ferroviaria di partenza: </style>"+$F{provinciaAeroporto}]]></expression>
				</element>
			</band>
			<band height="25">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<printWhenExpression><![CDATA[$F{noteIntolleranze}!=null && $F{noteIntolleranze}!=""]]></printWhenExpression>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="1" width="493" height="22" uuid="44e02b2d-e417-4781-80b0-a4b659267e37" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified" markup="styled">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<expression><![CDATA["<style isBold='true'>Note Intolleranze: </style>"+$F{noteIntolleranze}]]></expression>
				</element>
			</band>
			<band height="25">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<printWhenExpression><![CDATA[$F{noteDisabilita}!=null && $F{noteDisabilita}!=""]]></printWhenExpression>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="1" width="493" height="22" uuid="53825a11-d810-4069-b6bb-79cef0ae48c6" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified" markup="styled">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<expression><![CDATA["<style isBold='true'>Note Disabilita: </style>"+$F{noteDisabilita}]]></expression>
				</element>
			</band>
			<band height="25">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<element kind="textField" key="textField-60" style="TNR10" x="11" y="1" width="493" height="22" uuid="998c9629-0801-42cf-9960-45e961c99c2a" textAdjust="StretchHeight" blankWhenNull="false" hTextAlign="Justified" markup="styled">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<expression><![CDATA["<style isBold='true'>Note Generiche: </style>"+($F{noteGeneriche}!=null && $F{noteGeneriche}!=""?$F{noteGeneriche}:"")]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
