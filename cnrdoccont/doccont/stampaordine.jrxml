	<variable name="SUM_Imp_Uni" class="java.math.BigDecimal" resetType="Group" resetGroup="Numero_Ordine" calculation="Sum">
		<expression><![CDATA[$F{IMP_UNI}]]></expression>
	</variable>
	<variable name="SUM_Imp_Iva" class="java.math.BigDecimal" resetType="Group" resetGroup="Numero_Ordine" calculation="Sum">
		<expression><![CDATA[$F{IMP_IVA}]]></expression>
	</variable>
	<variable name="SUM_Tot" class="java.math.BigDecimal" resetType="Group" resetGroup="Numero_Ordine" calculation="Sum">
		<expression><![CDATA[$F{IMP_UNI}.multiply($F{QTA}).add($F{IMP_IVA})]]></expression>
	</variable>
	<variable name="SUM_Imponibile" class="java.math.BigDecimal" resetType="Group" resetGroup="Numero_Ordine" calculation="Sum">
		<expression><![CDATA[$F{IMP_UNI}.multiply($F{QTA})]]></expression>
	</variable>
