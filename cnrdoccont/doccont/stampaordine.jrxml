	</parameter>
	<query language="sql"><![CDATA[
		select * from prt_stampa_ordine
where ESERCIZIO = $P{Esercizio}
and CD_CDS = $P{CDS}
and CD_UO = $P{UO}
and NUM_ORD between $P{Numero_da} and $P{Numero_a}
	]]></query>
