	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="Esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2016)]]></defaultValueExpression>
	</parameter>
	<parameter name="UO_or" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["999"]]></defaultValueExpression>
	</parameter>
	<parameter name="DaNumero" class="java.lang.Long" forPrompting="false">
		<defaultValueExpression><![CDATA[new Long(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="ANumero" class="java.lang.Long" forPrompting="false">
		<defaultValueExpression><![CDATA[new Long(999999999)]]></defaultValueExpression>
	</parameter>
	<parameter name="DaData" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2016/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="AData" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2016/05/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="Tipo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["ACR_RES"]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS_or" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["002"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT * FROM PRT_REG_ACCERT
where CDS_OR = decode($P{CDS_or},'*',CDS_OR,$P{CDS_or})
AND UO_OR = decode($P{UO_or},'*',UO_OR,$P{UO_or})
AND ESERCIZIO = $P{Esercizio}
AND CDS = $P{CDS}
AND TIPO = decode($P{Tipo},'*',TIPO,$P{Tipo})
AND PROGRESSIVO between $P{DaNumero} AND $P{ANumero}
AND DATA between $P{DaData} AND $P{AData}
	]]></query>
