	<field name="DS_UO" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<variable name="TOT_IMPORTO" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{IMPORTO}]]></expression>
	</variable>
