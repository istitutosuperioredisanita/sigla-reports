	<field name="IMP_PAGATO" class="java.math.BigDecimal"/>
	<field name="FL_TESORERIA_UNICA" class="java.lang.String"/>
	<variable name="SUM_LORDO" class="java.math.BigDecimal" resetType="Group" resetGroup="NUM_MANDATO" calculation="Sum">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{LORDO})]]></expression>
	</variable>
	<variable name="SUM_RITENUTE" class="java.math.BigDecimal" resetType="Group" resetGroup="NUM_MANDATO" calculation="Sum">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{RITENUTE})]]></expression>
	</variable>
	<variable name="SUM_NETTO" class="java.math.BigDecimal" resetType="Group" resetGroup="NUM_MANDATO" calculation="Sum">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{LORDO}.add($F{RITENUTE}.negate()))]]></expression>
	</variable>
	<variable name="TOT_NETTO" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{LORDO}.add($F{RITENUTE}.negate()))]]></expression>
	</variable>
	<variable name="TOT_RITENUTE" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{RITENUTE})]]></expression>
	</variable>
	<variable name="TOT_LORDO" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{LORDO})]]></expression>
	</variable>
	<variable name="DIFF_Ritenute" class="java.math.BigDecimal" resetType="Group" resetGroup="NUM_MANDATO" calculation="Sum">
		<expression><![CDATA[$F{RITENUTE_TESTATA}.subtract( $F{RITENUTE} )]]></expression>
	</variable>
	<variable name="Sum_Ritenute_Testata" class="java.math.BigDecimal" resetType="Group" resetGroup="NUM_MANDATO">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{RITENUTE_TESTATA}.subtract($V{SUM_RITENUTE}))]]></expression>
	</variable>
	<variable name="Tot_Ritenute_Testata" class="java.math.BigDecimal" incrementType="Group" incrementGroup="NUM_MANDATO" calculation="Sum">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{RITENUTE_TESTATA}.subtract($V{SUM_RITENUTE}))]]></expression>
	</variable>
	<variable name="PAGATO" class="java.math.BigDecimal" resetType="Group" resetGroup="NUM_MANDATO">
		<expression><![CDATA[($F{STATO}.equals("A")?new BigDecimal(0):$F{IMP_PAGATO})]]></expression>
	</variable>
	<variable name="SUM_PAGATO" class="java.math.BigDecimal" incrementType="Group" incrementGroup="NUM_MANDATO" calculation="Sum">
		<expression><![CDATA[$V{PAGATO}]]></expression>
	</variable>
