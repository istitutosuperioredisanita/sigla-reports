	<parameter name="Esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2019)]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["999"]]></defaultValueExpression>
	</parameter>
	<parameter name="DaData" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2019/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="AData" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2019/01/25")]]></defaultValueExpression>
	</parameter>
	<parameter name="DaNumero" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="ANumero" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["99999999"]]></defaultValueExpression>
	</parameter>
	<parameter name="UO_emittente" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["%"]]></defaultValueExpression>
	</parameter>
