		<defaultValueExpression><![CDATA["E"]]></defaultValueExpression>
	</parameter>
	<parameter name="Stato_trasm" class="java.lang.String" forPrompting="false">
		<description><![CDATA["NT" Non trasmessi comprende stato 'I','P','F']]></description>
		<defaultValueExpression><![CDATA["T"]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="mandato" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="sospeso" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["true"]]></defaultValueExpression>
	</parameter>
	<parameter name="regolarizzazione" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["false"]]></defaultValueExpression>
	</parameter>
	<parameter name="accreditamento" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["false"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT PRT_MAND_ELENCO_CNR.*,fl_tesoreria_unica
FROM PRT_MAND_ELENCO_CNR,parametri_cnr
WHERE
parametri_cnr.esercizio =  $P{Esercizio} and
PRT_MAND_ELENCO_CNR.ESERCIZIO = $P{Esercizio} and
cds_ori_obbligazione like
decode(fl_tesoreria_unica,'Y',decode($P{CDS},CNRCTB020.GETCDCDSENTE ($P{Esercizio}),'%',$P{CDS}),$P{CDS})
AND NUM_MANDATO between $P{DaNumero} and $P{ANumero}
AND uo_ori_obbligazione like
decode(fl_tesoreria_unica,'Y',decode( $P{CDS},CNRCTB020.GETCDCDSENTE ($P{Esercizio}),'%', $P{UO_emittente}), $P{UO_emittente})
AND TIPOLOGIA in(decode($P{regolarizzazione},'true','R',''),decode($P{sospeso},'true','S',''),decode($P{mandato},'true','P',''),decode($P{accreditamento},'true','A',''))
AND PRT_MAND_ELENCO_CNR.STATO LIKE $P{Stato}
and (($P{Stato_trasm}='NT' and
PRT_MAND_ELENCO_CNR.STATO_TRASMISSIONE in('P','F','N','I')) or
($P{Stato_trasm}<>'NT' and PRT_MAND_ELENCO_CNR.STATO_TRASMISSIONE like  $P{Stato_trasm}) )
AND PRT_MAND_ELENCO_CNR.DATA_EMISSIONE between $P{DaData} and $P{AData}
ORDER BY NUM_MANDATO
	]]></query>
	<field name="ESERCIZIO" class="java.math.BigDecimal"/>
	<field name="COD_CDS" class="java.lang.String"/>
	<field name="NUM_MANDATO" class="java.math.BigDecimal"/>
