	<parameter name="Esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer("2018")]]></defaultValueExpression>
	</parameter>
	<parameter name="UO_or" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["999"]]></defaultValueExpression>
	</parameter>
	<parameter name="DataInizio" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2018/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="DataFine" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2018/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS_or" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="Tipo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="Riporto" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from PRT_SCAD_ACCERT
where ESERCIZIO = $P{Esercizio}
and UO_ORI like decode($P{UO_or},'*','%',$P{UO_or})
and CDS_ORI like decode($P{CDS_or},'*','%',$P{CDS_or})
and CDS = $P{CDS}
and RIPORTATO = $P{Riporto}
and TIPO like decode($P{Tipo},'*','%',$P{Tipo})
and DATA_SCAD between $P{DataInizio} and $P{DataFine}
	]]></query>
