	<query language="sql"><![CDATA[
		select * from PRT_STAMPA_OBBL_RIPORTABILI
where CD_UNITA_ORGANIZZATIVA like $P{UO}
and ESERCIZIO = $P{Esercizio}
order by CD_UNITA_ORGANIZZATIVA,PG_OBBLIGAZIONE,PG_OBBLIGAZIONE_SCADENZARIO
	]]></query>
