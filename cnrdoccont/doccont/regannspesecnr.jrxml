	</parameter>
	<parameter name="Stato" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT * FROM PRT_ANN_PGIRO_SPESE_CNR
WHERE CDS_OR like decode($P{CDS_OR},'*','%',$P{CDS_OR})
AND UO_OR  LIKE decode($P{UO_OR},'*','%',$P{UO_OR})
AND PROGRESSIVO between $P{DaNumero} AND $P{ANumero}
AND ESERCIZIO = $P{Esercizio}
AND CDS =$P{CDS}
AND DATA between $P{DaData} AND $P{AData}
AND STATO_OBBL like decode($P{Stato},'*','%',$P{Stato})]]></query>
