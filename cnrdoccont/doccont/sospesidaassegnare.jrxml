	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DaData" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2011/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="AData" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2011/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="Tipo_ES" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT *
FROM PRT_STAMPA_SOSP_DA_ASS
WHERE
esercizio =to_number(to_char($P{DaData},'yyyy')) and
TI_ENTRATA_SPESA = decode($P{Tipo_ES},'*',TI_ENTRATA_SPESA,$P{Tipo_ES})
AND  DT_REGISTRAZIONE between $P{DaData} AND $P{AData}
	]]></query>
	<field name="ESERCIZIO" class="java.math.BigDecimal"/>
	<field name="TI_ENTRATA_SPESA" class="java.lang.String"/>
	<field name="CD_SOSPESO" class="java.lang.String"/>
	<field name="CD_CDS_ORIGINE" class="java.lang.String"/>
	<field name="IM_SOSPESO" class="java.math.BigDecimal"/>
	<field name="DISPONIBILE" class="java.math.BigDecimal"/>
	<field name="DT_REGISTRAZIONE" class="java.sql.Timestamp"/>
	<field name="TI_CC_BI" class="java.lang.String"/>
	<field name="CAUSALE" class="java.lang.String"/>
	<field name="DS_ANAGRAFICO" class="java.lang.String"/>
	<variable name="SUM_IM_SOSPESO_DT_REGISTRAZIONE" class="java.math.BigDecimal" resetType="Group" resetGroup="DT_REGISTRAZIONE" calculation="Sum">
		<expression><![CDATA[$F{IM_SOSPESO}]]></expression>
	</variable>
	<variable name="TOT_IM_SOSPESO" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{IM_SOSPESO}]]></expression>
