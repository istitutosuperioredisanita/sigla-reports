	<parameter name="DIR_IMAGE" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DaData" forPrompting="false" class="java.util.Date">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2003/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="AData" forPrompting="false" class="java.util.Date">
		<defaultValueExpression><![CDATA[(new SimpleDateFormat("yyyy/MM/dd")).parse("2003/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT * FROM PRT_STAMPA_SOSP_MND
where dt_registrazione between $P{DaData} and $P{AData}
and cd_cds_origine like decode($P{CDS},'*','%',$P{CDS})]]></query>
