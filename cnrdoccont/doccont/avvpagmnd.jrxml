						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{VIA}+", "+$F{NUM}]]></expression>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-3" style="TNR10" positionType="Float" stretchType="ContainerHeight" x="329" y="57" width="196" height="15" blankWhenNull="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
