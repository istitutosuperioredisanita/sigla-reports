					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$F{DS_DOC_AMM}+" n. "+$F{NUMERODOC}+" del "+(new SimpleDateFormat("dd/MM/yyyy")).format($F{DATADOC})]]></expression>
			</element>
		</band>
	</detail>
	<columnFooter splitType="Stretch"/>
	<pageFooter splitType="Stretch"/>
	<summary splitType="Stretch"/>
</jasperReport>
