		<defaultValueExpression><![CDATA[new Integer(2011)]]></defaultValueExpression>
	</parameter>
	<parameter name="UO" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["004.001"]]></defaultValueExpression>
	</parameter>
	<parameter name="CDS" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["004"]]></defaultValueExpression>
	</parameter>
	<parameter name="DaNumeroMnd" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="ANumeroMnd" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(500)]]></defaultValueExpression>
	</parameter>
	<parameter name="DaNumeroDist" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="ANumeroDist" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(99999)]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from PRT_AVV_MND
where ESERCIZIO = $P{Esercizio}
and CDS_OR = $P{CDS}
and NUM_DIST between $P{DaNumeroDist}  and $P{ANumeroDist}
and PROGRESSIVO between $P{DaNumeroMnd} and $P{ANumeroMnd}
and UO_OR like decode($P{UO},'*','%',$P{UO})
order by PROGRESSIVO
	]]></query>
