						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA["Spett.  "+$F{BENEFICIARIO}]]></expression>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField-2" style="TNR10" positionType="Float" stretchType="ContainerHeight" x="329" y="41" width="196" height="15" blankWhenNull="true">
