<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="stampasospesi" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR8" fontName="Times New Roman" fontSize="8" pdfFontName="Times-Roman"/>
	<style name="TNR10B" fontName="Times New Roman" fontSize="10" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR16B" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR8B" fontName="Times New Roman" fontSize="8" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR10" fontName="Times New Roman" fontSize="10" pdfFontName="Times-Roman"/>
	<style name="TNR12" fontName="Times New Roman" fontSize="12" pdfFontName="Times-Roman"/>
	<style name="TNR12B" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR9" fontName="Times New Roman" fontSize="9" pdfFontName="Times-Roman"/>
	<style name="TNR9B" fontName="Times New Roman" fontSize="9" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["075"]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="tipo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2006)]]></defaultValueExpression>
	</parameter>
	<parameter name="da_data" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2006/12/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="a_data" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2006/12/31")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from PRT_STAMPA_SOSP
where
cds = $P{cds} and
esercizio =to_number(to_char($P{da_data},'yyyy')) and
tipoes like decode($P{tipo},'*','%',$P{tipo})  and
data between $P{da_data} and $P{a_data}
order by cds,data,tipoes,codsosp
	]]></query>
	<field name="CDS" class="java.lang.String"/>
	<field name="TIPOSOSP" class="java.lang.String"/>
	<field name="TIPOES" class="java.lang.String"/>
	<field name="CODSOSP" class="java.lang.String"/>
	<field name="IMPORTO" class="java.math.BigDecimal"/>
	<field name="DATA" class="java.sql.Timestamp"/>
	<field name="TIPOBANCA" class="java.lang.String"/>
	<field name="CAUS" class="java.lang.String"/>
	<field name="DESCR" class="java.lang.String"/>
	<variable name="tot_data" class="java.math.BigDecimal" resetType="Group" resetGroup="data" calculation="Sum">
		<expression><![CDATA[$F{IMPORTO}]]></expression>
	</variable>
	<variable name="tot" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{IMPORTO}]]></expression>
	</variable>
	<group name="cds" startNewPage="true" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{CDS}]]></expression>
		<groupHeader>
			<band splitType="Stretch"/>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<group name="data" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{DATA}]]></expression>
		<groupHeader>
			<band splitType="Stretch"/>
		</groupHeader>
		<groupFooter>
			<band height="20" splitType="Stretch">
				<element kind="textField" key="textField-12" style="TNR9B" x="231" y="4" width="113" height="14" pattern=" #,##0.00" blankWhenNull="true" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{tot_data}]]></expression>
				</element>
				<element kind="textField" key="textField-13" style="TNR9B" x="7" y="4" width="135" height="14" blankWhenNull="false" hTextAlign="Right">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA["Totale del "+(new SimpleDateFormat("dd/MM/yyyy")).format($F{DATA})]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
