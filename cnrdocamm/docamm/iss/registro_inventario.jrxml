		<parameter name="valbene" forPrompting="false" class="java.math.BigDecimal"/>
		<parameter name="etichetta" forPrompting="false" class="java.lang.String"/>
		<parameter name="data_da" forPrompting="false" class="java.util.Date"/>
		<query language="sql"><![CDATA[select * from TMP_STAMPA_REGISTRO_INV_QUOTE
Where (($P{valbene}!=0 And tipo ='C') or tipo != 'C')
  And cd_cds = $P{cds}
  And cd_unita_organizzativa = $P{uo}
  And categoria = $P{categoria}
  And etichetta = $P{etichetta}
  And nr_inventario = to_number($P{codice_bene})
  And cd_categoria_gruppo = $P{gruppo}
  And cd_tipo_carico_scarico like Decode($P{ds_tipo_carico_scarico},'*','%',$P{ds_tipo_carico_scarico})
  And tipo = $P{tipo}
  And NVL(data_registrazione,$P{data_a}) between $P{data_da} and $P{data_a}
  and esercizio_comp<= to_number(to_char($P{data_a},'YYYY'))
  And esercizio_amm <= to_number(to_char($P{data_a},'YYYY'))
order by esercizio_amm ASC]]></query>
