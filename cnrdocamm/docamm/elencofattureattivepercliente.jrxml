		<defaultValueExpression><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="a_pg" class="java.lang.Long" forPrompting="false">
		<defaultValueExpression><![CDATA[new Long(10000)]]></defaultValueExpression>
	</parameter>
	<parameter name="terzo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="da_data_em" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="a_data_re" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="da_data_re" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="a_data_em" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="a_data_in_co" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="a_data_fi_co" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="da_data_in_co" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/01/01")]]></defaultValueExpression>
	</parameter>
	<parameter name="da_data_fi_co" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2015/01/01")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from PRT_ELENCO_FATT_PER_CLIENTE
where
(($P{esercizio}!=0 and
ESERCIZIO_FATT = $P{esercizio}) or
$P{esercizio} = 0) and
(($P{terzo}!=0 and
CD_TERZO = $P{terzo}) or
 $P{terzo}=0) and
CD_CDS_ORIGINE_FATT like decode($P{cds},'*','%',$P{cds}) and
CD_UO_ORIGINE_FATT like decode($P{uo},'*','%',$P{uo}) and
DT_EMISSIONE_FATT between $P{da_data_em} and $P{a_data_em} and
DT_REGISTRAZIONE_FATT BETWEEN $P{da_data_re} and $P{a_data_re} and
PG_FATTURA_ATTIVA_FATT BETWEEN $P{da_pg} and $P{a_pg} and
DT_DA_COMPETENZA_COGE_RIGA BETWEEN $P{da_data_in_co} and $P{a_data_in_co} and
DT_A_COMPETENZA_COGE_RIGA BETWEEN $P{da_data_fi_co} and $P{a_data_fi_co}
order by cd_terzo,esercizio_fatt,pg_fattura_attiva_fatt,progressivo_riga
	]]></query>
