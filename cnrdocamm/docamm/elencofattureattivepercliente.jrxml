	<field name="ESERCIZIO_REV_MAN" class="java.math.BigDecimal"/>
	<field name="PG_REV_MAN" class="java.math.BigDecimal"/>
	<field name="PROV_DEF_REV_MAN" class="java.lang.String"/>
	<field name="TIPO_REV_MAN" class="java.lang.String"/>
	<field name="COMP_RES_REV_MAN" class="java.lang.String"/>
	<field name="DS_REV_MAN" class="java.lang.String"/>
	<field name="DT_EM_REV_MAN" class="java.sql.Timestamp"/>
	<field name="DT_TRASMISSIONE_REV_MAN" class="java.sql.Timestamp"/>
	<field name="DT_INCASSO_REV_MAN" class="java.sql.Timestamp"/>
	<field name="SPLIT_PAYMENT" class="java.lang.String"/>
	<variable name="tot_fatt_con_segno" class="java.math.BigDecimal" resetType="Group" resetGroup="terzo" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA_FATT}.compareTo("C")==0?($F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA}).negate()):
$F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA}))]]></expression>
	</variable>
	<variable name="tot_riscosso" class="java.math.BigDecimal" resetType="Group" resetGroup="terzo" calculation="Sum">
		<expression><![CDATA[($F{PG_REV_MAN}==null?new BigDecimal(0):
($F{TI_FATTURA_FATT}.compareTo("C")==0?
($F{SPLIT_PAYMENT}.compareTo("N")==0?($F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA})).negate():
$F{IM_IMPONIBILE_RIGA}.negate()):
($F{SPLIT_PAYMENT}.compareTo("N")==0?($F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA})):
$F{IM_IMPONIBILE_RIGA})))]]></expression>
	</variable>
	<variable name="tot_da_pagare" class="java.math.BigDecimal" resetType="Group" resetGroup="terzo" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA_FATT}.compareTo("C")==0?
($F{SPLIT_PAYMENT}.compareTo("N")==0?($F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA})).negate():
$F{IM_IMPONIBILE_RIGA}.negate()):
($F{SPLIT_PAYMENT}.compareTo("N")==0?($F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA})):
$F{IM_IMPONIBILE_RIGA})).subtract(($F{PG_REV_MAN}==null?new BigDecimal(0):
($F{TI_FATTURA_FATT}.compareTo("C")==0?($F{SPLIT_PAYMENT}.compareTo("N")==0?($F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA})).negate():
$F{IM_IMPONIBILE_RIGA}.negate()):
($F{SPLIT_PAYMENT}.compareTo("N")==0?($F{IM_IMPONIBILE_RIGA}.add($F{IM_IVA_RIGA})):
$F{IM_IMPONIBILE_RIGA}))))]]></expression>
	</variable>
