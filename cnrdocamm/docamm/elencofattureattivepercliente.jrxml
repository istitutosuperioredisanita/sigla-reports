	<field name="IM_IVA_RIGA" class="java.math.BigDecimal"/>
	<field name="DT_DA_COMPETENZA_COGE_RIGA" class="java.sql.Timestamp"/>
	<field name="DT_A_COMPETENZA_COGE_RIGA" class="java.sql.Timestamp"/>
	<field name="ENT_SPE" class="java.lang.String"/>
