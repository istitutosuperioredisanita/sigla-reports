	<parameter name="DIR_IMAGE" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["999.000"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(2006)]]></defaultValueExpression>
	</parameter>
	<parameter name="capitolo" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["1.02.001"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select * from PRT_GENERICI_PASSIVI_VOCE
where
(($P{uo}!='999.000' and
PRT_GENERICI_PASSIVI_VOCE.ESERCIZIO = $P{esercizio} and
PRT_GENERICI_PASSIVI_VOCE.CD_UNITA_ORGANIZZATIVA like decode($P{uo},'*','%',$P{uo}) and
PRT_GENERICI_PASSIVI_VOCE.CD_ELEMENTO_VOCE like decode($P{capitolo},'*','%',$P{capitolo})) or
($P{uo}='999.000' and
PRT_GENERICI_PASSIVI_VOCE.ESERCIZIO = $P{esercizio} and
PRT_GENERICI_PASSIVI_VOCE.CD_ELEMENTO_VOCE like decode($P{capitolo},'*','%',$P{capitolo})))
order by cd_elemento_voce,CD_UNITA_ORGANIZZATIVA,pg_documento_generico,progressivo_riga]]></query>
