	<field name="CD_TERZO" class="java.math.BigDecimal"/>
	<variable name="tot_tipo_imp" class="java.math.BigDecimal" resetType="Group" resetGroup="TIPO_I_C" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA}.compareTo("C")==0?$F{IM_IMPONIBILE}.multiply(new BigDecimal(-1)):$F{IM_IMPONIBILE})]]></expression>
	</variable>
	<variable name="tot_tipo_iva" class="java.math.BigDecimal" resetType="Group" resetGroup="TIPO_I_C" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA}.compareTo("C")==0?$F{IM_IVA}.multiply(new BigDecimal(-1)):$F{IM_IVA})]]></expression>
	</variable>
	<variable name="tot_tipo_tot" class="java.math.BigDecimal" resetType="Group" resetGroup="TIPO_I_C" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA}.compareTo("C")==0?($F{IM_IMPONIBILE}.add($F{IM_IVA})).multiply(new BigDecimal(-1)):($F{IM_IMPONIBILE}.add($F{IM_IVA})))]]></expression>
	</variable>
	<variable name="tot_voce_imp" class="java.math.BigDecimal" resetType="Group" resetGroup="VOCE" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA}.compareTo("C")==0?$F{IM_IMPONIBILE}.multiply(new BigDecimal(-1)):$F{IM_IMPONIBILE})]]></expression>
	</variable>
	<variable name="tot_voce_iva" class="java.math.BigDecimal" resetType="Group" resetGroup="VOCE" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA}.compareTo("C")==0?$F{IM_IVA}.multiply(new BigDecimal(-1)):$F{IM_IVA})]]></expression>
	</variable>
	<variable name="tot_voce_tot" class="java.math.BigDecimal" resetType="Group" resetGroup="VOCE" calculation="Sum">
		<expression><![CDATA[($F{TI_FATTURA}.compareTo("C")==0?($F{IM_IMPONIBILE}.add($F{IM_IVA})).multiply(new BigDecimal(-1)):($F{IM_IMPONIBILE}.add($F{IM_IVA})))]]></expression>
	</variable>
