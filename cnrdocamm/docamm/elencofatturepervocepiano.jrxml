	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<style name="TNR16B" default="false" fontName="Times New Roman" fontSize="16" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR10" default="false" fontName="Times New Roman" pdfFontName="Times-Roman"/>
	<style name="TNR10B" default="false" fontName="Times New Roman" bold="true" pdfFontName="Times-Bold"/>
	<style name="TNR12B" default="false" fontName="Times New Roman" fontSize="12" bold="true" pdfFontName="Times-Bold"/>
	<parameter name="DIR_IMAGE" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" forPrompting="false" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(2006)]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="capitolo" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="stato" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="terzo" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select * from PRT_STAMPA_FATTURE_VOCE
where
(($P{uo}!='999.000' and $P{terzo}!='0' and
CD_ELEMENTO_VOCE like decode($P{capitolo},'*','%',$P{capitolo}) and
CD_UNITA_ORGANIZZATIVA like decode($P{uo},'*','%',$P{uo}) and 
ESERCIZIO_FATTURA = $P{esercizio} and
STATO_COFI like decode($P{stato},'*','%',$P{stato}) and 
CD_TERZO = $P{terzo}) or
($P{uo}!='999.000' and $P{terzo}='0' and
CD_ELEMENTO_VOCE like decode($P{capitolo},'*','%',$P{capitolo}) and
CD_UNITA_ORGANIZZATIVA like decode($P{uo},'*','%',$P{uo}) and 
ESERCIZIO_FATTURA = $P{esercizio} and
STATO_COFI like decode($P{stato},'*','%',$P{stato})) or
($P{uo}='999.000' and $P{terzo}!='0' and
CD_ELEMENTO_VOCE like decode($P{capitolo},'*','%',$P{capitolo}) and
ESERCIZIO_FATTURA = $P{esercizio} and
STATO_COFI like decode($P{stato},'*','%',$P{stato}) and
CD_TERZO = $P{terzo}) or
($P{uo}='999.000' and $P{terzo}='0' and
CD_ELEMENTO_VOCE like decode($P{capitolo},'*','%',$P{capitolo}) and
ESERCIZIO_FATTURA = $P{esercizio} and
STATO_COFI like decode($P{stato},'*','%',$P{stato}))) 
order by CD_UNITA_ORGANIZZATIVA,CD_ELEMENTO_VOCE, TI_ISTITUZ_COMMERC,pg_fattura_passiva]]></query>
