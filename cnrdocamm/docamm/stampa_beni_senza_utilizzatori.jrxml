	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="uo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[new String("069.*")]]></defaultValueExpression>
	</parameter>
	<parameter name="data_a" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2009/12/31")]]></defaultValueExpression>
	</parameter>
	<parameter name="data_da" class="java.util.Date" forPrompting="false">
		<defaultValueExpression><![CDATA[new SimpleDateFormat("yyyy/MM/dd").parse("2010/12/31")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT * FROM PRT_STAMPA_BENI_SENZA_UTILIZZ
WHERE
CD_UNITA_ORGANIZZATIVA LIKE DECODE($P{uo},'*','%',translate($P{uo},'*','%')) and
data_registrazione between $P{data_da} and $P{data_a}
order by CD_UNITA_ORGANIZZATIVA,nr_inventario
	]]></query>
	<field name="CD_UNITA_ORGANIZZATIVA" class="java.lang.String"/>
	<field name="DATA_REGISTRAZIONE" class="java.sql.Timestamp"/>
	<field name="PG_INVENTARIO" class="java.math.BigDecimal"/>
	<field name="NR_INVENTARIO" class="java.math.BigDecimal"/>
	<field name="PROGRESSIVO" class="java.math.BigDecimal"/>
	<group name="uo" startNewPage="true" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{CD_UNITA_ORGANIZZATIVA}]]></expression>
		<groupHeader>
			<band height="20" splitType="Stretch">
				<element kind="line" key="line-2" x="0" y="18" width="535" height="1">
					<pen lineWidth="0.25" lineStyle="Solid"/>
				</element>
				<element kind="textField" textAdjust="StretchHeight" key="textField" style="TNR10" x="4" y="3" width="100" height="14" blankWhenNull="true">
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{CD_UNITA_ORGANIZZATIVA}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
