	<field name="CD_ELEMENTO_VOCE" class="java.lang.String"/>
	<variable name="tot_voce_tot" class="java.math.BigDecimal" resetType="Group" resetGroup="VOCE" calculation="Sum">
		<expression><![CDATA[$F{IM_TOTALE_COMPENSO}]]></expression>
	</variable>
