	<field name="PG_OBBLIGAZIONE" class="java.math.BigDecimal"/>
	<field name="PG_OBBLIGAZIONE_SCADENZARIO" class="java.math.BigDecimal"/>
	<field name="TI_ISTITUZ_COMMERC" class="java.lang.String"/>
