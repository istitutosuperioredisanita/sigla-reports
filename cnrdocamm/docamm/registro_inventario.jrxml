	<variable name="valbene" resetType="Group" calculation="Sum" resetGroup="ETICHETTA" class="java.math.BigDecimal">
		<expression><![CDATA[
			$F{VALORE_INIZIALE}.add($F{VARIAZIONE_PIU}).subtract($F{VARIAZIONE_MENO})
		]]></expression>
	</variable>
	<variable name="tipo_beni" resetType="Group" resetGroup="ETICHETTA" class="java.lang.String">
		<expression><![CDATA[
			$F{TIPO}.equals("I")?"Istituzionale":"Commerciale"
		]]></expression>
	</variable>
