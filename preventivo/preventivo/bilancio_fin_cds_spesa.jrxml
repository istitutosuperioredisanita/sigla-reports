	<query language="sql"><![CDATA[select * from VP_DBIL_FIN_CDS
where
esercizio = $P{esercizio} and
cd_cds = $P{cds}  AND
TI_GESTIONE ='S'
order by esercizio,ti_gestione,cd_cds,cd_parte,CDC_TITOLO,cdc_sezione,cdc_rubrica,cdc_capitolo]]></query>
