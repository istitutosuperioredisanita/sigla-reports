	<parameter name="cds" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA[new String("075")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select * from VP_DBIL_FIN_CDS
where
esercizio = $P{esercizio} and
cd_cds = $P{cds}  AND
TI_GESTIONE ='E'
order by esercizio,cd_cds,CDC_TITOLO]]></query>
