	<query language="sql"><![CDATA[select * from VP_DBIL_FIN_CNR_DZ
where
esercizio = $P{esercizio} and
TI_GESTIONE ='E'
order by esercizio,ti_gestione,CDC_TITOLO,CDC_CATEGORIA,CDC_Capitolo,cd_cds]]></query>
