	<subDataset name="ALL_TITOLI" uuid="1e7a740f-a8e5-470b-9313-f751bce5cfb2">
		<parameter name="P_TIPO" class="java.lang.String" forPrompting="false">
			<defaultValueExpression><![CDATA["E"]]></defaultValueExpression>
		</parameter>
		<query language="sql"><![CDATA[
			SELECT FNC_CCNCONCAT(CURSOR(SELECT DISTINCT '"'||CD_LIVELLO1||'"' FROM TMP_STAMPA_RENDICONTO Where TIPO = $P{P_TIPO} ORDER BY 1)) CODICE from dual
		]]></query>
		<field name="CODICE" class="java.lang.String">
			<description/>
		</field>
	</subDataset>
