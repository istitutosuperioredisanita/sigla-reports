		<defaultValueExpression/>
	</parameter>
	<parameter name="P_ESERCIZIO" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2010)]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TIPO" class="java.lang.String">
		<defaultValueExpression><![CDATA["E"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_NUM_LIV" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(3)]]></defaultValueExpression>
	</parameter>
	<parameter name="RIEPILOGO" class="java.lang.String">
		<defaultValueExpression><![CDATA["S"]]></defaultValueExpression>
	</parameter>
	<parameter name="ROTTURA" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["2"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TIPO_AGGREGAZIONE" class="java.lang.String">
		<defaultValueExpression><![CDATA["SCI"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT TOT_ACC_IMP, CASSA_RIS_PAG,
(SELECT decode(DESCRIZIONE, 'CNR','Y','N') FROM PARAMETRI_ENTE WHERE ATTIVO='Y') ISCNR
from(Select
NVL(SUM(DECODE(TIPO,'S',TOT_ACC_IMP, -TOT_ACC_IMP)),0) TOT_ACC_IMP,
NVL(SUM(DECODE(TIPO,'E',CASSA_RIS_PAG, -CASSA_RIS_PAG)),0) CASSA_RIS_PAG
FROM TMP_STAMPA_RENDICONTO
WHERE EXISTS(SELECT '1' FROM PARAMETRI_ENTE WHERE ATTIVO='Y' AND DESCRIZIONE!='CNR'))
	]]></query>
	<field name="TOT_ACC_IMP" class="java.math.BigDecimal"/>
	<field name="CASSA_RIS_PAG" class="java.math.BigDecimal"/>
	<field name="ISCNR" class="java.lang.String"/>
	<variable name="TOT_ACC_IMP" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[($P{P_TIPO}.equals("E")&&$F{TOT_ACC_IMP}.compareTo(BigDecimal.ZERO)>0?
$F{TOT_ACC_IMP}.abs():($P{P_TIPO}.equals("S")&&$F{TOT_ACC_IMP}.compareTo(BigDecimal.ZERO)<0?
$F{TOT_ACC_IMP}.abs():BigDecimal.ZERO))]]></expression>
	</variable>
	<variable name="CASSA_RIS_PAG" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CASSA_RIS_PAG}!=null && $P{P_TIPO}.equals("E")?$F{CASSA_RIS_PAG}:BigDecimal.ZERO]]></expression>
	</variable>
