<jasperReport name="stampa_pdgp_bilancio_rottura" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="cfa0e905-f69b-4b32-b010-4d2a756728db" language="java">
