	<query language="sql"><![CDATA[select * from PRT_REND_FIN_ENT_GEST
where esercizio = $P{esercizio}
  and cds = DECODE($P{cds},'*',cds,$P{cds})
and dip = DECODE($P{dip},'*',dip,$P{dip})
order by DECODE($P{raggrDIPString},'Y',PESO_DIP,''),
DECODE($P{raggrCDSString},'Y',CDS,''),
DECODE($P{raggrTITString},'Y',CD_LIVELLO1,''),
DECODE($P{raggrCATString},'Y',CD_LIVELLO2,''),
DECODE($P{raggrCAPString},'Y',CD_LIVELLO3,'')]]></query>
