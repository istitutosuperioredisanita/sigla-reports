	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2010)]]></defaultValueExpression>
	</parameter>
	<parameter name="cds" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[new String("000")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select * from VP_DBIL_FIN_CDS_DZ
where
esercizio = $P{esercizio} and
cd_cds = $P{cds}  AND
TI_GESTIONE ='E'
order by esercizio,cd_cds,CDC_TITOLO
	]]></query>
