	</variable>
	<variable name="tot_pos_tit" class="java.math.BigDecimal" resetType="Group" resetGroup="TITOLO" calculation="Sum">
		<expression><![CDATA[($F{IM_STANZ_INIZIALE}.subtract($F{IM_STANZ_INIZIALE_AP}).compareTo($F{IM_STANZ_INIZIALE}.subtract($F{IM_STANZ_INIZIALE_AP}).abs())==0?
$F{IM_STANZ_INIZIALE}.subtract($F{IM_STANZ_INIZIALE_AP}):new BigDecimal(0))]]></expression>
	</variable>
