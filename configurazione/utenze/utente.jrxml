	<query language="sql"><![CDATA[select * from 
VP_UTENTE,VP_UTENTE_GRANTS
WHERE 
VP_UTENTE.CD_UTENTE = VP_UTENTE_GRANTS.CD_UTENTE(+) AND
VP_UTENTE.CD_UTENTE LIKE DECODE($P{utente},'*','%',$P{utente}) 
ORDER BY VP_UTENTE.CD_UTENTE,VP_UTENTE_GRANTS.CD_UNITA_ORGANIZZATIVA,VP_UTENTE_GRANTS.TI_GRANT]]></query>
