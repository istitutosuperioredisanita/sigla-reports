	<parameter name="DIR_IMAGE" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["..\\..\\img\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="Esercizio" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2015)]]></defaultValueExpression>
	</parameter>
	<parameter name="Progetto" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["ET.P01"]]></defaultValueExpression>
	</parameter>
	<parameter name="Commessa" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="Modulo" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="Pdg" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
	</parameter>
	<parameter name="Imp_Acc" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<parameter name="cdr" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["*"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		select prt_prog_com_mod.*, p.FL_NUOVO_PDg from prt_prog_com_mod, PARAMETRI_CNR p
where prt_prog_com_mod.esercizio = $P{Esercizio}
and (($P{cdr} != '*' AND prt_prog_com_mod.cdr = $P{cdr}) OR  $P{cdr} = '*')
and (($P{Progetto} != '*' AND cd_progetto = $P{Progetto}) OR  $P{Progetto} = '*')
and (($P{Commessa} != '*' AND cd_commessa = $P{Commessa}) OR  $P{Commessa} = '*')
and (( p.FL_NUOVO_PDg ='N'
and (($P{Modulo} != '*' AND cd_modulo = $P{Modulo}) OR  $P{Modulo} = '*')) or p.FL_NUOVO_PDg ='Y')
and (($P{Pdg} != '*' AND flg_pdg = $P{Pdg}) OR $P{Pdg} = '*')
and (($P{Imp_Acc} != '*' AND flg_impegno = $P{Imp_Acc}) OR $P{Imp_Acc} = '*')
and prt_prog_com_mod.esercizio = p.esercizio
	]]></query>
