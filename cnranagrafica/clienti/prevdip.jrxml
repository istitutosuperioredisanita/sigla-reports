<jasperReport name="prevdip" pageWidth="842" pageHeight="595" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" language="java">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="116"/>
	<property name="ireport.y" value="0"/>
	<import><![CDATA[net.sf.jasperreports.engine.*]]></import>
	<import><![CDATA[java.util.*]]></import>
	<import><![CDATA[net.sf.jasperreports.engine.data.*]]></import>
	<parameter name="UO" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[new String ("*")]]></defaultValueExpression>
	</parameter>
	<parameter name="Matricola" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="Terzo" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[
		SELECT * FROM PRT_PREV_DIP
where SEDE like decode ($P{UO},'*','%',substr($P{UO},1,3)||substr($P{UO},5,7))
and ($P{Matricola} = '0' OR MATRICOLA = $P{Matricola})
and ($P{Terzo} = '0' OR CD_TERZO = $P{Terzo})
	]]></query>
	<field name="MATRICOLA" class="java.math.BigDecimal"/>
	<field name="NOMINATIVO" class="java.lang.String"/>
	<field name="RAPPORTO" class="java.lang.String"/>
	<field name="ENTE" class="java.lang.String"/>
	<field name="CD_TERZO" class="java.math.BigDecimal"/>
	<field name="SEDE" class="java.lang.String"/>
